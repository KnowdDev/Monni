{%- comment -%} brands-dir-cache-bust-2026-08-13 {%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% comment %} perf-2026-06-15b {% endcomment %}
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {% if template.name == 'index' %}
      {% render 'lcp-preload' %}
    {% elsif template.name == 'product' and product.featured_media.media_type == 'image' %}
      <link
        rel="preload"
        as="image"
        href="{{ product.featured_media | image_url: width: 800, format: 'webp' }}"
        imagesrcset="
          {{ product.featured_media | image_url: width: 600, format: 'webp' }} 600w,
          {{ product.featured_media | image_url: width: 800, format: 'webp' }} 800w,
          {{ product.featured_media | image_url: width: 1200, format: 'webp' }} 1200w
        "
        imagesizes="(min-width: 1024px) 55vw, 100vw"
        fetchpriority="high"
      >
    {% endif %}

    {% render 'fonts-brand' %}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% render 'critical-header' %}

    {% if template.name == 'index' %}
      {% render 'critical-home' %}
    {% endif %}

    {% comment %}
      Homepage: critical-home inlines above-fold CSS; load full critical.css async.
      Other templates: blocking critical.css prevents typography/layout flash on navigation.
    {% endcomment %}
    {% if template.name == 'index' %}
      {% render 'stylesheet-async', asset: 'critical.css' %}
      {% render 'stylesheet-async', asset: 'tt-final.css' %}
    {% else %}
      {{ 'critical.css' | asset_url | stylesheet_tag }}
      {{ 'tt-final.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}
    <!-- seo-head-bust-2026-08-17c -->
    {% render 'schema-organization' %}

    {%- if request.path == '/pages/celebrate-meaningful-connections-with-thoughtful-corporate-gifting-from-tea-tonic' -%}
      <meta http-equiv="refresh" content="0;url=/pages/corporate-gifting">
      <link rel="canonical" href="{{ shop.url }}/pages/corporate-gifting">
      <script>window.location.replace('/pages/corporate-gifting');</script>
    {%- endif -%}

    {{ content_for_header }}

    {% liquid
      assign senderkit_enabled = settings.senderkit_newsletter_enable
      if senderkit_enabled == nil
        assign senderkit_enabled = true
      endif
      assign senderkit_slug = settings.senderkit_signup_slug | default: 'monni-edit'
    %}
    {% if senderkit_enabled and senderkit_slug != blank %}
      <meta name="senderkit-signup-slug" content="{{ senderkit_slug | escape }}">
    {% endif %}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}{% if page.handle %} page-{{ page.handle }}{% endif %}{% if product.gift_card? %} product-gift-card{% endif %}">
    {% render 'attribution-bootstrap' %}
    <a href="#main-content" class="skip-link">Skip to main content</a>

    {% sections 'header-group' %}

    <main id="main-content" tabindex="-1">
      {%- comment -%}
        Shopify ignores templates/policy.liquid and always renders default
        shopify-policy chrome. Intercept here so our policy section controls
        headings (e.g. Returns Policy) and legal eyebrow copy.
      {%- endcomment -%}
      {%- if request.page_type == 'policy' -%}
        {% section 'policy' %}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    {% # PostHog — after window.load; recorder/surveys/decide disabled %}
    {% render 'posthog' %}

    <script src="{{ 'constants.js' | asset_url }}" defer></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer></script>
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'posthog-shopify.js' | asset_url }}" defer></script>

    {% liquid
      assign senderkit_enabled = settings.senderkit_newsletter_enable
      if senderkit_enabled == nil
        assign senderkit_enabled = true
      endif
      assign senderkit_slug = settings.senderkit_signup_slug | default: 'monni-edit'
    %}
    {% if senderkit_enabled and senderkit_slug != blank %}
      <script src="{{ 'senderkit-newsletter.js' | asset_url }}" defer></script>
    {% endif %}

  {% unless template.name == 'index' %}
    <script src="{{ 'animations.js' | asset_url }}" defer></script>
  {% endunless %}

    <script src="{{ 'cart-drawer.js' | asset_url }}&fs=250" defer></script>

    {% if request.page_type == 'product' %}
      <script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
      <script src="{{ 'product.js' | asset_url }}" defer></script>
    {% elsif request.page_type == 'collection' or request.page_type == 'list-collections' %}
      <script src="{{ 'product.js' | asset_url }}" defer></script>
    {% endif %}
    {% if request.page_type == 'page' and page.handle == 'size-guide' %}
      <script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
      <script src="{{ 'size-guide.js' | asset_url }}" defer></script>
    {% endif %}
    {% if request.page_type == 'collection' or request.page_type == 'list-collections' %}
      <script src="{{ 'collection.js' | asset_url }}" defer></script>
    {% endif %}
    {% unless template.name == 'index' %}
      {% if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'search' or request.page_type == 'page' and page.handle == 'wishlist' %}
        <script src="{{ 'wishlist.js' | asset_url }}" defer></script>
      {% endif %}
    {% endunless %}
  </body>
</html>
