{% comment %}
  Inlined header CSS — prevents navigation FOUC before async stylesheets load.
{% endcomment %}
{% style %}
  body {
    margin: 0;
    background-color: var(--color-background, #F8F6F4);
    color: var(--color-foreground, #3D3D3D);
    font-family: var(--font-body--family, 'Jost', 'Helvetica Neue', Arial, sans-serif);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1, h2, h3, h4, h5, h6,
  .card-product__title,
  .collection-page__title,
  .product-page__title {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-foreground, #3D3D3D);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 101;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow-x: clip;
  }

  .header__announcement {
    width: 100%;
    background-color: var(--color-foreground, #3D3D3D);
    color: var(--color-background, #F8F6F4);
    text-align: center;
    padding: 0.625rem var(--page-margin, 1rem);
    font-size: var(--text-announcement, 0.6875rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .header__shell {
    position: relative;
    background: rgba(248, 246, 244, 0.95);
    border-bottom: 1px solid rgba(229, 224, 220, 0.85);
  }

  .header__inner {
    min-height: 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    margin: 0 auto;
    padding: 0.875rem var(--page-margin, 1rem);
    column-gap: 1rem;
  }

  .header__side {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .header__side--end {
    justify-content: flex-end;
  }

  .header__logo {
    grid-column: 2;
    justify-self: center;
    text-align: center;
  }

  .header__logo-img {
    display: block;
    width: auto;
    max-width: min(var(--header-logo-width, 180px), 13rem);
    max-height: 3rem;
    margin: 0 auto;
    object-fit: contain;
  }

  .header__logo-text {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
  }

  .header__menu,
  .header__mega-list,
  .header__mega-aside-list,
  .header__submenu-list,
  .header__mobile-list,
  .header__mobile-shop-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .header__nav--desktop {
    display: none;
  }

  .header__menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  .header__menu-toggle-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header__utilities {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0.9rem;
    white-space: nowrap;
  }

  .header__mobile-cart {
    display: inline-flex;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .header__utility-link,
  .header__menu-link,
  .header__mobile-link {
    color: inherit;
    text-decoration: none;
  }

  .header__mega-panel[hidden],
  .header__drawer[hidden],
  .header__drawer-backdrop[hidden],
  .header__mobile-submenu[hidden] {
    display: none !important;
  }

  .header--menu-open .header__drawer:not([hidden]) {
    display: flex !important;
    position: fixed;
    inset: 0;
    z-index: 110;
    visibility: visible;
    pointer-events: auto;
  }

  .header--menu-open .header__drawer-backdrop:not([hidden]) {
    display: block !important;
    position: fixed;
    inset: 0;
    z-index: 109;
  }

  @media (min-width: 1161px) {
    .header__nav--desktop {
      display: block;
    }

    .header__utilities {
      display: flex;
    }

    .header__menu-toggle,
    .header__mobile-cart {
      display: none !important;
    }
  }

  @media (max-width: 1160px) {
    .header__menu-toggle {
      display: inline-flex;
    }
  }
{% endstyle %}
