<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign favicon_image = settings.favicon | default: settings.logo
-%}
{%- if favicon_image != blank -%}
  <link rel="icon" href="{{ favicon_image | image_url: width: 32, height: 32 }}" sizes="32x32" type="image/png">
  <link rel="shortcut icon" href="{{ favicon_image | image_url: width: 32, height: 32 }}" type="image/png">
  <link rel="apple-touch-icon" href="{{ favicon_image | image_url: width: 180, height: 180 }}">
{%- else -%}
  <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32" type="image/png">
  <link rel="shortcut icon" href="{{ 'favicon-32.png' | asset_url }}" type="image/png">
  <link rel="apple-touch-icon" href="{{ 'favicon-32.png' | asset_url }}">
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign meta_description = page_description | default: shop.description | default: shop.name
  assign seo_title_custom = false

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

{%- if request.page_type == 'collection' -%}
  {%- liquid
    assign seo_title = collection.metafields.monni.seo_title.value | default: collection.metafields.monni.seo_title | default: collection.seo.title
    assign seo_desc = collection.metafields.monni.seo_description.value | default: collection.metafields.monni.seo_description | default: collection.seo.description
  -%}
  {%- if collection.handle == 'fragrance' and seo_title == blank -%}
    {%- assign seo_title = 'Botanical Fragrance | Natural Perfume | MONNI' -%}
  {%- endif -%}
  {%- if collection.handle == 'fragrance' and seo_desc == blank -%}
    {%- assign seo_desc = 'Shop botanical perfumes and oils at MONNI. Fragrance from independent perfumers working with raw plant materials, worn softly and remembered long after.' -%}
  {%- endif -%}
  {%- if collection.handle == 'clothing' and seo_title == blank -%}
    {%- assign seo_title = 'Natural Fibre Clothing | Silk, Linen, Cotton | MONNI' -%}
  {%- endif -%}
  {%- if collection.handle == 'clothing' and seo_desc == blank -%}
    {%- assign seo_desc = 'Shop silk, linen, cotton and merino clothing at MONNI. Natural fibres chosen long before slow fashion became a conversation, led by MONNI Label.' -%}
  {%- endif -%}
  {%- if seo_title == blank -%}
    {%- assign seo_title = collection.title | append: ' | MONNI' -%}
  {%- endif -%}
  {%- if seo_desc == blank -%}
    {%- assign collection_top = collection.metafields.monni.top_line.value | default: collection.metafields.monni.top_line -%}
    {%- capture collection_bottom -%}
      {{ collection.metafields.monni.bottom_intro | metafield_tag }}
    {%- endcapture -%}
    {%- assign collection_bottom = collection_bottom | replace: '</p>', ' ' | strip_html | strip | replace: '  ', ' ' -%}
    {%- assign seo_desc = collection_top | append: ' ' | append: collection_bottom | strip | replace: '—', ', ' | replace: '–', ', ' | truncate: 158 -%}
  {%- endif -%}
  {%- assign page_title = seo_title -%}
  {%- assign og_title = seo_title -%}
  {%- assign meta_description = seo_desc -%}
  {%- assign seo_title_custom = true -%}
{%- elsif request.page_type == 'metaobject' or template.name == 'metaobject' -%}
  {%- liquid
    assign brand_name = metaobject.name.value | default: metaobject.name | default: metaobject.display_name
    assign seo_title = metaobject.seo_title.value | default: metaobject.seo_title
    assign seo_desc = metaobject.seo_description.value | default: metaobject.seo_description
    assign brand_tagline = metaobject.tagline.value | default: metaobject.tagline
  -%}
  {%- if seo_title == blank and brand_name != blank -%}
    {%- assign seo_title = brand_name | append: ' | MONNI' -%}
  {%- endif -%}
  {%- if seo_desc == blank and brand_tagline != blank -%}
    {%- assign seo_desc = brand_tagline | append: ' Shop at MONNI, Matakana.' | replace: '—', ', ' | replace: '–', ', ' | truncate: 158 -%}
  {%- endif -%}
  {%- if seo_desc == blank -%}
    {%- capture brand_body -%}
      {{ metaobject.description | metafield_tag }}
    {%- endcapture -%}
    {%- assign seo_desc = brand_body | strip_html | strip | replace: '—', ', ' | replace: '–', ', ' | truncate: 158 -%}
  {%- endif -%}
  {%- if seo_title != blank -%}
    {%- assign page_title = seo_title -%}
    {%- assign og_title = seo_title -%}
    {%- assign seo_title_custom = true -%}
  {%- endif -%}
  {%- if seo_desc != blank -%}
    {%- assign meta_description = seo_desc -%}
  {%- endif -%}
{%- elsif request.page_type == 'page' and page.handle == 'brands' -%}
  {%- assign page_title = 'Shop by Brand | Independent Makers | MONNI' -%}
  {%- assign og_title = page_title -%}
  {%- assign meta_description = 'Discover the makers behind MONNI. Independent brands chosen for quality, integrity and the rituals of everyday wellbeing. Shop by brand in Matakana, NZ.' -%}
  {%- assign seo_title_custom = true -%}
{%- endif -%}

{%- assign og_description = meta_description | replace: '—', ', ' | replace: '–', ', ' -%}

<meta
  property="og:site_name"
  content="MONNI"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- elsif settings.logo -%}
  <meta
    property="og:image"
    content="https:{{ settings.logo | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ settings.logo | image_url: width: 1200 }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- assign twitter_image = page_image | default: settings.logo -%}
{%- if twitter_image -%}
  <meta
    name="twitter:image"
    content="https:{{ twitter_image | image_url: width: 1200 }}"
  >
{%- endif -%}

{%- liquid
  assign hide_shop_suffix = seo_title_custom
  if page_title contains 'MONNI'
    assign hide_shop_suffix = true
  endif
  if page_title contains shop.name
    assign hide_shop_suffix = true
  endif
-%}
<title>
  {{ page_title }}
  {%- if current_tags %} | tagged {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} | Page {{ current_page }}{% endif -%}
  {%- unless hide_shop_suffix %} | {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% comment %} seo-titles-2026-08-17 {% endcomment %}
{% if meta_description != blank %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% elsif shop.description %}
  <meta
    name="description"
    content="{{ shop.description | escape }}"
  >
{% endif %}
