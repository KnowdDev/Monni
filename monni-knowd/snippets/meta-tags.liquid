<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign favicon_image = settings.favicon | default: settings.logo
-%}
{%- if favicon_image != blank -%}
  <link rel="icon" href="{{ favicon_image | image_url: width: 32, height: 32 }}" sizes="32x32" type="image/png">
  <link rel="shortcut icon" href="{{ favicon_image | image_url: width: 32, height: 32 }}" type="image/png">
  <link rel="apple-touch-icon" href="{{ favicon_image | image_url: width: 180, height: 180 }}">
{%- else -%}
  <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32" type="image/png">
  <link rel="shortcut icon" href="{{ 'favicon-32.png' | asset_url }}" type="image/png">
  <link rel="apple-touch-icon" href="{{ 'favicon-32.png' | asset_url }}">
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign meta_description = page_description | default: shop.description | default: shop.name
  assign seo_title_custom = false

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

{%- if request.page_type == 'collection' -%}
  {%- liquid
    assign seo_title = collection.metafields.monni.seo_title.value | default: collection.metafields.monni.seo_title | default: collection.seo.title
    assign seo_desc = collection.metafields.monni.seo_description.value | default: collection.metafields.monni.seo_description | default: collection.seo.description
  -%}
  {%- if collection.handle == 'fragrance' and seo_title == blank -%}
    {%- assign seo_title = 'Botanical Fragrance | Natural Perfume' -%}
  {%- endif -%}
  {%- if collection.handle == 'fragrance' and seo_desc == blank -%}
    {%- assign seo_desc = 'Shop botanical perfumes and oils at Tea & Tonic. Fragrance from independent perfumers working with raw plant materials, worn softly and remembered long after.' -%}
  {%- endif -%}
  {%- if collection.handle == 'clothing' and seo_title == blank -%}
    {%- assign seo_title = 'Natural Fibre Clothing | Silk, Linen, Cotton' -%}
  {%- endif -%}
  {%- if collection.handle == 'clothing' and seo_desc == blank -%}
    {%- assign seo_desc = 'Shop silk, linen, cotton and merino clothing at Tea & Tonic. Natural fibres chosen long before slow fashion became a conversation, led by MONNI Label.' -%}
  {%- endif -%}
  {%- if seo_title == blank -%}
    {%- assign seo_title = collection.title | replace: 'Tea & Tonic Matakana', '' | strip -%}
  {%- endif -%}
  {%- capture seo_title -%}{%- render 'monni-line-label', text: seo_title -%}{%- endcapture -%}
  {%- assign seo_title = seo_title | strip -%}
  {%- if seo_desc == blank -%}
    {%- assign collection_top = collection.metafields.monni.top_line.value | default: collection.metafields.monni.top_line -%}
    {%- capture collection_bottom -%}
      {{ collection.metafields.monni.bottom_intro | metafield_tag }}
    {%- endcapture -%}
    {%- assign collection_bottom = collection_bottom | replace: '</p>', ' ' | strip_html | strip | replace: '  ', ' ' -%}
    {%- assign seo_desc = collection_top | append: ' ' | append: collection_bottom | strip | replace: '—', ', ' | replace: '–', ', ' | truncatewords: 28, '' -%}
  {%- endif -%}
  {%- capture seo_desc -%}{%- render 'monni-line-label', text: seo_desc -%}{%- endcapture -%}
  {%- assign seo_desc = seo_desc | strip -%}
  {%- assign page_title = seo_title -%}
  {%- assign og_title = seo_title -%}
  {%- assign meta_description = seo_desc -%}
  {%- assign seo_title_custom = true -%}
{%- elsif request.page_type == 'metaobject' or template.name == 'metaobject' -%}
  {%- liquid
    assign brand_name = metaobject.name.value | default: metaobject.name | default: metaobject.display_name | replace: 'Monni Tea', 'MONNI Tea' | replace: 'Monni Botanicals', 'MONNI Botanicals' | replace: 'Monni Label', 'MONNI Label' | replace: 'Monni Art', 'MONNI Art'
    assign seo_title = metaobject.seo_title.value | default: metaobject.seo_title
    assign seo_desc = metaobject.seo_description.value | default: metaobject.seo_description
    assign brand_tagline = metaobject.tagline.value | default: metaobject.tagline
  -%}
  {%- if seo_title == blank and brand_name != blank -%}
    {%- assign seo_title = brand_name -%}
  {%- endif -%}
  {%- if seo_desc == blank and brand_tagline != blank -%}
    {%- assign seo_desc = brand_tagline | append: ' Shop at Tea & Tonic, Matakana.' | replace: '—', ', ' | replace: '–', ', ' | truncatewords: 28, '' -%}
  {%- endif -%}
  {%- if seo_desc == blank -%}
    {%- capture brand_body -%}
      {{ metaobject.description | metafield_tag }}
    {%- endcapture -%}
    {%- assign seo_desc = brand_body | strip_html | strip | replace: '—', ', ' | replace: '–', ', ' | truncatewords: 28, '' -%}
  {%- endif -%}
  {%- capture seo_title -%}{%- render 'monni-line-label', text: seo_title -%}{%- endcapture -%}
  {%- assign seo_title = seo_title | strip -%}
  {%- capture seo_desc -%}{%- render 'monni-line-label', text: seo_desc -%}{%- endcapture -%}
  {%- assign seo_desc = seo_desc | strip -%}
  {%- if seo_title != blank -%}
    {%- assign page_title = seo_title -%}
    {%- assign og_title = seo_title -%}
    {%- assign seo_title_custom = true -%}
  {%- endif -%}
  {%- if seo_desc != blank -%}
    {%- assign meta_description = seo_desc -%}
  {%- endif -%}
{%- elsif request.page_type == 'page' and page.handle == 'brands' -%}
  {%- assign page_title = 'Our Brands' -%}
  {%- assign og_title = page_title -%}
  {%- assign meta_description = 'Behind every brand is a maker who creates with heart, cares for the earth and works with intention.' -%}
  {%- assign seo_title_custom = true -%}
{%- elsif request.page_type == 'page' -%}
  {%- liquid
    case page.handle
      when 'corporate-gifting'
        assign page_title = 'Corporate Gifting'
        assign meta_description = 'Thoughtful corporate gifts from Matakana. Natural wellbeing, beauty and home gifts, beautifully wrapped and delivered across New Zealand.'
        assign og_title = page_title
        assign seo_title_custom = true
      when 'contact'
        assign page_title = 'Contact'
        assign meta_description = 'Contact Tea & Tonic in Matakana Village. Visit us at 2 Matakana Valley Road, call 09 422 9083 or email hello@teaandtonic.co.nz.'
        assign og_title = page_title
        assign seo_title_custom = true
      when 'shop'
        assign page_title = 'The Collection'
        assign meta_description = 'Shop natural beauty, clothing, jewellery, tea, ceramics, art and gifts at Tea & Tonic, with many women-led and NZ-made brands. Free shipping over $250.'
        assign og_title = page_title
        assign seo_title_custom = true
    endcase
  -%}
{%- elsif request.page_type == 'policy' -%}
  {%- liquid
    assign policy_handle = request.path | split: '/' | last
    case policy_handle
      when 'shipping-policy'
        assign page_title = 'Shipping + Delivery'
        assign meta_description = 'Shipping, delivery and Click + Collect at Tea & Tonic Matakana. Free NZ shipping over $250. Most parcels arrive in two to five working days.'
        assign og_title = page_title
        assign seo_title_custom = true
      when 'refund-policy'
        assign page_title = 'Returns'
        assign meta_description = 'Returns, exchanges and store credit at Tea & Tonic. Timeframes, change of mind rules and your rights under the Consumer Guarantees Act.'
        assign og_title = page_title
        assign seo_title_custom = true
      when 'privacy-policy'
        assign page_title = 'Privacy Policy'
        assign meta_description = 'How Tea & Tonic collects, uses and protects your personal information when you shop online or in our Matakana store.'
        assign og_title = page_title
        assign seo_title_custom = true
      when 'terms-of-service'
        assign page_title = 'Terms + Conditions'
        assign meta_description = 'Terms and conditions for shopping at Tea & Tonic, covering orders, pricing, shipping, product care and use of our website.'
        assign og_title = page_title
        assign seo_title_custom = true
    endcase
  -%}
{%- endif -%}

{%- assign og_description = meta_description | replace: '—', ', ' | replace: '–', ', ' | replace: 'Tea & Tonic Matakana', 'Tea & Tonic' | truncatewords: 28, '' -%}

<meta
  property="og:site_name"
  content="Tea & Tonic"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- elsif settings.logo -%}
  <meta
    property="og:image"
    content="https:{{ settings.logo | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ settings.logo | image_url: width: 1200 }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- assign twitter_image = page_image | default: settings.logo -%}
{%- if twitter_image -%}
  <meta
    name="twitter:image"
    content="https:{{ twitter_image | image_url: width: 1200 }}"
  >
{%- endif -%}

{%- liquid
  assign trading_name = 'Tea & Tonic'
  assign page_title = page_title | replace: ' | MONNI', '' | replace: '| MONNI', '' | replace: ' | Tea & Tonic Matakana', '' | replace: 'Tea & Tonic Matakana', 'Tea & Tonic' | replace: ' | Tea & Tonic', '' | strip
  if page_title == blank
    assign page_title = trading_name
  endif
-%}
<title>
  {{ page_title | strip }} | {{ trading_name }}
  {%- if current_tags %} | tagged {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} | Page {{ current_page }}{% endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% comment %} seo-titles-2026-08-17 {% endcomment %}
{% if meta_description != blank %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% elsif shop.description %}
  <meta
    name="description"
    content="{{ shop.description | escape }}"
  >
{% endif %}
