{% comment %} Above-the-fold homepage CSS — paints LCP before async stylesheets load {% endcomment %}
{% style %}
  body {
    margin: 0;
    background-color: var(--color-background, #F8F6F4);
    color: var(--color-foreground, #3D3D3D);
    font-family: var(--font-body--family, 'Jost', 'Helvetica Neue', Arial, sans-serif);
  }

  .split-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .split-hero__panel {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .split-hero__fallback {
    position: absolute;
    inset: 0;
    background-color: var(--color-border-light, #F0EBE7);
  }

  .split-hero picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .split-hero picture img,
  .split-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: var(--color-border-light, #F0EBE7);
  }

  .split-hero__image--desktop-only {
    display: none;
  }

  @media (min-width: 768px) {
    .split-hero__image--desktop-only {
      display: block;
    }

    .split-hero__image--below-fold-mobile {
      display: none;
    }
  }

  .split-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.12) 0%, transparent 70%);
  }

  .split-hero__text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    text-align: center;
    padding: 2.5rem 1.5rem 3.5rem;
    pointer-events: none;
  }

  .split-hero__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    font-weight: 300;
    letter-spacing: 0.14em;
    color: #faf8f4;
    margin: 0 0 0.65rem;
    line-height: 1.3;
  }

  .split-hero__tagline {
    font-family: var(--font-heading--family);
    font-size: clamp(0.875rem, 1.15vw, 0.9375rem);
    font-weight: 200;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.25);
    margin: 0;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .split-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .split-hero__panel + .split-hero__panel { margin-left: -1px; }

    .split-hero__panel {
      aspect-ratio: auto;
      height: min(62.5vw, 880px, max(34rem, calc(100svh - 2.5rem)));
    }
  }
{% endstyle %}
