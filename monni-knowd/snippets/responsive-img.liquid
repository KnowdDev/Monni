{% doc %}
  Responsive Shopify CDN image — WebP srcset sized to displayed dimensions.

  @param {image} image - Required Shopify image
  @param {string} alt - Alt text
  @param {string} [class] - CSS class on img
  @param {string} [sizes] - sizes attribute
  @param {string} [widths] - Comma-separated pixel widths for srcset, e.g. "240,320,480,640"
  @param {number} [default_width] - Default src width (should match smallest practical size)
  @param {number} [width] - HTML width attribute
  @param {number} [height] - HTML height attribute
  @param {string} [loading] - lazy or eager
  @param {string} [fetchpriority] - high, low, or auto
  @param {string} [decoding] - async or sync
{% enddoc %}

{% liquid
  assign img_widths = widths | default: '240,320,480,640' | split: ','
  assign src_w = default_width | default: 320
  assign img_loading = loading | default: 'lazy'
  assign img_decoding = decoding | default: 'async'
%}

<img
  src="{{ image | image_url: width: src_w, format: 'webp' }}"
  srcset="
    {%- for w in img_widths -%}
      {%- assign w_num = w | strip | plus: 0 -%}
      {{ image | image_url: width: w_num, format: 'webp' }} {{ w_num }}w
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  "
  sizes="{{ sizes | default: '100vw' }}"
  alt="{{ alt | escape }}"
  loading="{{ img_loading }}"
  decoding="{{ img_decoding }}"
  {% if fetchpriority != blank %}
    fetchpriority="{{ fetchpriority }}"
  {% endif %}
  {% if width != blank %}
    width="{{ width }}"
  {% endif %}
  {% if height != blank %}
    height="{{ height }}"
  {% endif %}
  {% if class != blank %}
    class="{{ class }}"
  {% endif %}
>
