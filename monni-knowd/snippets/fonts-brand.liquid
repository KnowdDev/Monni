{% comment %}
  Self-hosted brand fonts — eliminates Google Fonts CSS round-trip.

  Single face per family includes Latin + Latin Extended-A (ā ē ī ō ū).
  Do NOT split macron vowels into a second unicode-range face: browsers can
  decompose ū → u + ◌̄ across faces, and Jost's combining mark then draws
  beside the letter instead of above it.
{% endcomment %}
{% liquid
  assign font_cormorant = 'font-cormorant-latin.woff2' | asset_url
  assign font_jost = 'font-jost-latin.woff2' | asset_url
  assign font_cormorant_italic = 'font-cormorant-italic-latin.woff2' | asset_url
  assign unicode_brand = 'U+0000-00FF, U+0100-017F, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
%}
<link rel="preload" href="{{ font_cormorant }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ font_jost }}" as="font" type="font/woff2" crossorigin>
{% style %}
  @font-face {
    font-family: 'Cormorant Garamond';
    font-style: normal;
    font-weight: 300 400;
    font-display: swap;
    src: url('{{ font_cormorant }}') format('woff2');
    unicode-range: {{ unicode_brand }};
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    font-style: italic;
    font-weight: 300;
    font-display: swap;
    src: url('{{ font_cormorant_italic }}') format('woff2');
    unicode-range: {{ unicode_brand }};
  }
  @font-face {
    font-family: 'Jost';
    font-style: normal;
    font-weight: 200 400;
    font-display: swap;
    src: url('{{ font_jost }}') format('woff2');
    unicode-range: {{ unicode_brand }};
  }
{% endstyle %}
