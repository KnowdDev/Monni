{% doc %}
  Editorial product grid. Every tile links to the product.
  Hand-picked product blocks win. Otherwise a fixed visual order (one of each
  subject and colour, so near-duplicates never sit side by side), then the
  collection if none of those products are available.
  @param {object} section - The section (reads product blocks)
  @param {collection} [collection] - Fallback collection
  @param {number} [limit] - Max tiles for the collection fallback (default 12)
  @param {string} [heading] - Heading
{% enddoc %}
{%- liquid
  assign feed_limit = limit | default: 12
  assign picked = section.blocks | where: 'type', 'product'
  assign shown = 0
  assign has_feed = false
  assign editorial_handles = 'wild-earth-river-song-eau-de-parfum,the-knitter-iggy-cardi,mothermade-mushrooms-beauty-blend,tahi-ritual-set,monni-art-original-nga-maunga-tupuna,amber-gold-gloria-tea,nara-body-brush,on-sundays-raspberry-leaf-tea' | split: ','
  if picked.size > 0
    assign has_feed = true
  elsif collection != blank and collection.products_count > 0
    assign has_feed = true
  endif
-%}
{%- if has_feed -%}
  <div class="lt__feed-head">
    <h2 class="lt__feed-title">{{ heading | default: 'In store now' }}</h2>
    {%- if picked.size == 0 -%}<a class="lt__feed-link" href="{{ collection.url }}">View all</a>{%- endif -%}
  </div>
  <ul class="lt__feed">
    {%- if picked.size > 0 -%}
      {%- for block in picked -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank and product.featured_image != blank -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- render 'links-feed-tile', product: product, index: shown, block: block -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for handle in editorial_handles -%}
        {%- assign product = all_products[handle] -%}
        {%- if product != blank and product.featured_image != blank and product.available -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- render 'links-feed-tile', product: product, index: shown -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if shown == 0 -%}
        {%- for product in collection.products -%}
          {%- if product.featured_image != blank and product.available and shown < feed_limit -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- render 'links-feed-tile', product: product, index: shown -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
  </ul>
{%- endif -%}
