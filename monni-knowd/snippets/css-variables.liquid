{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  html {
    font-size: 106.25%;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    font-size: var(--text-base);
  }

  :root {
    /* Typography — 17px base; minimum 0.875rem (~14.9px) for labels */
    --text-2xs: 0.875rem;
    --text-xs: 0.875rem;
    --text-sm: 0.9375rem;
    --text-base: 1rem;
    --text-md: 1.0625rem;
    --text-lg: 1.1875rem;
    --text-xl: 1.3125rem;
    --text-2xl: 1.625rem;
    --text-3xl: 2rem;
    --text-4xl: 2.5rem;

    /* Refined sizes — exempt from body scale bump for luxury UI chrome */
    --text-announcement: 0.6875rem;
    --text-cta: clamp(0.6875rem, 0.8vw, 0.75rem);

    --font-heading--family: 'Cormorant Garamond', serif;
    --font-body--family: 'Jost', sans-serif;
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color | default: '#F5F3EF' }};
    --color-background-alt: {{ settings.background_alt_color | default: '#FAFAF8' }};
    --color-foreground: {{ settings.foreground_color | default: '#3A3633' }};
    --color-foreground-light: {{ settings.foreground_light_color | default: '#6B6560' }};
    --color-foreground-muted: {{ settings.foreground_muted_color | default: '#8A847D' }};
    --color-accent: {{ settings.accent_color | default: '#C4B8A8' }};
    --color-accent-light: {{ settings.accent_light_color | default: '#D9D0C4' }};
    --color-accent-dark: {{ settings.accent_dark_color | default: '#A89A8A' }};
    --color-border: {{ settings.border_color | default: '#E0DCD6' }};
    --color-border-light: {{ settings.border_light_color | default: '#EBE8E3' }};
    --color-error: {{ settings.error_color | default: '#C44B4B' }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 1.5rem;
    --spacing-lg: 2rem;
    --spacing-xl: 3rem;
    --spacing-xxl: 5rem;
    --transition-fast: 150ms ease;
    --transition-normal: 300ms ease;
    --transition-slow: 500ms ease;
  }
{% endstyle %}
