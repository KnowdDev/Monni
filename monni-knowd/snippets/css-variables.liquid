{% style %}
  html {
    font-size: 100%;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.7;
  }

  :root {
    --page: #f5f4f1;
    --ink: #2f2f2f;
    --soft: #6b6965;
    --rule: #dcd9d3;
    --cream: #ede8df;
    --display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --body: 'Jost', 'Helvetica Neue', Arial, sans-serif;

    --text-2xs: 0.66rem;
    --text-xs: 0.7rem;
    --text-sm: 0.78rem;
    --text-base: 0.95rem;
    --text-md: 0.98rem;
    --text-lg: 1.2rem;
    --text-xl: 1.45rem;
    --text-2xl: 1.8rem;
    --text-3xl: 2rem;
    --text-4xl: 2.4rem;
    --text-announcement: 0.66rem;
    --text-cta: 0.7rem;

    --font-heading--family: var(--display);
    --font-body--family: var(--body);
    --font-primary--family: var(--body);
    --font-primary--style: normal;
    --font-primary--weight: 300;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    --color-background: #f5f4f1;
    --color-background-alt: #ede8df;
    --color-foreground: #2f2f2f;
    --color-foreground-light: #6b6965;
    --color-foreground-muted: #6b6965;
    --color-accent: #dcd9d3;
    --color-accent-light: #ede8df;
    --color-accent-dark: #6b6965;
    --color-border: #dcd9d3;
    --color-border-light: #ede8df;
    --color-error: #2f2f2f;
    --color-ink: #2f2f2f;
    --color-ink-muted: #6b6965;
    --color-ink-ghost: #6b6965;
    --color-warm-white: #f5f4f1;

    --style-border-radius-inputs: 0px;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 1.5rem;
    --spacing-lg: 2rem;
    --spacing-xl: 3rem;
    --spacing-xxl: 5rem;
    --transition-fast: 150ms ease;
    --transition-normal: 300ms ease;
    --transition-slow: 500ms ease;
  }
{% endstyle %}
