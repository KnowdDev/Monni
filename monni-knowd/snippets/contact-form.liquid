{% comment %}
  Contact form snippet
  Reusable contact form component
{% endcomment %}

{% form 'contact', class: 'contact__form' %}
  {% if form.posted_successfully? %}
    <div class="contact__success" role="status">
      <p>{{ 'contact.form.post_success' | t }}</p>
    </div>
  {% endif %}

  {% if form.errors %}
    <div class="contact__errors" role="alert">
      {{ form.errors | default_errors }}
    </div>
  {% endif %}

  <div class="contact__field">
    <label for="contact-name" class="visually-hidden">{{ 'contact.form.name' | t }}</label>
    <input
      type="text"
      name="contact[name]"
      id="contact-name"
      class="contact__input"
      placeholder="NAME"
      {% if form.name %}value="{{ form.name }}"{% endif %}
      required
      aria-required="true"
      autocomplete="name"
    >
  </div>

  <div class="contact__field">
    <label for="contact-email" class="visually-hidden">{{ 'contact.form.email' | t }}</label>
    <input
      type="email"
      name="contact[email]"
      id="contact-email"
      class="contact__input"
      placeholder="EMAIL"
      {% if form.email %}value="{{ form.email }}"{% endif %}
      required
      aria-required="true"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="email"
    >
  </div>

  <div class="contact__field">
    <label for="contact-order" class="visually-hidden">Order number (optional)</label>
    <input
      type="text"
      name="contact[Order number]"
      id="contact-order"
      class="contact__input"
      placeholder="ORDER NUMBER (OPTIONAL)"
      {% if form['Order number'] %}value="{{ form['Order number'] }}"{% endif %}
      autocomplete="off"
    >
  </div>

  <div class="contact__field">
    <label for="contact-message" class="visually-hidden">{{ 'contact.form.message' | t }}</label>
    <textarea
      name="contact[body]"
      id="contact-message"
      class="contact__textarea"
      rows="4"
      placeholder="MESSAGE"
      required
      aria-required="true"
    >{% if form.body %}{{ form.body }}{% endif %}</textarea>
  </div>

  <button type="submit" class="contact__button button">
    Send
  </button>
{% endform %}
