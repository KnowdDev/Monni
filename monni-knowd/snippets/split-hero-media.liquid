{% comment %}
  Responsive split-hero image — mobile-first widths for LCP.
  @param image {Image}
  @param alt {string}
  @param lcp {boolean} — true for the first visible panel (preload + eager)
{% endcomment %}
{% liquid
  assign is_lcp = lcp | default: false
  assign mobile_src = image | image_url: width: 400, format: 'webp'
%}

{% if is_lcp %}
  {{ mobile_src | preload_tag: as: 'image', fetchpriority: 'high' }}
{% endif %}

<picture>
  <source
    type="image/webp"
    media="(min-width: 768px)"
    srcset="
      {{ image | image_url: width: 800, format: 'webp' }} 800w,
      {{ image | image_url: width: 600, format: 'webp' }} 600w
    "
    sizes="50vw"
  >
  <img
    src="{{ mobile_src }}"
    srcset="
      {{ image | image_url: width: 400, format: 'webp' }} 400w,
      {{ image | image_url: width: 320, format: 'webp' }} 320w,
      {{ image | image_url: width: 240, format: 'webp' }} 240w
    "
    sizes="100vw"
    alt="{{ alt | escape }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    class="split-hero__image"
    decoding="{% if is_lcp %}sync{% else %}async{% endif %}"
    {% if is_lcp %}
      loading="eager"
      fetchpriority="high"
    {% else %}
      loading="lazy"
      fetchpriority="low"
    {% endif %}
  >
</picture>
