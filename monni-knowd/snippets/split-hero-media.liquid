{% comment %}
  Responsive split-hero image — mobile-first widths for LCP.
  @param image {Image} — Shopify image picker (fallback)
  @param asset_filename {string} — theme asset WebP (preferred for LCP)
  @param alt {string}
  @param lcp {boolean} — true for the first visible panel (preload + eager)
  @param width {number}
  @param height {number}
{% endcomment %}
{% liquid
  assign is_lcp = lcp | default: false
  assign img_width = width | default: 720
  assign img_height = height | default: 899
  assign hero_sizes = '(max-width: 767px) 100vw, 50vw'
%}

{% if asset_filename != blank %}
  {% liquid
    assign asset_base = asset_filename | replace: '.webp', ''
    assign hero_src_480 = asset_base | append: '-480.webp' | asset_url
    assign hero_src_720 = asset_base | append: '-720.webp' | asset_url
    if is_lcp
      assign hero_src = hero_src_480
    else
      assign hero_src = asset_filename | asset_url
    endif
  %}
  <img
    src="{{ hero_src }}"
    srcset="
      {{ hero_src_480 }} 480w,
      {{ hero_src_720 }} 720w
    "
    sizes="{{ hero_sizes }}"
    alt="{{ alt | escape }}"
    width="{{ img_width }}"
    height="{{ img_height }}"
    class="split-hero__image"
    decoding="async"
    {% if is_lcp %}
      loading="eager"
      fetchpriority="high"
    {% else %}
      loading="lazy"
      fetchpriority="low"
    {% endif %}
  >
{% else %}
  {% liquid
    assign mobile_src = image | image_url: width: 480, format: 'webp'
    assign img_width = image.width | default: img_width
    assign img_height = image.height | default: img_height
  %}
  <picture>
    <source
      type="image/webp"
      media="(min-width: 768px)"
      srcset="{{ image | image_url: width: 720, format: 'webp' }} 720w"
      sizes="50vw"
    >
    <img
      src="{{ mobile_src }}"
      srcset="
        {{ image | image_url: width: 480, format: 'webp' }} 480w,
        {{ image | image_url: width: 720, format: 'webp' }} 720w
      "
      sizes="100vw"
      alt="{{ alt | escape }}"
      width="{{ img_width }}"
      height="{{ img_height }}"
      class="split-hero__image"
      decoding="async"
      {% if is_lcp %}
        loading="eager"
        fetchpriority="high"
      {% else %}
        loading="lazy"
        fetchpriority="low"
      {% endif %}
    >
  </picture>
{% endif %}
