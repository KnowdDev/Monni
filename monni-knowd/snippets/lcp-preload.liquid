{% comment %}
  LCP preload — must match split-hero left panel src/srcset selection.
  Default: optimized theme assets with responsive widths.
{% endcomment %}
{% if template.name == 'index' %}
  {% if settings.homepage_lcp_image != blank %}
    {% liquid
      assign lcp_mobile = settings.homepage_lcp_image | image_url: width: 480, format: 'webp'
      assign lcp_desktop = settings.homepage_lcp_image | image_url: width: 720, format: 'webp'
    %}
    <link rel="preload" as="image" href="{{ lcp_mobile }}" media="(max-width: 767px)" fetchpriority="high">
    <link rel="preload" as="image" href="{{ lcp_desktop }}" media="(min-width: 768px)" fetchpriority="high">
  {% else %}
    {% liquid
      assign lcp_base = 'monni-hero-left'
      assign lcp_480 = lcp_base | append: '-480.webp' | asset_url
      assign lcp_720 = lcp_base | append: '-720.webp' | asset_url
    %}
    <link
      rel="preload"
      as="image"
      href="{{ lcp_720 }}"
      imagesrcset="{{ lcp_480 }} 480w, {{ lcp_720 }} 720w"
      imagesizes="(max-width: 767px) 100vw, 50vw"
      fetchpriority="high"
    >
  {% endif %}
{% endif %}
