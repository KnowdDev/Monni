<section
  class="lookbook full-width"
  data-section-id="{{ section.id }}"
  data-layout="{{ section.settings.layout }}"
  data-animate
>
  <div class="lookbook__panel lookbook__panel--image">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 480, format: 'webp' }}"
        srcset="
          {{ section.settings.image | image_url: width: 800, format: 'webp' }} 800w,
          {{ section.settings.image | image_url: width: 600, format: 'webp' }} 600w,
          {{ section.settings.image | image_url: width: 480, format: 'webp' }} 480w,
          {{ section.settings.image | image_url: width: 360, format: 'webp' }} 360w
        "
        sizes="(max-width: 767px) 100vw, 50vw"
        alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
        loading="lazy"
        decoding="async"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {% else %}
      <div class="lookbook__fallback texture-grain">
        <span class="lookbook__fallback-label">{{ section.settings.title | escape }}</span>
      </div>
    {% endif %}
  </div>

  <div class="lookbook__panel lookbook__panel--content">
    <div class="lookbook__text">
      {% if section.settings.subtitle != blank %}
        <p class="lookbook__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="lookbook__title">{{ section.settings.title | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="lookbook__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="lookbook__button">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .lookbook {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 60vh;
  }

  @media (min-width: 768px) {
    .lookbook {
      grid-template-columns: 1fr 1fr;
      min-height: 70vh;
    }

    .lookbook[data-layout="text-left"] .lookbook__panel--image { order: 2; }
    .lookbook[data-layout="text-left"] .lookbook__panel--content { order: 1; }
  }

  .lookbook__panel--image {
    position: relative;
    overflow: hidden;
  }

  .lookbook__panel--image img,
  .lookbook__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lookbook__placeholder {
    background: linear-gradient(135deg, var(--color-border-light) 0%, var(--color-border) 100%);
  }

  .lookbook__fallback {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(196, 184, 168, 0.25) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 70%, rgba(217, 208, 196, 0.2) 0%, transparent 50%),
      linear-gradient(145deg, var(--color-border-light) 0%, var(--color-accent-light) 50%, var(--color-background) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl);
  }

  .lookbook__fallback-label {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-foreground-muted);
    letter-spacing: -0.01em;
    text-align: center;
    line-height: 1.2;
    max-width: 16ch;
    opacity: 0.7;
  }

  .lookbook__panel--content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl) var(--spacing-lg);
    background-color: var(--color-background-alt);
  }

  .lookbook__text {
    max-width: 42ch;
  }

  .lookbook__subtitle {
    font-size: 0.8125rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    margin-bottom: var(--spacing-sm);
  }

  .lookbook__title {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 300;
    margin-bottom: var(--spacing-md);
  }

  .lookbook__description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-foreground-light);
    margin-bottom: var(--spacing-lg);
  }

  .lookbook__button {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--color-foreground);
    color: var(--color-foreground);
    background-color: transparent;
    transition: all var(--transition-normal);
  }

  .lookbook__button:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook / Editorial",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Image left, text right" },
        { "value": "text-left", "label": "Text left, image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The journal"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Rituals of slow living"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the art of intentional living through our curated stories on wellness, design, and the quiet beauty of everyday moments.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Lookbook / Editorial",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
