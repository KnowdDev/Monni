<section class="opening-statement full-width" data-section-id="{{ section.id }}">
  <div class="opening-statement__inner">
    <p class="opening-statement__line opening-statement__line--primary">{{ section.settings.line_1 | default: 'A place to pause. A place to connect.' | escape }}</p>
    {%- liquid
      assign lead = section.settings.statement
      assign ending = section.settings.statement_ending
      if lead == blank
        assign lead = 'A considered collection of natural skincare, botanical perfume, organic tea, handmade jewellery, ceramics, art, slow fashion and pieces for the home,'
      endif
      assign legacy_ending = 'from women-founded makers who care for people and planet.'
      if lead contains legacy_ending
        assign lead = lead | replace: legacy_ending, '' | strip
      endif
      assign lead = lead | strip
      if ending != blank
        assign ending = ending | strip
      endif
      capture statement_text
        echo lead
        if ending != blank
          echo ' '
          echo ending
        endif
      endcapture
      assign statement_html = statement_text | strip | escape | replace: 'women-founded', '<span class="opening-statement__keep">women-founded</span>'
    -%}
    <p class="opening-statement__line opening-statement__line--secondary">{{ statement_html }}</p>
  </div>
</section>

{% style %}
  .opening-statement {
    background-color: var(--color-background);
    padding: 80px 16px;
    text-align: center;
  }

  .opening-statement__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .opening-statement__line {
    margin: 0;
  }

  .opening-statement__line--primary {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--color-foreground);
    margin-bottom: 22px;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  @media (min-width: 768px) {
    .opening-statement__line--primary { font-size: 1.9rem; }
  }

  @media (min-width: 1100px) {
    .opening-statement__line--primary { white-space: nowrap; }
  }

  .opening-statement__keep { white-space: nowrap; }

  .opening-statement__line--secondary {
    font-family: var(--font-body--family);
    font-size: 1.05rem;
    font-weight: 300;
    font-style: normal;
    color: #6b6965;
    letter-spacing: 0;
    line-height: 1.65;
    text-wrap: balance;
  }
{% endstyle %}

{% schema %}
{
  "name": "Opening Statement",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "line_1",
      "label": "First line",
      "default": "A place to pause. A place to connect."
    },
    {
      "type": "textarea",
      "id": "statement",
      "label": "Sentence",
      "info": "The line under the double photo, including the comma at the end.",
      "default": "A considered collection of natural skincare, botanical perfume, organic tea, handmade jewellery, ceramics, art, slow fashion and pieces for the home,"
    },
    {
      "type": "text",
      "id": "statement_ending",
      "label": "Sentence ending",
      "info": "Shown after the sentence. Clear this field to drop the ending without a code change.",
      "default": "from women-founded makers who care for people and planet."
    }
  ],
  "presets": [
    {
      "name": "Opening Statement",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
