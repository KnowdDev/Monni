{% comment %}
  Monni Product Page — Brand-aligned, hyper-converting, modular for product-type customization
{% endcomment %}

{%- render 'schema-product' -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_media = current_variant.featured_media | default: product.featured_media -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign product_type = product.type | downcase -%}

{%- assign is_fragrance = false -%}
{%- if product.tags contains 'fragrance' or product_type contains 'fragrance' or product_type contains 'scent' -%}
  {%- assign is_fragrance = true -%}
{%- endif -%}

{%- assign is_beauty = false -%}
{%- if product.tags contains 'beauty' or product_type contains 'beauty' or product_type contains 'skincare' -%}
  {%- assign is_beauty = true -%}
{%- endif -%}

{%- assign is_homewares = false -%}
{%- if product.tags contains 'homewares' or product_type contains 'home' or product_type contains 'ceramic' -%}
  {%- assign is_homewares = true -%}
{%- endif -%}

{%- comment -%} MONNI Label is made to order — storefront CTA reads Pre-order. {%- endcomment -%}
{%- assign is_monni_label = false -%}
{%- assign vendor_down = product.vendor | downcase -%}
{%- if vendor_down == 'monni label' or product.tags contains 'pre-order' or product.tags contains 'Pre-order' or product.tags contains 'monni-label' -%}
  {%- assign is_monni_label = true -%}
{%- endif -%}
{%- unless is_monni_label -%}
  {%- for collection in product.collections -%}
    {%- if collection.handle == 'monni-label' -%}
      {%- assign is_monni_label = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endunless -%}

{%- capture clothing_check -%}{%- render 'is-clothing-product', product: product -%}{%- endcapture -%}
{%- assign clothing_stripped = clothing_check | strip -%}
{%- assign is_clothing = false -%}
{%- if clothing_stripped == 'true' -%}
  {%- assign is_clothing = true -%}
{%- endif -%}

{%- assign has_size_option = false -%}
{%- for option in product.options_with_values -%}
  {%- assign option_name_down = option.name | downcase -%}
  {%- if option_name_down contains 'size' -%}
    {%- assign has_size_option = true -%}
  {%- endif -%}
{%- endfor -%}

{%- assign is_jewellery = false -%}
{%- if product.tags contains 'jewellery' or product_type contains 'jewellery' or product_type contains 'jewelry' -%}
  {%- assign is_jewellery = true -%}
{%- endif -%}

<product-page class="product-page" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-product-type="{{ product_type }}" data-update-url="true" data-url="{{ product.url }}" data-money-format="{{ shop.money_format | escape }}">
  <script type="application/json" data-product-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "compare_at_price": {{ variant.compare_at_price | json }},
          "price_formatted": {{ variant.price | money | strip_html | json }},
          "compare_at_price_formatted": {{ variant.compare_at_price | money | strip_html | json }},
          "options": {{ variant.options | json }},
          "featured_media_id": {{ variant.featured_media.id | json }},
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
  <div class="product-page__layout">
    <!-- Gallery -->
    <div class="product-page__gallery" data-header-photo>
      <media-gallery class="media-gallery" data-section="{{ section.id }}">
        <div class="media-gallery__main">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="media-gallery__slide{% if media == featured_media %} is-active{% endif %}" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}" role="tabpanel">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img src="{{ media | image_url: width: 1200 }}" srcset="{{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 600 }} 600w" sizes="(min-width: 1024px) 55vw, 100vw" alt="{{ media.alt | default: product.title | escape }}" loading="{% if media == featured_media %}eager{% else %}lazy{% endif %}"{% if media == featured_media %} fetchpriority="high"{% endif %} decoding="async" width="{{ media.width }}" height="{{ media.height }}" class="media-gallery__image">
                  {%- when 'external_video' -%}
                    <div class="media-gallery__video" data-video-url="{{ media | external_video_url }}">
                      <button type="button" class="media-gallery__play" aria-label="Play video"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="5 3 19 12 5 21 5 3"/></svg></button>
                      <img src="{{ media.preview_image | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" loading="{% if media == featured_media %}eager{% else %}lazy{% endif %}"{% if media == featured_media %} fetchpriority="high"{% endif %} width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}">
                    </div>
                  {%- else -%}
                    <img src="{{ media.preview_image | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" loading="lazy" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" class="media-gallery__image">
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="media-gallery__slide is-active"><div class="media-gallery__placeholder texture-grain"><span>{{ product.title | escape }}</span></div></div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="media-gallery__thumbs" role="tablist">
            {%- for media in product.media -%}
              <button type="button" class="media-gallery__thumb{% if media == featured_media %} is-active{% endif %}" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}" role="tab" aria-selected="{% if media == featured_media %}true{% else %}false{% endif %}">
                <img src="{{ media.preview_image | image_url: width: 120 }}" alt="{{ media.alt | escape }}" loading="lazy" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}">
              </button>
            {%- endfor -%}
          </div>
          <div class="media-gallery__dots" role="tablist">
            {%- for media in product.media -%}
              <button type="button" class="media-gallery__dot{% if media == featured_media %} is-active{% endif %}" data-index="{{ forloop.index0 }}" role="tab"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if product.media.size > 1 -%}
          <div class="media-gallery__lines" aria-hidden="true">
            {%- for media in product.media -%}
              <span class="media-gallery__line{% if media == featured_media %} is-active{% endif %}" data-index="{{ forloop.index0 }}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </media-gallery>
    </div>

    <!-- Product Info -->
    <div class="product-page__info">
      {% render 'product-purchase', product: product, section: section, product_form_id: product_form_id %}
    </div>
  </div>

      <!-- Product Type-Specific Sections (modular customization) -->
  {%- if is_fragrance and section.settings.show_fragrance_story -%}
    <section class="product-page__story">
      <div class="product-page__story-content">
        <h2>The Story Behind This Scent</h2>
        <p>{{ product.metafields.fragrance.story | default: 'Crafted with intention, this fragrance captures a moment in time—a feeling, a memory, a place.' }}</p>
      </div>
    </section>
  {%- endif -%}

  <!-- Recently Viewed -->
  <section class="product-page__recently-viewed" data-recently-viewed hidden>
    <h2>Recently viewed</h2>
    <div class="product-page__recently-viewed-grid" data-recently-viewed-grid></div>
  </section>

</product-page>

{% stylesheet %}
  .product-page__wishlist {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: var(--spacing-sm);
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .product-page__wishlist svg {
    fill: none;
    transition: fill var(--duration-fast);
  }

  .product-page__wishlist.is-active svg {
    fill: currentColor;
  }

  .product-page__wishlist:hover {
    border-color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "range",
      "id": "quantity_max",
      "min": 5,
      "max": 50,
      "step": 1,
      "label": "Maximum quantity",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show buy now button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_trust_signals",
      "label": "Show trust signals",
      "default": true
    },
    {
      "type": "header",
      "content": "Trust signal copy"
    },
    {
      "type": "text",
      "id": "trust_signal_shipping_text",
      "label": "Shipping trust signal",
      "default": "Free shipping over $250"
    },
    {
      "type": "text",
      "id": "trust_signal_returns_text",
      "label": "Returns trust signal",
      "default": "Store credit on eligible returns"
    },
    {
      "type": "text",
      "id": "trust_signal_checkout_text",
      "label": "Checkout trust signal",
      "default": "Secure checkout"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show full description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide (clothing)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_accordion",
      "label": "Show shipping/returns accordion",
      "default": true
    },
    {
      "type": "header",
      "content": "Accordion copy"
    },
    {
      "type": "text",
      "id": "shipping_accordion_heading",
      "label": "Shipping accordion heading",
      "default": "Shipping & Delivery"
    },
    {
      "type": "richtext",
      "id": "shipping_accordion_content",
      "label": "Shipping accordion content",
      "default": "<p>We offer free shipping on orders over $250. Standard shipping takes 3-5 business days. Express shipping available at checkout.</p>"
    },
    {
      "type": "text",
      "id": "returns_accordion_heading",
      "label": "Returns accordion heading",
      "default": "Returns Policy"
    },
    {
      "type": "richtext",
      "id": "returns_accordion_content",
      "label": "Returns accordion content",
      "default": "<p>Get in touch within 7 days of delivery. Eligible unused items can be returned for store credit. <a href=\"/policies/refund-policy\">Read the returns policy</a>.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social_share",
      "label": "Show social share",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_in_stock",
      "label": "Show back in stock notification (sold out products)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fragrance_story",
      "label": "Show fragrance story (fragrance products)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Related collection"
    }
  ]
}
{% endschema %}
