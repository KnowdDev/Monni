<footer class="footer full-width" data-section-id="{{ section.id }}" data-footer-layout="editorial">
  <div class="footer__inner">
    <div class="footer__cols">
      <details class="footer__disclosure footer__disclosure--care" open>
        <summary class="footer__heading">Customer Care</summary>
        <ul class="footer__menu">
          <li><a href="/pages/contact"{% if request.path == '/pages/contact' %} aria-current="page"{% endif %}>Contact</a></li>
          <li><a href="/policies/shipping-policy"{% if request.path == '/policies/shipping-policy' %} aria-current="page"{% endif %}>Shipping + Delivery</a></li>
          <li><a href="/policies/refund-policy"{% if request.path == '/policies/refund-policy' %} aria-current="page"{% endif %}>Returns</a></li>
          <li><a href="/pages/start-a-return"{% if request.path == '/pages/start-a-return' %} aria-current="page"{% endif %}>Start a Return</a></li>
        </ul>
      </details>
      <details class="footer__disclosure footer__disclosure--info" open>
        <summary class="footer__heading">Info</summary>
        <ul class="footer__menu">
          <li><a href="/pages/brands"{% if request.path == '/pages/brands' %} aria-current="page"{% endif %}>Brands</a></li>
          <li><a href="/blogs/journal"{% if request.page_type == 'blog' or request.page_type == 'article' %} aria-current="page"{% endif %}>Journal</a></li>
          <li><a href="/pages/about"{% if request.path == '/pages/about' %} aria-current="page"{% endif %}>About</a></li>
          <li><a href="/products/gift-card"{% if request.path == '/products/gift-card' %} aria-current="page"{% endif %}>Gift Card</a></li>
          <li><a href="/pages/size-guide"{% if request.path == '/pages/size-guide' %} aria-current="page"{% endif %}>Size Guide</a></li>
          <li><a href="/policies/privacy-policy"{% if request.path == '/policies/privacy-policy' %} aria-current="page"{% endif %}>Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service"{% if request.path == '/policies/terms-of-service' %} aria-current="page"{% endif %}>Terms + Conditions</a></li>
        </ul>
      </details>
      <div class="footer__store">
        <p class="footer__heading">Our Store</p>
        <p>In the heart of Matakana Village,<br>Aotearoa New Zealand.</p>
        <p>5A, 2 Matakana Valley Road<br>Matakana 0985</p>
        <p>
          Store hours:<br>
          {% if settings.store_hours != blank %}
            {{ settings.store_hours | newline_to_br }}
          {% else %}
            Sunday – Friday | 10am – 4pm<br>Saturday | 9am – 5pm
          {% endif %}
        </p>
        <p><a class="footer__visit" href="https://maps.google.com/?q=5A+2+Matakana+Valley+Road+Matakana" target="_blank" rel="noopener">Visit us</a></p>
        <p>
          <a href="mailto:{{ settings.contact_email | default: 'hello@teaandtonic.co.nz' }}">{{ settings.contact_email | default: 'hello@teaandtonic.co.nz' }}</a><br>
          <a href="tel:+6494229083">{{ settings.contact_phone | default: '09 422 9083' }}</a>
        </p>
      </div>
      <div class="footer__news">
        <p class="footer__heading">Subscribe to our newsletter for 10% off your first order.</p>
        {% form 'customer', class: 'footer__form' %}
          {% if form.posted_successfully? %}
            <p class="footer__success">Thank you. Your 10% welcome code is on its way.</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="contact[accepts_marketing]" value="true">
            <div class="footer__field">
              <label class="visually-hidden" for="FooterEmail">Email address</label>
              <input id="FooterEmail" type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required autocomplete="email" autocapitalize="off">
              <button type="submit">Join us</button>
            </div>
            {% if form.errors %}
              <p class="footer__error">{{ form.errors.messages['email'] }}</p>
            {% endif %}
          {% endif %}
        {% endform %}
        <p class="footer__social">
          <a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/teaandtonicmatakana/' }}" target="_blank" rel="noopener">Instagram</a>
          <span aria-hidden="true"> &nbsp;.&nbsp; </span>
          <a href="{{ settings.social_facebook_link | default: 'https://www.facebook.com/teaandtonicmatakana' }}" target="_blank" rel="noopener">Facebook</a>
        </p>
      </div>
    </div>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments" role="list" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <li class="footer__payments-item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="footer__base">
      <p>Free NZ shipping over $250 · We ship to NZ &amp; Australia</p>
      <p>&copy; {{ 'now' | date: '%Y' }} Ayson and Anastasia Limited trading as Tea &amp; Tonic. Site by <a href="https://knowd.nz" rel="nofollow">Knowd</a>.</p>
    </div>
  </div>
  <script>
    (function () {
      var mq = window.matchMedia('(min-width: 768px)');
      var groups = document.querySelectorAll('.footer__disclosure');
      function apply() {
        groups.forEach(function (el) {
          var summary = el.querySelector('summary');
          el.open = true;
          if (summary) summary.tabIndex = -1;
        });
      }
      groups.forEach(function (el) {
        el.addEventListener('toggle', function () {
          if (!el.open) el.open = true;
        });
      });
      apply();
      if (mq.addEventListener) mq.addEventListener('change', apply);
    })();
  </script>
</footer>

{% style %}
  .footer {
    background: var(--color-background);
    color: #2f2f2f;
    border-top: 1px solid #dcd9d3;
    margin-top: auto;
    padding: clamp(2.75rem, 6vw, 4rem) 0 2.25rem;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .footer__inner {
    max-width: 105rem;
    margin: 0 auto;
    padding: 0 16px;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 561px) {
    .footer__cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem 2rem; }
  }

  @media (min-width: 901px) {
    .footer__cols { grid-template-columns: 1fr 1fr 1.2fr 1.4fr; gap: 2.5rem; }
  }

  .footer__heading {
    margin: 0 0 1rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .footer__disclosure {
    margin: 0;
    min-width: 0;
  }

  .footer__disclosure summary {
    list-style: none;
  }

  .footer__disclosure summary::-webkit-details-marker { display: none; }
  .footer__disclosure summary::marker { content: ""; }

  .footer__disclosure summary.footer__heading {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-weight: 400;
    color: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  .footer__disclosure::details-content { transition: none; }

  @media (min-width: 768px) {
    .footer__disclosure summary.footer__heading {
      cursor: default;
      pointer-events: none;
    }
  }

  .footer__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    color: #6b6965;
  }

  .footer a { color: inherit; text-decoration: none; }
  .footer__menu a:hover { color: #2f2f2f; }
  .footer__menu a[aria-current="page"] { color: #2f2f2f; text-decoration: underline; text-underline-offset: 4px; }

  .footer__store p { margin: 0 0 1rem; line-height: 1.9; }
  .footer__store p.footer__heading { margin-bottom: 1rem; line-height: 1.4; }

  .footer .footer__visit {
    color: #2f2f2f;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .footer__field {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1.35rem;
  }

  .footer__field input {
    flex: 1;
    min-width: 0;
    border: 1px solid #2f2f2f;
    background: transparent;
    padding: 0.85rem 1rem;
    font: inherit;
    letter-spacing: 0.08em;
    color: #2f2f2f;
    text-transform: uppercase;
  }

  .footer__field button {
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
    padding: 0;
  }

  .footer__social { margin: 0; }
  .footer__success, .footer__error { margin: 0 0 1rem; line-height: 1.6; }

  .footer__payments {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    padding: 0;
  }

  .footer__payments-item { margin: 0; line-height: 0; }

  .footer__payments svg {
    display: block;
    width: 38px;
    height: 24px;
    filter: grayscale(1);
  }

  .footer__base {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    color: #6b6965;
    line-height: 2;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .footer__base p { margin: 0; }

  @media (max-width: 767px) {
    .footer {
      background: #f5f4f1;
      color: #2f2f2f;
      border-top: 1px solid #2f2f2f;
      padding: 0 0 1.75rem;
      overflow-x: clip;
      text-transform: none;
      font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
      font-weight: 300;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      line-height: 1.65;
    }

    .footer__inner {
      max-width: 100%;
      padding: 0 22px;
    }

    .footer__cols {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .footer__cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.5rem;
    }

    .footer__store { order: 1; grid-column: 1 / -1; }
    .footer__disclosure--care { order: 2; }
    .footer__disclosure--info { order: 3; }
    .footer__news { order: 4; grid-column: 1 / -1; }

    .footer__store,
    .footer__news { border-bottom: 1px solid #dcd9d3; }
    .footer__disclosure { padding: 1.75rem 0; }
    .footer__news { border-top: 1px solid #dcd9d3; }

    .footer__store,
    .footer__news { padding: 1.75rem 0; }
    .footer__store { padding-top: 2.25rem; }

    .footer__heading {
      margin: 0 0 1.1rem;
      font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
      font-weight: 400;
      font-size: 0.68rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      line-height: 1.4;
      color: #2f2f2f;
    }

    .footer__disclosure summary.footer__heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1.1rem;
      padding: 0;
      cursor: default;
      pointer-events: none;
      font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
      font-size: 0.68rem;
      font-weight: 400;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      line-height: 1.4;
    }

    .footer__disclosure summary.footer__heading::after {
      display: none;
      content: "";
      width: 7px;
      height: 7px;
      border-right: 1px solid #2f2f2f;
      border-bottom: 1px solid #2f2f2f;
      transform: rotate(45deg);
      margin-top: -4px;
      flex: none;
    }

    .footer__disclosure[open] summary.footer__heading::after {
      transform: rotate(-135deg);
      margin-top: 2px;
    }

    .footer__disclosure summary:focus-visible {
      outline: 1px solid #2f2f2f;
      outline-offset: 3px;
    }

    .footer__menu {
      gap: 0.7rem;
      padding: 0;
      color: #2f2f2f;
      font-weight: 300;
      font-size: 0.95rem;
      letter-spacing: 0.02em;
      text-transform: none;
    }

    .footer__menu a:hover,
    .footer__menu a:focus-visible {
      color: #2f2f2f;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .footer__store p {
      margin: 0 0 1.05rem;
      font-weight: 300;
      font-size: 0.95rem;
      line-height: 1.65;
      letter-spacing: 0.01em;
      text-transform: none;
      color: #2f2f2f;
    }

    .footer__store p.footer__heading {
      margin-bottom: 1.15rem;
      font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
      font-size: 0.68rem;
      font-weight: 400;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      line-height: 1.4;
      color: #2f2f2f;
    }
    .footer__store p:last-child { margin-bottom: 0; }

    .footer__news .footer__heading {
      font-family: "Cormorant Garamond", Georgia, serif;
      font-weight: 400;
      font-style: italic;
      font-size: 1.2rem;
      letter-spacing: 0;
      text-transform: none;
      line-height: 1.35;
      max-width: 22em;
      margin: 0 0 0.9rem;
      text-wrap: balance;
    }

    .footer__field {
      flex-wrap: nowrap;
      align-items: center;
      gap: 0;
      margin: 0 0 1.2rem;
      max-width: 100%;
    }

    .footer__field input {
      flex: 1 1 auto;
      width: 1%;
      min-width: 0;
      min-height: 44px;
      padding: 0.5rem 0;
      border: 0;
      border-bottom: 1px solid #2f2f2f;
      border-radius: 0;
      background: transparent;
      font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
      font-size: 16px;
      font-weight: 300;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #2f2f2f;
    }

    .footer__field input::placeholder { color: #6b6965; opacity: 1; }

    .footer__field button {
      flex: none;
      min-height: 44px;
      border-bottom: 1px solid #2f2f2f;
      padding: 0 0 0 0.75rem;
      font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
      font-size: 0.68rem;
      font-weight: 400;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .footer__social {
      margin: 0;
      font-size: 0.68rem;
      font-weight: 400;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .footer__social span { color: #6b6965; }

    .footer__success,
    .footer__error {
      font-size: 0.95rem;
      font-weight: 300;
      letter-spacing: 0.01em;
      text-transform: none;
      line-height: 1.55;
    }

    .footer a:focus-visible,
    .footer button:focus-visible,
    .footer input:focus-visible {
      outline: 1px solid #2f2f2f;
      outline-offset: 3px;
    }

    .footer__payments {
      margin: 1.35rem 0 0;
      gap: 0.4rem;
      max-width: 100%;
    }

    .footer__payments svg {
      width: 36px;
      height: 22px;
    }

    .footer__base {
      display: block;
      margin-top: 1.1rem;
      padding-top: 0;
      border-top: 0;
      color: #6b6965;
      font-size: 0.78rem;
      font-weight: 300;
      letter-spacing: 0.03em;
      line-height: 1.65;
      text-transform: none;
    }

    .footer__base p + p { margin-top: 0.55rem; }

    .footer a { overflow-wrap: anywhere; }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .footer__disclosure summary.footer__heading::after { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Shop column"
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "header",
      "content": "Help column"
    },
    {
      "type": "link_list",
      "id": "menu_help",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Heading",
      "default": "Help"
    },
    {
      "type": "header",
      "content": "About column"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "Heading",
      "default": "About"
    },
    {
      "type": "header",
      "content": "Footer options"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.footer"
    }
  ]
}
{% endschema %}
