<footer class="footer full-width" data-section-id="{{ section.id }}">
  <div class="footer__inner">
    <div class="footer__cols">
      <div>
        <p class="footer__heading">Customer Care</p>
        <ul class="footer__menu">
          <li><a href="/pages/contact"{% if request.path == '/pages/contact' %} aria-current="page"{% endif %}>Contact</a></li>
          <li><a href="/policies/shipping-policy"{% if request.path == '/policies/shipping-policy' %} aria-current="page"{% endif %}>Shipping + Delivery</a></li>
          <li><a href="/policies/refund-policy"{% if request.path == '/policies/refund-policy' %} aria-current="page"{% endif %}>Returns</a></li>
          <li><a href="/pages/start-a-return"{% if request.path == '/pages/start-a-return' %} aria-current="page"{% endif %}>Start a Return</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__heading">Info</p>
        <ul class="footer__menu">
          <li><a href="/pages/brands"{% if request.path == '/pages/brands' %} aria-current="page"{% endif %}>Brands</a></li>
          <li><a href="/blogs/journal"{% if request.page_type == 'blog' or request.page_type == 'article' %} aria-current="page"{% endif %}>Journal</a></li>
          <li><a href="/pages/about"{% if request.path == '/pages/about' %} aria-current="page"{% endif %}>About</a></li>
          <li><a href="/products/gift-card"{% if request.path == '/products/gift-card' %} aria-current="page"{% endif %}>Gift Card</a></li>
          <li><a href="/pages/size-guide"{% if request.path == '/pages/size-guide' %} aria-current="page"{% endif %}>Size Guide</a></li>
          <li><a href="/policies/privacy-policy"{% if request.path == '/policies/privacy-policy' %} aria-current="page"{% endif %}>Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service"{% if request.path == '/policies/terms-of-service' %} aria-current="page"{% endif %}>Terms + Conditions</a></li>
        </ul>
      </div>
      <div class="footer__store">
        <p class="footer__heading">Our Store</p>
        <p>In the heart of Matakana Village,<br>Aotearoa New Zealand.</p>
        <p>5A, 2 Matakana Valley Road<br>Matakana 0985</p>
        <p>
          Store hours:<br>
          {% if settings.store_hours != blank %}
            {{ settings.store_hours | newline_to_br }}
          {% else %}
            Sunday – Friday | 10am – 4pm<br>Saturday | 9am – 5pm
          {% endif %}
        </p>
        <p><a class="footer__visit" href="https://maps.google.com/?q=5A+2+Matakana+Valley+Road+Matakana" target="_blank" rel="noopener">Visit us</a></p>
        <p>
          <a href="mailto:{{ settings.contact_email | default: 'hello@teaandtonic.co.nz' }}">{{ settings.contact_email | default: 'hello@teaandtonic.co.nz' }}</a><br>
          <a href="tel:+6494229083">{{ settings.contact_phone | default: '09 422 9083' }}</a>
        </p>
      </div>
      <div>
        <p class="footer__heading">Subscribe to our newsletter for 10% off your first order.</p>
        {% form 'customer', class: 'footer__form' %}
          {% if form.posted_successfully? %}
            <p class="footer__success">Thank you. Your 10% welcome code is on its way.</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="contact[accepts_marketing]" value="true">
            <div class="footer__field">
              <label class="visually-hidden" for="FooterEmail">Email address</label>
              <input id="FooterEmail" type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required autocomplete="email" autocapitalize="off">
              <button type="submit">Join us</button>
            </div>
            {% if form.errors %}
              <p class="footer__error">{{ form.errors.messages['email'] }}</p>
            {% endif %}
          {% endif %}
        {% endform %}
        <p class="footer__social">
          <a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/teaandtonicmatakana/' }}" target="_blank" rel="noopener">Instagram</a>
          <span aria-hidden="true"> &nbsp;.&nbsp; </span>
          <a href="{{ settings.social_facebook_link | default: 'https://www.facebook.com/teaandtonicmatakana' }}" target="_blank" rel="noopener">Facebook</a>
        </p>
      </div>
    </div>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments" role="list" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <li class="footer__payments-item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="footer__base">
      <p>Free NZ shipping over $250 · We ship to NZ &amp; Australia</p>
      <p>&copy; {{ 'now' | date: '%Y' }} Ayson and Anastasia Limited trading as Tea &amp; Tonic. Site by Knowd Digital.</p>
    </div>
  </div>
</footer>

{% style %}
  .footer {
    background: var(--color-background);
    color: #2f2f2f;
    border-top: 1px solid #dcd9d3;
    margin-top: auto;
    padding: clamp(2.75rem, 6vw, 4rem) 0 2.25rem;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .footer__inner {
    max-width: 105rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 561px) {
    .footer__cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem 2rem; }
  }

  @media (min-width: 901px) {
    .footer__cols { grid-template-columns: 1fr 1fr 1.2fr 1.4fr; gap: 2.5rem; }
  }

  .footer__heading {
    margin: 0 0 1rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .footer__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    color: #6b6965;
  }

  .footer a { color: inherit; text-decoration: none; }
  .footer__menu a:hover { color: #2f2f2f; }
  .footer__menu a[aria-current="page"] { color: #2f2f2f; text-decoration: underline; text-underline-offset: 4px; }

  .footer__store p { margin: 0 0 1rem; line-height: 1.9; }
  .footer__store p.footer__heading { margin-bottom: 1rem; line-height: 1.4; }

  .footer .footer__visit {
    color: #2f2f2f;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .footer__field {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1.35rem;
  }

  .footer__field input {
    flex: 1;
    min-width: 0;
    border: 1px solid #2f2f2f;
    background: transparent;
    padding: 0.85rem 1rem;
    font: inherit;
    letter-spacing: 0.08em;
    color: #2f2f2f;
    text-transform: uppercase;
  }

  .footer__field button {
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
    padding: 0;
  }

  .footer__social { margin: 0; }
  .footer__success, .footer__error { margin: 0 0 1rem; line-height: 1.6; }

  .footer__payments {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    padding: 0;
  }

  .footer__payments-item { margin: 0; line-height: 0; }

  .footer__payments svg {
    display: block;
    width: 38px;
    height: 24px;
  }

  .footer__base {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    color: #6b6965;
    line-height: 2;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .footer__base p { margin: 0; }
{% endstyle %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Shop column"
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "header",
      "content": "Help column"
    },
    {
      "type": "link_list",
      "id": "menu_help",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Heading",
      "default": "Help"
    },
    {
      "type": "header",
      "content": "About column"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "Heading",
      "default": "About"
    },
    {
      "type": "header",
      "content": "Footer options"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.footer"
    }
  ]
}
{% endschema %}
