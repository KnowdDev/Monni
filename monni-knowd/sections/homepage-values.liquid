{% if section.blocks.size > 0 %}
  <section class="values full-width" data-section-id="{{ section.id }}" data-animate>
    <div class="values__grid">
      {% for block in section.blocks %}
        <div class="value-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="value-item__icon">
              {{ block.settings.icon }}
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="value-item__title">{{ block.settings.title | escape }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="value-item__text">{{ block.settings.text | escape }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .values {
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(240, 235, 231, 0.7) 100%);
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }

  .values__grid {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-lg);
    text-align: center;
  }

  .value-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0 var(--spacing-sm);
  }

  @media (min-width: 768px) {
    .value-item:not(:last-child) {
      border-right: 1px solid rgba(229, 224, 220, 0.8);
    }
  }

  .value-item__icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-accent-dark);
    margin-bottom: var(--spacing-xs);
  }

  .value-item__icon svg {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }

  .value-item__title {
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .value-item__text {
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
    line-height: 1.5;
    max-width: 24ch;
  }

  @media (max-width: 767px) {
    .values__grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .value-item {
      padding: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Value Strip",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon SVG",
          "info": "Paste inline SVG code (24x24 viewBox recommended)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Curated with care"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Every piece chosen for quality and intention"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Strip",
      "category": "Homepage",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
