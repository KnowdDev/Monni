{% comment %}
  Blog Page — Monni Theme
  Editorial journal listing. Excerpt HTML from the admin is stripped so
  rich-text font sizes/styles can never break card cohesion.
{% endcomment %}

{%- liquid
  assign articles_per_page = section.settings.articles_per_page | default: 9
  assign show_excerpts = section.settings.show_excerpts
  assign show_dates = section.settings.show_dates
  assign filter_tags = section.settings.filter_tags | split: ','
  if section.settings.filter_tags == blank
    assign filter_tags = 'Our Women|Rituals|From Monni|Focus' | split: '|'
  endif
  assign is_journal = false
  if blog.handle == 'journal'
    assign is_journal = true
    assign show_dates = false
  endif
-%}

<section class="blog-page full-width">
  <div class="container">
    <header class="blog-page__header">
      {%- if blog.handle == 'journal' -%}
        <h1 class="blog-page__title">Stories &amp; Rituals</h1>
        <p class="blog-page__intro">Pour a cup and stay a while. Stories from our makers, seasonal rituals and gentle reflections on living well.</p>
      {%- else -%}
        <h1 class="blog-page__title">{{ blog.title }}</h1>
      {%- endif -%}
    </header>

    {%- if filter_tags.size > 0 -%}
      <nav class="blog-page__tabs" aria-label="Filter stories">
        <a href="{{ blog.url }}" class="blog-page__tab{% unless current_tags %} is-active{% endunless %}"{% unless current_tags %} aria-current="page"{% endunless %}>All</a>
        {%- for tag in filter_tags -%}
          {%- liquid
            assign tag_label = tag | strip
            assign tag_active = false
            assign tag_down = tag_label | downcase
            for current_tag in current_tags
              assign current_down = current_tag | downcase
              if current_down == tag_down
                assign tag_active = true
              endif
            endfor
          -%}
          <a href="{{ blog.url }}/tagged/{{ tag_label | handleize }}" class="blog-page__tab{% if tag_active %} is-active{% endif %}"{% if tag_active %} aria-current="page"{% endif %}>{{ tag_label }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {% paginate blog.articles by articles_per_page %}
      <div class="blog-page__grid" data-stories-grid>
        {%- if blog.articles.size == 0 -%}
          <p class="blog-page__empty">No stories in this series yet.</p>
        {%- endif -%}
        {% for article in blog.articles %}
          {%- liquid
            assign excerpt_source = article.excerpt
            if excerpt_source == blank
              assign excerpt_source = article.content
            endif
            assign excerpt_plain = article.excerpt | strip_html | strip
            if excerpt_plain == blank
              assign excerpt_plain = article.content | strip_html | strip | split: '.' | first | append: '.'
            endif
          -%}
          <article class="blog-page__card{% if forloop.first and paginate.current_page == 1 and current_tags == blank %} blog-page__card--lead{% endif %}">
            <a href="{{ article.url }}" class="blog-page__card-link">
              {% if article.image %}
                {%- assign image_alt = article.image.alt | default: article.title -%}
                <div class="blog-page__card-image-wrapper">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'blog-page__card-image',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 900px) 33vw, 100vw',
                      alt: image_alt
                  }}
                </div>
              {% endif %}

              <div class="blog-page__card-content">
                {%- liquid
                  assign card_tag = blank
                  for t in article.tags
                    assign t_down = t | downcase
                    for filter_tag in filter_tags
                      assign filter_down = filter_tag | strip | downcase
                      if t_down == filter_down
                        assign card_tag = filter_tag | strip
                        break
                      endif
                    endfor
                    if card_tag != blank
                      break
                    endif
                  endfor
                -%}
                {%- if card_tag != blank -%}
                  <p class="blog-page__card-tag">{{ card_tag }}</p>
                {%- endif -%}
                <h2 class="blog-page__card-title">{{ article.title | escape }}</h2>

                {%- comment -%} Dates and author stay off the list. {%- endcomment -%}

                {%- if show_excerpts and excerpt_plain != blank -%}
                  <p class="blog-page__card-excerpt">{{ excerpt_plain | escape }}</p>
                {%- endif -%}
              </div>
            </a>
          </article>
        {% endfor %}
      </div>

      {%- if paginate.next -%}
        <div class="blog-page__load" data-stories-more data-next="{{ paginate.next.url }}">
          <button type="button" class="btn btn--outline" data-load-stories>Load more stories</button>
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-stories-more]');
    var grid = document.querySelector('[data-stories-grid]');
    if (!root || !grid || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    var button = root.querySelector('[data-load-stories]');
    var loading = false;
    var scrolling = false;
    var observer = null;

    function nearView() {
      var rect = root.getBoundingClientRect();
      return rect.top < window.innerHeight + 700;
    }

    function loadNext() {
      var next = root.getAttribute('data-next');
      if (!next || loading) return Promise.resolve(false);
      loading = true;
      if (button) button.disabled = true;
      var status = root.querySelector('[data-stories-status]');
      if (status) status.hidden = false;
      return fetch(next)
        .then(function (res) { return res.text(); })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var incoming = doc.querySelector('[data-stories-grid]');
          if (incoming) {
            incoming.querySelectorAll('article').forEach(function (card) {
              card.classList.remove('blog-page__card--lead');
              grid.appendChild(card);
            });
          }
          var more = doc.querySelector('[data-stories-more]');
          var nextUrl = more && more.getAttribute('data-next');
          if (nextUrl) {
            root.setAttribute('data-next', nextUrl);
            return true;
          }
          root.removeAttribute('data-next');
          if (observer) observer.disconnect();
          root.remove();
          return false;
        })
        .catch(function () {
          if (button) button.disabled = false;
          return false;
        })
        .finally(function () {
          loading = false;
          var liveStatus = root.querySelector && root.querySelector('[data-stories-status]');
          if (liveStatus) liveStatus.hidden = true;
        });
    }

    function keepFilling() {
      if (!scrolling || !root.isConnected || !root.getAttribute('data-next') || !nearView()) return;
      loadNext().then(function (more) {
        if (more) keepFilling();
      });
    }

    function armScroll() {
      scrolling = true;
      if (button) button.remove();
      button = null;
      if (!root.querySelector('[data-stories-status]')) {
        var status = document.createElement('p');
        status.className = 'blog-page__status';
        status.setAttribute('data-stories-status', '');
        status.setAttribute('aria-live', 'polite');
        status.hidden = true;
        status.textContent = 'Loading stories';
        root.appendChild(status);
      }
      var sentinel = document.createElement('div');
      sentinel.className = 'blog-page__sentinel';
      sentinel.setAttribute('aria-hidden', 'true');
      root.appendChild(sentinel);
      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(function (entries) {
          if (entries.some(function (entry) { return entry.isIntersecting; })) keepFilling();
        }, { rootMargin: '700px 0px' });
        observer.observe(sentinel);
      } else {
        window.addEventListener('scroll', keepFilling, { passive: true });
      }
      keepFilling();
    }

    if (button) {
      button.addEventListener('click', function () {
        loadNext().then(function (more) {
          if (more) armScroll();
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 9,
      "label": "Articles per page"
    },
    {
      "type": "text",
      "id": "filter_tags",
      "label": "Category tabs (article tags)",
      "info": "Comma-separated tags exactly as used on articles, e.g. Rituals,Our Women. Leave blank to hide the tabs."
    },
    {
      "type": "checkbox",
      "id": "show_excerpts",
      "label": "Show article excerpts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dates",
      "label": "Show publication dates",
      "default": true
    }
  ]
}
{% endschema %}
