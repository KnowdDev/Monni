{% comment %}
  Blog Page — Monni Theme
  Editorial journal listing. Excerpt HTML from the admin is stripped so
  rich-text font sizes/styles can never break card cohesion.
{% endcomment %}

{%- liquid
  assign articles_per_page = section.settings.articles_per_page | default: 9
  assign show_excerpts = section.settings.show_excerpts
  assign show_dates = section.settings.show_dates
  assign filter_tags = section.settings.filter_tags | split: ','
  assign is_journal = false
  if blog.handle == 'journal'
    assign is_journal = true
    assign show_dates = false
  endif
-%}

<section class="blog-page full-width">
  <div class="container">
    <header class="blog-page__header">
      {%- if blog.handle == 'journal' -%}
        <h1 class="blog-page__title">Stories &amp; Rituals</h1>
        <p class="blog-page__intro">Pour a cup and stay a while. Stories from our makers, seasonal rituals and gentle reflections on living well.</p>
      {%- else -%}
        <h1 class="blog-page__title">{{ blog.title }}</h1>
      {%- endif -%}
    </header>

    {%- if filter_tags.size > 0 -%}
      <nav class="blog-page__tabs" aria-label="Filter stories">
        <a href="{{ blog.url }}" class="blog-page__tab{% unless current_tags %} is-active{% endunless %}"{% unless current_tags %} aria-current="page"{% endunless %}>All</a>
        {%- for tag in filter_tags -%}
          {%- liquid
            assign tag_active = false
            if current_tags contains tag
              assign tag_active = true
            endif
          -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog-page__tab{% if tag_active %} is-active{% endif %}"{% if tag_active %} aria-current="page"{% endif %}>{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="blog-page__grid">
      {% paginate blog.articles by articles_per_page %}
        {% for article in blog.articles %}
          {%- liquid
            assign excerpt_source = article.excerpt
            if excerpt_source == blank
              assign excerpt_source = article.content
            endif
            assign excerpt_plain = excerpt_source | strip_html | strip | truncatewords: 24, '…'
          -%}
          <article class="blog-page__card{% if forloop.first and paginate.current_page == 1 and current_tags == blank %} blog-page__card--lead{% endif %}">
            <a href="{{ article.url }}" class="blog-page__card-link">
              {% if article.image %}
                {%- assign image_alt = article.image.alt | default: article.title -%}
                <div class="blog-page__card-image-wrapper">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'blog-page__card-image',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 900px) 33vw, 100vw',
                      alt: image_alt
                  }}
                </div>
              {% endif %}

              <div class="blog-page__card-content">
                {%- liquid
                  assign card_tag = blank
                  for t in article.tags
                    if filter_tags contains t
                      assign card_tag = t
                      break
                    endif
                  endfor
                -%}
                {%- if card_tag != blank -%}
                  <p class="blog-page__card-tag">{{ card_tag }}</p>
                {%- endif -%}
                <h2 class="blog-page__card-title">{{ article.title | escape }}</h2>

                {%- if show_dates -%}
                  <div class="blog-page__card-meta">
                    {% assign date = article.published_at | time_tag: format: 'date' %}
                    <span class="blog-page__card-meta-item">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</span>
                  </div>
                {%- endif -%}

                {%- if show_excerpts and excerpt_plain != blank -%}
                  <p class="blog-page__card-excerpt">{{ excerpt_plain | escape }}</p>
                {%- endif -%}
              </div>
            </a>
          </article>
        {% endfor %}

        {%- if paginate.pages > 1 -%}
          <nav class="blog-page__pagination" aria-label="Journal pagination">
            {%- if paginate.previous -%}
              <a
                href="{{ paginate.previous.url }}"
                rel="prev"
                class="blog-page__pagination-link blog-page__pagination-link--prev"
                aria-label="Previous page"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                Previous
              </a>
            {%- endif -%}

            <div class="blog-page__pagination-numbers">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="blog-page__pagination-number">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="blog-page__pagination-number blog-page__pagination-number--current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="blog-page__pagination-number blog-page__pagination-number--ellipsis" aria-hidden="true">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.next -%}
              <a
                href="{{ paginate.next.url }}"
                rel="next"
                class="blog-page__pagination-link blog-page__pagination-link--next"
                aria-label="Next page"
              >
                Next
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 9,
      "label": "Articles per page"
    },
    {
      "type": "text",
      "id": "filter_tags",
      "label": "Category tabs (article tags)",
      "info": "Comma-separated tags exactly as used on articles, e.g. Rituals,Our Women. Leave blank to hide the tabs."
    },
    {
      "type": "checkbox",
      "id": "show_excerpts",
      "label": "Show article excerpts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dates",
      "label": "Show publication dates",
      "default": true
    }
  ]
}
{% endschema %}
