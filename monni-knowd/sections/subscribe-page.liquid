<section class="lt">
  <div class="lt__inner">
    {%- if section.settings.image != blank -%}
      <div class="lt__banner">
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '(min-width: 600px) 34rem, 100vw', alt: section.settings.image.alt | default: shop.name }}
      </div>
    {%- endif -%}
    {% render 'links-brand' %}
    {% render 'links-social' %}
    {%- if section.settings.eyebrow != blank -%}<p class="lt__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="lt__title lt__title--xl">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}<p class="lt__bio">{{ section.settings.intro }}</p>{%- endif -%}

    {% form 'customer', class: 'newsletter-v2__form lt__form sb__form', data-senderkit-newsletter: true %}
      {% if form.posted_successfully? %}
        <p class="lt__success">{{ section.settings.success_message }}</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter,subscribe-page">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <input type="hidden" name="contact[first_name]" value="">
        <input type="hidden" name="contact[last_name]" value="">
        <input type="text" name="sb_name" class="lt__input" placeholder="Your name" aria-label="Your name" required autocomplete="name">
        <input type="email" name="contact[email]" class="lt__input" placeholder="Your email address" aria-label="Your email address" required autocomplete="email" autocapitalize="off">
        <button type="submit" class="lt__btn lt__btn--solid"><span class="lt__btn-label">{{ section.settings.button_label }}</span></button>
        {% if form.errors %}<p class="lt__error">{{ form.errors.messages['email'] }}</p>{% endif %}
        <p class="lt__fine">{{ section.settings.fine_print }}</p>
      {% endif %}
    {% endform %}

    <ol class="lt__benefits">
      {%- for block in section.blocks -%}
        <li class="lt__benefit" {{ block.shopify_attributes }}>
          <span class="lt__num">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h2 class="lt__bt">{{ block.settings.title }}</h2>
            <p class="lt__bd">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.show_feed -%}
      {% render 'links-feed', collection: section.settings.feed_collection, limit: section.settings.feed_limit, heading: section.settings.feed_heading %}
    {%- endif -%}

    <p class="lt__foot"><a href="{{ routes.root_url }}">teaandtonic.co.nz</a></p>
  </div>
</section>

<script>
  (function () {
    var form = document.querySelector('.sb__form');
    if (!form) return;
    function split() {
      var n = (form.elements['sb_name'].value || '').trim().replace(/\s+/g, ' ');
      var i = n.indexOf(' ');
      form.elements['contact[first_name]'].value = i === -1 ? n : n.slice(0, i);
      form.elements['contact[last_name]'].value = i === -1 ? '' : n.slice(i + 1);
    }
    form.addEventListener('input', split);
    form.addEventListener('submit', split, true);
  })();
</script>

{% schema %}
{
  "name": "Newsletter subscribe page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Tea & Tonic Journal Letter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be the first to know." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Join the Tea & Tonic newsletter for early access to new releases, first looks at new products and subscriber-only giveaways." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "No spam. Unsubscribe anytime." },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you, you're on the list. Keep an eye on your inbox." },
    { "type": "header", "content": "Product feed" },
    { "type": "checkbox", "id": "show_feed", "label": "Show product feed", "default": true },
    { "type": "text", "id": "feed_heading", "label": "Feed heading", "default": "New in store" },
    { "type": "collection", "id": "feed_collection", "label": "Feed collection" },
    { "type": "range", "id": "feed_limit", "label": "Tiles", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Newsletter subscribe page" }]
}
{% endschema %}
