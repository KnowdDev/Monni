<section class="lt">
  <div class="lt__inner">
    {%- if section.settings.image != blank -%}
      <div class="lt__banner">
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '(min-width: 600px) 30rem, 100vw', alt: section.settings.image.alt | default: shop.name }}
      </div>
    {%- endif -%}
    {% render 'links-brand' %}
    <h1 class="lt__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}<p class="lt__bio">{{ section.settings.intro }}</p>{%- endif -%}
    {%- if section.settings.perk != blank -%}<p class="lt__perk">{{ section.settings.perk }}</p>{%- endif -%}

    {% form 'customer', class: 'newsletter-v2__form lt__form sb__form', data-senderkit-newsletter: true %}
      {% if form.posted_successfully? %}
        <p class="lt__success">{{ section.settings.success_message }}</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter,subscribe-page">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <input type="hidden" name="contact[first_name]" value="">
        <input type="hidden" name="contact[last_name]" value="">
        <label for="sb-name" class="visually-hidden">Your name</label>
        <input id="sb-name" type="text" name="sb_name" class="lt__input" placeholder="Your name" required autocomplete="name">
        <label for="sb-email" class="visually-hidden">Your email address</label>
        <input id="sb-email" type="email" name="contact[email]" class="lt__input" placeholder="Your email address" required autocomplete="email" autocapitalize="off">
        <button type="submit" class="lt__submit">{{ section.settings.button_label }}</button>
        {% if form.errors %}<p class="lt__error">{{ form.errors.messages['email'] }}</p>{% endif %}
      {% endif %}
    {% endform %}
    {%- if section.settings.fine_print != blank -%}<p class="lt__fine">{{ section.settings.fine_print }}</p>{%- endif -%}

    <div class="lt__rule"></div>
    <ol class="lt__benefits">
      {%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
      {%- for block in benefits -%}
        <li class="lt__benefit" {{ block.shopify_attributes }}>
          <span class="lt__num">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h2 class="lt__bt">{{ block.settings.title }}</h2>
            <p class="lt__bd">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.show_feed -%}
      {% render 'links-feed', section: section, collection: section.settings.feed_collection, limit: section.settings.feed_limit, heading: section.settings.feed_heading %}
    {%- endif -%}

    <div class="lt__follow">
      <span class="lt__follow-label">Follow along</span>
      <div class="lt__links">
        <a class="lt__link" href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/teaandtonicmatakana/' }}" target="_blank" rel="noopener">Instagram</a>
        <a class="lt__link" href="{{ settings.social_facebook_link | default: 'https://www.facebook.com/teaandtonicmatakana' }}" target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.querySelector('.sb__form');
    if (!form) return;
    function split() {
      var n = (form.elements['sb_name'].value || '').trim().replace(/\s+/g, ' ');
      var i = n.indexOf(' ');
      form.elements['contact[first_name]'].value = i === -1 ? n : n.slice(0, i);
      form.elements['contact[last_name]'].value = i === -1 ? '' : n.slice(i + 1);
    }
    form.addEventListener('input', split);
    form.addEventListener('submit', split, true);
  })();
</script>

{% schema %}
{
  "name": "Newsletter subscribe page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be the first to know." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "New arrivals before anyone else, stories from our makers, holistic health and beauty tips, and subscriber-only gifts." },
    { "type": "text", "id": "perk", "label": "Highlight line", "default": "Plus 10% off your first order" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "fine_print", "label": "Fine print (optional)" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you, you're on the list. Keep an eye on your inbox." },
    { "type": "header", "content": "Product feed" },
    { "type": "checkbox", "id": "show_feed", "label": "Show product feed", "default": false },
    { "type": "text", "id": "feed_heading", "label": "Feed heading", "default": "New in store" },
    { "type": "collection", "id": "feed_collection", "label": "Fallback collection", "info": "Used only when no Feed product blocks are added." },
    { "type": "range", "id": "feed_limit", "label": "Tiles (collection fallback)", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Feed product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Adds a photo tile that links to this product. If you add any, they replace the collection fallback." }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Newsletter subscribe page" }]
}
{% endschema %}
