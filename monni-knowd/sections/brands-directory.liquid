{%- liquid
  assign brands = shop.metaobjects.brand.values | sort: 'name'
  assign show_unpublished = section.settings.show_unpublished
-%}

<section class="brands-directory section--padding full-width" data-section-id="{{ section.id }}" data-brands-dir-v="8">
  <div class="brands-directory__inner">
    <header class="brands-directory__header">
      <h1 class="brands-directory__title">Our Brands</h1>
      <p class="brands-directory__intro">Behind every brand is a maker who creates with heart, cares for the earth and works with intention.</p>
    </header>

    {%- assign visible_count = 0 -%}
    {%- for brand in brands -%}
      {%- assign brand_handle = brand.system.handle | default: brand.handle -%}
      {%- assign brand_prefix = brand_handle | slice: 0, 6 -%}
      {%- if brand_prefix == 'brand-' -%}{%- continue -%}{%- endif -%}
      {%- comment -%} Explicit == false: Liquid | default treats boolean false as empty. {%- endcomment -%}
      {%- assign is_published = true -%}
      {%- if brand.published.value == false -%}
        {%- assign is_published = false -%}
      {%- endif -%}
      {%- if is_published or show_unpublished -%}
        {%- assign visible_count = visible_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if visible_count > 0 -%}
      <div class="brands-directory__toolbar">
        <label class="brands-directory__search">
          <span class="visually-hidden">Search brands</span>
          <input
            type="search"
            class="brands-directory__search-input"
            placeholder="{{ section.settings.search_placeholder }}"
            data-brand-search
            autocomplete="off"
          >
        </label>
        <nav class="brands-directory__alpha" aria-label="Browse brands by letter" data-brand-alpha>
          <button type="button" class="brands-directory__alpha-btn is-active" data-letter="all">All</button>
          {%- assign letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' | split: '' -%}
          {%- for letter in letters -%}
            <button type="button" class="brands-directory__alpha-btn" data-letter="{{ letter }}">{{ letter }}</button>
          {%- endfor -%}
        </nav>
      </div>

      <div class="brands-directory__grid" data-brand-grid>
        {%- for brand in brands -%}
          {%- liquid
            assign is_published = true
            if brand.published.value == false
              assign is_published = false
            endif
            unless is_published or show_unpublished
              continue
            endunless

            assign brand_handle = brand.system.handle | default: brand.handle
            assign brand_prefix = brand_handle | slice: 0, 6
            if brand_prefix == 'brand-'
              continue
            endif

            assign brand_name = brand.name.value | default: brand.name | replace: 'Monni Tea', 'MONNI Tea' | replace: 'Monni Botanicals', 'MONNI Botanicals' | replace: 'Monni Label', 'MONNI Label' | replace: 'Monni Art', 'MONNI Art'
            assign brand_url = brand.system.url | default: brand.url
            assign tagline = brand.tagline.value | default: brand.tagline | replace: 'Monni Tea', 'MONNI Tea' | replace: 'Monni Botanicals', 'MONNI Botanicals' | replace: 'Monni Label', 'MONNI Label' | replace: 'Monni Art', 'MONNI Art'
            assign collection_handle = brand.collection_handle.value | default: brand.collection_handle
            assign shop_collection = collections[collection_handle]
            assign first_letter = brand_name | strip | slice: 0 | upcase
            assign hero = brand.hero_image.value | default: brand.hero_image
          -%}
          <article
            class="brands-directory__card"
            data-brand-card
            data-name="{{ brand_name | downcase | escape }}"
            data-letter="{{ first_letter }}"
          >
            <a href="{{ brand_url }}" class="brands-directory__card-link">
              <div class="brands-directory__media">
                {%- if hero != blank -%}
                  {{
                    hero
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 900px) 25vw, 50vw',
                      alt: brand_name,
                      class: 'brands-directory__image'
                  }}
                {%- elsif shop_collection != blank and shop_collection.image != blank -%}
                  {{
                    shop_collection.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 900px) 25vw, 50vw',
                      alt: brand_name,
                      class: 'brands-directory__image'
                  }}
                {%- else -%}
                  <div class="brands-directory__placeholder" aria-hidden="true">
                    <span class="visually-hidden">{{ brand_name }}</span>
                  </div>
                {%- endif -%}
              </div>
              <div class="brands-directory__copy">
                <h2 class="brands-directory__name">{{ brand_name }}</h2>
                {%- if tagline != blank -%}
                  <p class="brands-directory__tagline">{{ tagline | escape }}</p>
                {%- endif -%}
                <span class="brands-directory__cta">{{ section.settings.card_cta }}</span>
              </div>
            </a>
          </article>
        {%- endfor -%}
      </div>

      <p class="brands-directory__empty-filter" data-brand-empty hidden>
        {{ section.settings.no_results_message }}
      </p>
    {%- else -%}
      <p class="brands-directory__empty">{{ section.settings.empty_message }}</p>
    {%- endif -%}
  </div>
  <p class="brands-directory__invite">Are you a woman-founded maker? We'd love to hear from you. <a href="mailto:hello@teaandtonic.co.nz">Get in touch</a></p>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;

    const grid = root.querySelector('.brands-directory__grid');
    const cards = [...root.querySelectorAll('[data-brand-card]')];
    cards.sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || '', undefined, { sensitivity: 'base' }));
    if (grid) cards.forEach((card) => grid.appendChild(card));
    const search = root.querySelector('[data-brand-search]');
    const alpha = root.querySelector('[data-brand-alpha]');
    const empty = root.querySelector('[data-brand-empty]');
    let activeLetter = 'all';

    const applyFilters = () => {
      const query = (search?.value || '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const name = card.dataset.name || '';
        const letter = card.dataset.letter || '';
        const matchesQuery = !query || name.includes(query);
        const matchesLetter = activeLetter === 'all' || letter === activeLetter;
        const show = matchesQuery && matchesLetter;
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (empty) empty.hidden = visible > 0;
    };

    search?.addEventListener('input', applyFilters);

    const lettersInUse = new Set(cards.map((card) => card.dataset.letter));
    alpha?.querySelectorAll('[data-letter]').forEach((button) => {
      const letter = button.dataset.letter;
      if (letter !== 'all' && !lettersInUse.has(letter)) {
        button.disabled = true;
        button.setAttribute('aria-disabled', 'true');
      }
    });

    alpha?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-letter]');
      if (!button || button.disabled) return;
      activeLetter = button.dataset.letter;
      alpha.querySelectorAll('[data-letter]').forEach((el) => el.classList.toggle('is-active', el === button));
      applyFilters();
    });
  })();
</script>

{% stylesheet %}
  .brands-directory {
    background: var(--color-background);
    color: #2f2f2f;
    padding-top: clamp(3.5rem, 8vw, 6rem);
  }

  .brands-directory__inner {
    max-width: 105rem;
    margin: 0 auto;
    padding-inline: clamp(1.25rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .brands-directory__header {
    text-align: center;
    max-width: 38rem;
    margin: 0 auto clamp(1.75rem, 4vw, 2.75rem);
  }

  .brands-directory__eyebrow {
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    color: #6b6965;
  }

  .brands-directory .brands-directory__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .brands-directory__intro {
    max-width: 24rem;
    margin: 0 auto;
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    font-weight: 300;
    color: #6b6965;
    line-height: 1.7;
  }

  .brands-directory__intro p { margin: 0; }

  .brands-directory__toolbar {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
  }

  .brands-directory__search { display: block; }

  .brands-directory__search-input {
    width: 100%;
    box-sizing: border-box;
    height: 2.75rem;
    padding: 0 0.85rem;
    border: 1px solid #2f2f2f;
    border-radius: 0;
    background: transparent;
    color: #2f2f2f;
    font-family: var(--font-body--family);
    font-size: 16px;
    letter-spacing: 0.04em;
    -webkit-appearance: none;
    appearance: none;
  }

  .brands-directory__search-input::placeholder {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6965;
  }

  .brands-directory__search-input:focus-visible {
    outline: 2px solid #2f2f2f;
    outline-offset: 2px;
  }

  .brands-directory__alpha {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.15rem 0;
    justify-items: center;
  }

  .brands-directory__alpha-btn {
    min-width: 2.5rem;
    min-height: 2.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #2f2f2f;
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .brands-directory__alpha-btn.is-active,
  .brands-directory__alpha-btn:hover:not(:disabled) {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .brands-directory__alpha-btn:disabled {
    color: #b9b6b0;
    cursor: default;
  }

  @media (min-width: 768px) {
    .brands-directory__alpha {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
    .brands-directory__alpha-btn { min-width: 2rem; }
  }

  .brands-directory__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem) 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 768px) {
    .brands-directory__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }

  @media (min-width: 1100px) {
    .brands-directory__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 1.25rem;
    }
  }

  .brands-directory__card[hidden] { display: none; }

  .brands-directory__card-link {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    color: inherit;
    text-decoration: none;
  }

  .brands-directory__media {
    overflow: hidden;
    background: #ede8df;
    aspect-ratio: 1 / 1;
  }

  .brands-directory__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .brands-directory__card:hover .brands-directory__image {
    transform: scale(1.03);
  }

  .brands-directory__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--font-heading--family);
    font-size: 2.25rem;
    color: #6b6965;
    background: linear-gradient(135deg, #ede8df, #dcd6c9);
  }

  .brands-directory .brands-directory__name {
    margin: 0 0 0.3rem;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .brands-directory__tagline {
    margin: 0;
    font-weight: 300;
    color: #6b6965;
    line-height: 1.55;
    font-size: 0.8rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .brands-directory__cta { display: none; }

  .brands-directory__empty,
  .brands-directory__empty-filter {
    text-align: center;
    color: #6b6965;
    padding: 3rem 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brands directory",
  "tag": "section",
  "class": "section-brands-directory",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by Brand"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Makers"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Behind every piece is a maker who creates with heart, cares for the earth and makes with intention.</p>"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search brands"
    },
    {
      "type": "text",
      "id": "card_cta",
      "label": "Card link label",
      "default": "Discover the brand"
    },
    {
      "type": "text",
      "id": "no_results_message",
      "label": "No results message",
      "default": "No brands match your search."
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "Brand profiles will appear here once added in Shopify."
    },
    {
      "type": "checkbox",
      "id": "show_unpublished",
      "label": "Show unpublished brands (preview)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Brands directory"
    }
  ]
}
{% endschema %}
