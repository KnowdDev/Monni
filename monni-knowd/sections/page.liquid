{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page section--padding" data-section-id="{{ section.id }}">
  <div class="page__inner container">
    <header class="page__header">
      <h1 class="page__title">{{ page.title }}</h1>
      {% if section.settings.show_breadcrumb %}
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol class="breadcrumb__list">
            <li class="breadcrumb__item">
              <a href="{{ routes.root_url }}" class="breadcrumb__link">{{ 'general.breadcrumbs.home' | t }}</a>
            </li>
            <li class="breadcrumb__item" aria-current="page">
              <span class="breadcrumb__link breadcrumb__link--current">{{ page.title }}</span>
            </li>
          </ol>
        </nav>
      {% endif %}
    </header>

    <div class="page__content page__content--{{ section.settings.content_width }}">
      <div class="page__body rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .page {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .page__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .page__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .page__title {
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    margin: 0 0 var(--spacing-lg);
  }

  @media (min-width: 768px) {
    .page__title {
      font-size: 3rem;
    }
  }

  .breadcrumb {
    margin-top: var(--spacing-md);
  }

  .breadcrumb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.875rem;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    color: var(--color-foreground-muted);
  }

  .breadcrumb__link {
    color: var(--color-foreground-light);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb__link:hover,
  .breadcrumb__link:focus {
    color: var(--color-foreground);
    outline: none;
  }

  .breadcrumb__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .breadcrumb__link--current {
    color: var(--color-foreground);
  }

  .page__content {
    max-width: 680px;
    margin: 0 auto;
  }

  .page__content--narrow {
    max-width: 560px;
  }

  .page__content--medium {
    max-width: 680px;
  }

  .page__content--wide {
    max-width: 960px;
  }

  .page__body {
    font-size: 1rem;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
  }

  .page__body h2 {
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    margin: var(--spacing-xl) 0 var(--spacing-md);
  }

  .page__body h3 {
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    margin: var(--spacing-lg) 0 var(--spacing-sm);
  }

  .page__body p {
    margin: 0 0 var(--spacing-md);
  }

  .page__body a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .page__body a:hover,
  .page__body a:focus {
    color: var(--color-foreground);
    outline: none;
  }

  .page__body a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .page__body ul,
  .page__body ol {
    margin: 0 0 var(--spacing-md);
    padding-left: var(--spacing-lg);
  }

  .page__body li {
    margin-bottom: var(--spacing-xs);
  }

  .page__body blockquote {
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-md) var(--spacing-lg);
    border-left: 2px solid var(--color-accent);
    background-color: var(--color-border);
    font-style: italic;
    color: var(--color-foreground-muted);
  }

  .page__body img {
    max-width: 100%;
    height: auto;
    margin: var(--spacing-lg) 0;
    border-radius: var(--style-border-radius-inputs);
  }

  @media (prefers-reduced-motion: no-preference) {
    .breadcrumb__link,
    .page__body a {
      transition: color var(--transition-fast);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "tag": "section",
  "class": "section-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Padding bottom"
    }
  ],
  "presets": [
    {
      "name": "t:general.page"
    }
  ]
}
{% endschema %}
