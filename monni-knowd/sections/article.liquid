{% comment %}
  Article Page — Monni Theme
  Editorial blog content with brand-aligned typography and spacing.
{% endcomment %}

<article class="article-page">
  <div class="article-page__column">
    <header class="article-page__header">
      {%- liquid
        assign series = blank
        assign series_names = 'Our Women|Rituals|From Monni|Focus' | split: '|'
        for series_name in series_names
          assign series_down = series_name | downcase
          for article_tag in article.tags
            assign article_tag_down = article_tag | downcase
            if article_tag_down == series_down
              assign series = series_name
              break
            endif
          endfor
          if series != blank
            break
          endif
        endfor
      -%}
      {% if series != blank %}
        <a href="{{ blog.url }}/tagged/{{ series | handleize }}" class="article-page__blog-link">{{ series }}</a>
      {% endif %}

      <h1 class="article-page__title">{{ article.title }}</h1>
      {%- liquid
        assign article_byline = 'Monni'
        if article.author == 'Amber'
          assign article_byline = article.author
        endif
      -%}
      <p class="article-page__by">By {{ article_byline }}</p>
      <time class="visually-hidden" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
    </header>

    {%- liquid
      assign story_html = article.content
      assign hero_file = ''
      if article.image
        assign hero_file = article.image.src | split: '/' | last | split: '?' | first | downcase
      endif

      assign parts = story_html | split: '<img'
      assign drop_first_image = false
      assign promoted_src = ''
      assign promoted_alt = article.title

      if parts.size > 1
        assign first_img_tag = parts[1] | split: '>' | first
        assign first_src = ''
        if first_img_tag contains 'src="'
          assign first_src = first_img_tag | split: 'src="' | last | split: '"' | first
        endif
        assign first_file = first_src | split: '/' | last | split: '?' | first | downcase

        if article.image
          if hero_file != blank and first_file == hero_file
            assign drop_first_image = true
          endif
        elsif first_src != blank
          assign drop_first_image = true
          assign promoted_src = first_src
          if first_img_tag contains 'alt="'
            assign promoted_alt = first_img_tag | split: 'alt="' | last | split: '"' | first
          endif
        endif
      endif

      if drop_first_image
        assign before = parts | first | strip
        assign after = parts[1] | split: '>' | last | strip

        assign markers = '<p|<figure|<div' | split: '|'
        for marker in markers
          assign chunks = before | split: marker
          assign last_chunk = chunks | last
          assign after_gt = last_chunk | split: '>' | last | strip
          if chunks.size > 1 and after_gt == blank
            assign before_new = ''
            assign ci = 0
            assign csize = chunks.size
            for chunk in chunks
              assign ci = ci | plus: 1
              if ci < csize
                if ci > 1
                  assign before_new = before_new | append: marker
                endif
                assign before_new = before_new | append: chunk
              endif
            endfor
            assign before = before_new | strip
            break
          endif
        endfor

        assign closers = '</p>|</figure>|</div>' | split: '|'
        for closer in closers
          assign clen = closer | size
          assign head = after | slice: 0, clen
          if head == closer
            assign after = after | remove_first: closer | strip
            break
          endif
        endfor

        assign credit_probe = after | strip
        assign credit_down = credit_probe | split: '</p>' | first | strip_html | strip | downcase
        if credit_down contains 'photo credit'
          assign after_new = ''
          assign ai = 0
          assign credit_parts = credit_probe | split: '</p>'
          for ap in credit_parts
            assign ai = ai | plus: 1
            if ai > 1
              if ai > 2
                assign after_new = after_new | append: '</p>'
              endif
              assign after_new = after_new | append: ap
            endif
          endfor
          assign after = after_new | strip
        endif

        assign story_html = before | append: after
        assign pi = 0
        for part in parts
          assign pi = pi | plus: 1
          if pi > 2
            assign story_html = story_html | append: '<img' | append: part
          endif
        endfor
      endif
    -%}

    {%- if article.image -%}
      <figure class="article-page__featured">
        <div class="article-page__featured-media">
          {{
            article.image
            | image_url: width: 1600
            | image_tag:
              class: 'article-page__featured-image',
              loading: 'eager',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 740px) 42rem, calc(100vw - 2rem)',
              alt: article.image.alt | default: article.title
          }}
        </div>
      </figure>
    {%- elsif promoted_src != blank -%}
      <figure class="article-page__featured">
        <div class="article-page__featured-media">
          <img
            src="{{ promoted_src | escape }}"
            alt="{{ promoted_alt | escape }}"
            class="article-page__featured-image"
            loading="eager"
            width="1600"
            height="1067"
          >
        </div>
      </figure>
    {%- endif -%}

    <div class="article-page__content rte">
      {{ story_html }}
    </div>

    {%- liquid
      assign story_products = article.metafields.custom.shop_products.value
      assign brand_url = article.metafields.custom.brand_url.value | default: article.metafields.custom.brand_url
      assign brand_name = article.metafields.custom.brand_name.value | default: article.metafields.custom.brand_name
    -%}
    {% if brand_url != blank %}
      <p class="article-page__shop-brand"><a class="btn btn--outline" href="{{ brand_url }}">Shop {{ brand_name | default: 'the maker' }}</a></p>
    {% endif %}
    {% if story_products != blank %}
      <section class="article-page__shop">
        <h2>Shop the story</h2>
        <div class="article-page__shop-grid">
          {% for story_product in story_products limit: 2 %}
            {% render 'card-product', card_product: story_product, show_quick_add: false, show_wishlist: false, show_badges: false %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <section class="article-page__more">
      <div class="article-page__more-head">
        <h2>More from the Journal</h2>
        <a href="{{ blog.url }}">All stories</a>
      </div>
      <div class="article-page__more-grid">
        {%- assign more_count = 0 -%}
        {%- for related in blog.articles -%}
          {%- if related.id != article.id and more_count < 2 -%}
            {%- liquid
              assign more_series = blank
              assign more_series_names = 'Our Women|Rituals|From Monni|Focus' | split: '|'
              for more_series_name in more_series_names
                assign more_series_down = more_series_name | downcase
                for more_tag in related.tags
                  assign more_tag_down = more_tag | downcase
                  if more_tag_down == more_series_down
                    assign more_series = more_series_name
                    break
                  endif
                endfor
                if more_series != blank
                  break
                endif
              endfor
              assign more_excerpt = related.excerpt | strip_html | strip
              if more_excerpt == blank
                assign more_excerpt = related.content | strip_html | strip | truncate: 120
              endif
            -%}
            <a class="article-page__more-card" href="{{ related.url }}">
              {%- if related.image -%}
                {%- assign more_alt = related.image.alt | default: related.title -%}
                <div class="article-page__more-media">
                  {{
                    related.image
                    | image_url: width: 720
                    | image_tag:
                      loading: 'lazy',
                      widths: '280, 420, 720',
                      sizes: '(min-width: 700px) 22rem, 7.5rem',
                      alt: more_alt,
                      class: 'article-page__more-image'
                  }}
                </div>
              {%- endif -%}
              <div class="article-page__more-copy">
                {%- if more_series != blank -%}
                  <p class="article-page__more-kicker">{{ more_series }}</p>
                {%- endif -%}
                <h3>{{ related.title | escape }}</h3>
                {%- if more_excerpt != blank -%}
                  <p class="article-page__more-excerpt">{{ more_excerpt | escape }}</p>
                {%- endif -%}
              </div>
            </a>
            {%- assign more_count = more_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>

    {% if false and blog.comments_enabled? %}
        <section class="article-page__comments" id="comments">
          <h2 class="article-page__comments-title">{{ 'blog.article_comments' | t }}</h2>

          <div class="article-page__comments-list">
            {% paginate article.comments by 10 %}
              {% for comment in article.comments %}
                <div class="article-page__comment">
                  <div class="article-page__comment-header">
                    <span class="article-page__comment-author">{{ comment.author }}</span>
                    <span class="article-page__comment-date">{{ comment.created_at | time_tag: format: 'date' }}</span>
                  </div>
                  <div class="article-page__comment-body">{{ comment.content }}</div>
                </div>
              {% endfor %}

              {% if paginate.pages > 1 %}
                <div class="article-page__pagination">
                  {{ paginate | default_pagination }}
                </div>
              {% endif %}
            {% endpaginate %}
          </div>

          <div class="article-page__comment-form">
            <h3 class="article-page__comment-form-title">{{ 'blog.comment_form_title' | t }}</h3>

            {% form 'new_comment', article %}
              {{ form.errors | default_errors }}

              <div class="article-page__form-field">
                <label for="CommentAuthor" class="article-page__form-label">{{ 'blog.comment_form_name' | t }}</label>
                <input type="text" name="comment[author]" id="CommentAuthor" class="article-page__form-input" value="{{ form.author }}" required>
              </div>

              <div class="article-page__form-field">
                <label for="CommentEmail" class="article-page__form-label">{{ 'blog.comment_form_email' | t }}</label>
                <input type="email" name="comment[email]" id="CommentEmail" class="article-page__form-input" value="{{ form.email }}" required>
              </div>

              <div class="article-page__form-field">
                <label for="CommentBody" class="article-page__form-label">{{ 'blog.comment_form_body' | t }}</label>
                <textarea name="comment[body]" id="CommentBody" class="article-page__form-textarea" rows="5" required>{{ form.body }}</textarea>
              </div>

              <button type="submit" class="btn btn--primary">{{ 'blog.comment_form_submit' | t }}</button>
            {% endform %}
          </div>
        </section>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .article-page__more {
    margin-top: clamp(2.75rem, 6vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid #e4e0d8;
  }

  .article-page__more-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .article-page__more-head h2 {
    margin: 0;
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .article-page__more-head a {
    flex: none;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #6b6965;
  }

  .article-page__more-head a:hover { color: #2f2f2f; }

  .article-page__more-grid { display: grid; gap: 1.25rem; }

  .article-page__more-card {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .article-page__more-media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #eceae4;
  }

  .article-page__more-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .article-page__more-kicker {
    margin: 0 0 0.3rem;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6b6965;
  }

  .article-page__more-copy h3 {
    margin: 0;
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.3;
    text-wrap: balance;
  }

  .article-page__more-excerpt {
    margin: 0.4rem 0 0;
    font-size: 0.84rem;
    font-weight: 300;
    line-height: 1.45;
    color: #2f2f2f;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-page__more-card:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  @media (min-width: 720px) {
    .article-page__more-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 1.25rem;
    }

    .article-page__more-card {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.7rem;
    }

    .article-page__more-media { aspect-ratio: 3 / 2; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show featured image",
      "default": true
    }
  ]
}
{% endschema %}
