<section class="category-grid full-width" data-section-id="{{ section.id }}">
  <div class="category-grid__inner">
    {% if section.settings.title != blank %}
      <h2 class="category-grid__title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="category-grid__grid">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="category-grid__item"
          {{ block.shopify_attributes }}
        >
          <div class="category-grid__image-wrap">
            {% if block.settings.image %}
              {% render 'responsive-img',
                image: block.settings.image,
                alt: block.settings.title,
                class: 'category-grid__image',
                sizes: '(max-width: 767px) 45vw, (max-width: 1023px) 50vw, 33vw',
                widths: '180,240,320',
                default_width: 240,
                width: 600,
                height: 750,
                loading: 'lazy'
              %}
            {% else %}
              {% assign unsplash_ids = "photo-1556228578-0d85b1a4d571,photo-1571781926291-c477ebfd024b,photo-1516762689617-e1cffcef479d,photo-1611591437281-460bfbe1220a,photo-1586023492125-27b2c045efd7,photo-1549465220-1a8b9238cd48" | split: "," %}
              <img
                src="https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=600&h=750&fit=crop&q=80"
                srcset="
                  https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=300&h=375&fit=crop&q=80 300w,
                  https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=600&h=750&fit=crop&q=80 600w,
                  https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=900&h=1125&fit=crop&q=80 900w
                "
                sizes="(max-width: 1023px) 50vw, 33vw"
                alt="{{ block.settings.title | escape }}"
                loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}"
                width="600"
                height="750"
                class="category-grid__image"
              >
            {% endif %}
          </div>
          <div class="category-grid__text">
            <h3 class="category-grid__label">{{ block.settings.title | escape }}</h3>
            {% if block.settings.description != blank %}
              <p class="category-grid__desc">{{ block.settings.description | escape }}</p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .category-grid {
    background-color: var(--color-background);
    padding: clamp(2.5rem, 8vw, 4rem) 0;
  }

  @media (min-width: 1024px) {
    .category-grid {
      padding: clamp(4rem, 10vw, 7rem) 0;
    }
  }

  .category-grid__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .category-grid__title {
    font-family: var(--font-heading--family);
    font-size: clamp(0.875rem, 1.25vw, 1rem);
    font-weight: 400;
    text-align: center;
    color: var(--color-foreground);
    margin: 0 0 clamp(1.75rem, 5vw, 2.5rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .category-grid__title {
      margin-bottom: clamp(3rem, 6vw, 5rem);
    }
  }

  .category-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(0.65rem, 2.5vw, 1rem);
    row-gap: clamp(1.25rem, 4vw, 1.75rem);
  }

  @media (min-width: 1024px) {
    .category-grid__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 1.5rem);
      row-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  .category-grid__item {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .category-grid__item:hover {
    transform: translateY(-4px);
  }

  .category-grid__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
    background-color: var(--color-border-light);
  }

  .category-grid__image,
  .category-grid__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .category-grid__item:hover .category-grid__image {
    transform: scale(1.04);
  }

  .category-grid__fallback {
    background: linear-gradient(135deg, var(--color-accent-light), var(--color-border-light));
  }

  .category-grid__text {
    padding-top: 0.75rem;
    text-align: left;
  }

  .category-grid__label {
    font-family: var(--font-heading--family);
    font-size: clamp(0.8125rem, 2.8vw, 0.9375rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0 0 0.35rem;
  }

  .category-grid__desc {
    font-family: var(--font-body--family);
    font-size: clamp(0.8125rem, 2.6vw, 0.9375rem);
    font-weight: 200;
    color: var(--color-foreground-light);
    margin: 0;
    line-height: 1.55;
    letter-spacing: 0.02em;
    max-width: none;
  }

  @media (min-width: 1024px) {
    .category-grid__text {
      padding-top: 1.1rem;
      text-align: center;
    }

    .category-grid__label {
      letter-spacing: 0.18em;
      margin-bottom: 0.4rem;
    }

    .category-grid__desc {
      line-height: 1.65;
      max-width: 28ch;
      margin-inline: auto;
    }
  }
{% endstyle %}

{% schema %}
