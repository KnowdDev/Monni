<section class="category-grid full-width" data-section-id="{{ section.id }}">
  <div class="category-grid__inner">
    {% if section.settings.title != blank %}
      <h2 class="category-grid__title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="category-grid__grid">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="category-grid__item"
          {{ block.shopify_attributes }}
        >
          <div class="category-grid__image-wrap">
            {% if block.settings.image %}
              {% render 'responsive-img',
                image: block.settings.image,
                alt: block.settings.title,
                class: 'category-grid__image',
                sizes: '(max-width: 767px) 45vw, (max-width: 1023px) 50vw, 33vw',
                widths: '200,280,360,480',
                default_width: 280,
                width: 600,
                height: 750,
                loading: 'lazy'
              %}
            {% else %}
              {% assign unsplash_ids = "photo-1556228578-0d85b1a4d571,photo-1571781926291-c477ebfd024b,photo-1516762689617-e1cffcef479d,photo-1611591437281-460bfbe1220a,photo-1586023492125-27b2c045efd7,photo-1549465220-1a8b9238cd48" | split: "," %}
              <img
                src="https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=600&h=750&fit=crop&q=80"
                srcset="
                  https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=300&h=375&fit=crop&q=80 300w,
                  https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=600&h=750&fit=crop&q=80 600w,
                  https://images.unsplash.com/{{ unsplash_ids[forloop.index0] }}?w=900&h=1125&fit=crop&q=80 900w
                "
                sizes="(max-width: 1023px) 50vw, 33vw"
                alt="{{ block.settings.title | escape }}"
                loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}"
                width="600"
                height="750"
                class="category-grid__image"
              >
            {% endif %}
          </div>
          <div class="category-grid__text">
            <h3 class="category-grid__label">{{ block.settings.title | escape }}</h3>
            {% if block.settings.description != blank %}
              <p class="category-grid__desc">{{ block.settings.description | escape }}</p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .category-grid {
    --hp-gutter: clamp(1.25rem, 4vw, 3.5rem);
    background-color: var(--color-background);
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 0;
  }

  .category-grid__inner {
    max-width: 105rem;
    margin: 0 auto;
    padding: 0 var(--hp-gutter);
  }

  .category-grid__title {
    font-family: var(--font-body--family);
    font-size: 0.76rem;
    font-weight: 400;
    text-align: left;
    color: var(--color-foreground);
    margin: 0 0 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .category-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 12px;
  }

  @media (min-width: 561px) {
    .category-grid__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px 16px;
    }
  }

  @media (min-width: 901px) {
    .category-grid__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 16px;
    }
  }

  .category-grid__item {
    display: block;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .category-grid__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-border-light);
  }

  @media (min-width: 561px) {
    .category-grid__image-wrap { aspect-ratio: 3 / 4; }
  }

  .category-grid__image,
  .category-grid__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .category-grid__item:hover .category-grid__image { transform: scale(1.04); }
  }

  .category-grid__fallback {
    background: linear-gradient(135deg, var(--color-accent-light), var(--color-border-light));
  }

  .category-grid__text {
    padding-top: 0.7rem;
    text-align: left;
  }

  .category-grid__label {
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .category-grid__desc {
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--color-foreground-light);
    margin: 0.25rem 0 0;
    line-height: 1.45;
    letter-spacing: 0;
    max-width: none;
  }

  @media (min-width: 561px) {
    .category-grid__desc { font-size: 0.82rem; }
  }
{% endstyle %}

{% schema %}
