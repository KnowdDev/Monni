{% comment %}
  Gifting service page — editorial layout aligned with brand-profile / about-monni.
{% endcomment %}

<section
  class="gifting-service"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="gifting-service__inner">
    <header class="gifting-service__header">
      {%- liquid
        assign gifting_hub = collections['all-gifting']
        if gifting_hub != blank
          assign gifting_hub_url = gifting_hub.url
        else
          assign gifting_hub_url = '/collections/all-gifting'
        endif
      -%}
      <p class="gifting-service__eyebrow">
        <a href="{{ gifting_hub_url }}">{{ section.settings.eyebrow | default: 'Gifting' | escape }}</a>
      </p>
      <h1 class="gifting-service__title">{{ page.title | escape }}</h1>
      {%- if section.settings.top_line != blank -%}
        <p class="gifting-service__topline">{{ section.settings.top_line | escape }}</p>
      {%- elsif page.handle == 'corporate-gifting' -%}
        <p class="gifting-service__topline">A gift worthy of the relationships you've built.</p>
      {%- else -%}
        <p class="gifting-service__topline">A gift that feels entirely personal.</p>
      {%- endif -%}
    </header>

    {%- if section.settings.body != blank -%}
      <div class="gifting-service__body rte">{{ section.settings.body | replace: 'homewares', 'home' | replace: 'Homewares', 'Home' | replace: 'At MONNI', 'At Tea & Tonic' }}</div>
    {%- elsif page.content != blank -%}
      <div class="gifting-service__body rte">{{ page.content | replace: 'homewares', 'home' | replace: 'Homewares', 'Home' | replace: 'At MONNI', 'At Tea & Tonic' }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'gifting-service__form' -%}
      <h2 class="gifting-service__form-title">Send an enquiry</h2>
      <label class="visually-hidden" for="GiftName-{{ section.id }}">Name</label>
      <input id="GiftName-{{ section.id }}" type="text" name="contact[name]" placeholder="NAME" required autocomplete="name">
      <label class="visually-hidden" for="GiftEmail-{{ section.id }}">Email</label>
      <input id="GiftEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="EMAIL" required autocomplete="email">
      {%- if page.handle == 'corporate-gifting' -%}
        <label class="visually-hidden" for="GiftCompany-{{ section.id }}">Company name</label>
        <input id="GiftCompany-{{ section.id }}" type="text" name="contact[Company]" placeholder="COMPANY NAME">
        <label class="visually-hidden" for="GiftCount-{{ section.id }}">Number of gifts</label>
        <input id="GiftCount-{{ section.id }}" type="text" name="contact[Number of gifts]" placeholder="NUMBER OF GIFTS">
      {%- endif -%}
      <label class="visually-hidden" for="GiftWho-{{ section.id }}">Who it's for</label>
      <input id="GiftWho-{{ section.id }}" type="text" name="contact[Who it's for]" placeholder="WHO IT'S FOR">
      <label class="visually-hidden" for="GiftBudget-{{ section.id }}">Budget</label>
      <input id="GiftBudget-{{ section.id }}" type="text" name="contact[Budget]" placeholder="BUDGET">
      <label class="visually-hidden" for="GiftDate-{{ section.id }}">Date needed</label>
      <input id="GiftDate-{{ section.id }}" type="text" name="contact[Date needed]" placeholder="DATE NEEDED">
      <label class="visually-hidden" for="GiftMessage-{{ section.id }}">Message</label>
      <textarea id="GiftMessage-{{ section.id }}" name="contact[body]" rows="4" placeholder="MESSAGE" required></textarea>
      <button type="submit" class="btn btn--outline">Send</button>
    {%- endform -%}

    {%- if section.settings.contact_email != blank or section.settings.contact_phone != blank -%}
      <div class="gifting-service__contact">
        {%- if section.settings.contact_label != blank -%}
          <p class="gifting-service__contact-label">{{ section.settings.contact_label | escape }}</p>
        {%- endif -%}
        <p class="gifting-service__contact-details">
          {%- if section.settings.contact_email != blank -%}
            <a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>
          {%- endif -%}
          {%- if section.settings.contact_email != blank and section.settings.contact_phone != blank -%}
            <span aria-hidden="true"> | </span>
          {%- endif -%}
          {%- if section.settings.contact_phone != blank -%}
            <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' | escape }}">{{ section.settings.contact_phone | escape }}</a>
          {%- endif -%}
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gifting-service {
    background: var(--color-background);
    color: var(--color-foreground);
    --gifting-inline-padding: clamp(1.25rem, 4.5vw, var(--page-margin));
  }

  .gifting-service__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding-inline: var(--gifting-inline-padding);
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .gifting-service__header {
    text-align: center;
  }

  .gifting-service__eyebrow {
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 var(--spacing-sm);
    color: var(--color-foreground-muted);
  }

  .gifting-service__eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .gifting-service__eyebrow a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gifting-service__title {
    margin: 0 auto var(--spacing-md);
    max-width: min(12.5em, 100%);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: 0.02em;
  }

  .gifting-service__topline {
    margin: 0 auto;
    max-width: 38ch;
    font-family: var(--font-heading--family);
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    font-style: italic;
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--color-foreground-light);
  }

  .gifting-service__body {
    max-width: 40rem;
    margin: 0 auto;
    color: var(--color-foreground);
    line-height: 1.75;
    letter-spacing: 0.01em;
  }

  .gifting-service__body :is(p, ul, ol) {
    margin: 0 0 var(--spacing-md);
  }

  .gifting-service__body :is(p, ul, ol):last-child {
    margin-bottom: 0;
  }

  .gifting-service__contact {
    max-width: 40rem;
    margin: clamp(1rem, 3vw, 2rem) auto 0;
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
  }

  .gifting-service__contact-label {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    margin: 0 0 var(--spacing-sm);
  }

  .gifting-service__contact-details a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .gifting-service__contact-details a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gifting service",
  "tag": "section",
  "class": "section-gifting-service",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Gifting"
    },
    {
      "type": "text",
      "id": "top_line",
      "label": "Top line"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact phone"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 48,
      "max": 160,
      "step": 4,
      "default": 120,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 48,
      "max": 160,
      "step": 4,
      "default": 120,
      "unit": "px",
      "label": "Padding bottom"
    }
  ]
}
{% endschema %}
