<section
  class="split-hero full-width"
  data-section-id="{{ section.id }}"
  data-header-photo
  data-tone="{{ section.settings.text_tone | default: 'light' }}"
>
  <a
    href="{{ section.settings.link_left | default: '/collections/clothing' }}"
    class="split-hero__panel split-hero__panel--left"
    data-bg="dark"
    data-ink-override="{{ section.settings.header_ink_left | default: 'auto' }}"
    aria-label="{{ section.settings.label_left | default: 'Clothing' | escape }} — {{ section.settings.cta_left | default: 'Explore' | escape }}"
  >
    <div class="split-hero__fallback split-hero__fallback--left"></div>
    {% if section.settings.use_optimized_assets != false %}
      {% render 'split-hero-media',
        asset_filename: 'monni-hero-left.webp',
        alt: '',
        lcp: true,
        width: 720,
        height: 899
      %}
    {% elsif section.settings.image_left %}
      {% render 'split-hero-media',
        image: section.settings.image_left,
        alt: '',
        lcp: true
      %}
    {% else %}
      <img crossorigin="anonymous"
        src="https://images.unsplash.com/photo-1556905055-8f358fab1e7d?w=800&h=1000&fit=crop&q=80"
        srcset="https://images.unsplash.com/photo-1556905055-8f358fab1e7d?w=400&h=500&fit=crop&q=80 400w, https://images.unsplash.com/photo-1556905055-8f358fab1e7d?w=800&h=1000&fit=crop&q=80 800w"
        sizes="50vw"
        alt="Clothing"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="800"
        height="1000"
        class="split-hero__image"
      >
    {% endif %}
    <div class="split-hero__overlay"></div>
    <span class="split-hero__doorway">{{ section.settings.label_left | default: 'Beauty' | escape }}</span>
  </a>

  <a
    href="{{ section.settings.link_right | default: '/collections/all-home' }}"
    class="split-hero__panel split-hero__panel--right"
    data-bg="light"
    data-ink-override="{{ section.settings.header_ink_right | default: 'auto' }}"
    aria-label="{{ section.settings.label_right | default: 'Home' | escape }} — {{ section.settings.cta_right | default: 'Explore' | escape }}"
  >
    <div class="split-hero__fallback split-hero__fallback--right"></div>
    {% if section.settings.use_optimized_assets != false %}
      {% render 'split-hero-media',
        asset_filename: 'monni-hero-right.webp',
        alt: '',
        lcp: false,
        lazy_below_mobile: true,
        width: 720,
        height: 899
      %}
    {% elsif section.settings.image_right %}
      {% render 'split-hero-media',
        image: section.settings.image_right,
        alt: '',
        lcp: false,
        lazy_below_mobile: true
      %}
    {% else %}
      <img crossorigin="anonymous"
        src="https://images.unsplash.com/photo-1616486338812-3dadae4b4f9d?w=400&h=500&fit=crop&q=80"
        srcset="https://images.unsplash.com/photo-1616486338812-3dadae4b4f9d?w=400&h=500&fit=crop&q=80 400w, https://images.unsplash.com/photo-1616486338812-3dadae4b4f9d?w=800&h=1000&fit=crop&q=80 800w"
        sizes="100vw"
        alt="Home"
        loading="lazy"
        fetchpriority="low"
        decoding="async"
        width="800"
        height="1000"
        class="split-hero__image split-hero__image--below-fold-mobile"
      >
      <img crossorigin="anonymous"
        src="https://images.unsplash.com/photo-1616486338812-3dadae4b4f9d?w=800&h=1000&fit=crop&q=80"
        srcset="https://images.unsplash.com/photo-1616486338812-3dadae4b4f9d?w=400&h=500&fit=crop&q=80 400w, https://images.unsplash.com/photo-1616486338812-3dadae4b4f9d?w=800&h=1000&fit=crop&q=80 800w"
        sizes="50vw"
        alt="Home"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        width="800"
        height="1000"
        class="split-hero__image split-hero__image--desktop-only"
      >
    {% endif %}
    <div class="split-hero__overlay"></div>
    <span class="split-hero__doorway">{{ section.settings.label_right | default: 'Jewellery' | escape }}</span>
  </a>

  <div class="split-hero__text">
    <h1 class="split-hero__title"><span>Holistic Health,</span> <span>Beauty &amp; Home</span></h1>
    <a class="split-hero__shop" href="{{ section.settings.headline_link | default: '/collections/all' }}">{{ section.settings.headline_cta | default: 'Shop the collection' | escape }}</a>
  </div>
</section>

{% style %}
  .split-hero {
    --hero-ink: #faf8f4;
    --hero-shade: 34, 30, 26;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    position: relative;
    overflow: hidden;
    min-height: 0;
    background: var(--color-background);
  }

  .split-hero[data-tone="dark"] {
    --hero-ink: #2f2f2f;
    --hero-shade: 245, 244, 241;
  }

  @media (min-width: 768px) {
    .split-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .split-hero__panel {
    position: relative;
    overflow: hidden;
    display: block;
    aspect-ratio: 1 / 1;
    min-height: 0;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 768px) {
    .split-hero__panel + .split-hero__panel { margin-left: -1px; }

    .split-hero__panel {
      aspect-ratio: auto;
      height: min(62.5vw, 880px, max(34rem, calc(100svh - 2.5rem)));
    }
  }

  .split-hero picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .split-hero picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split-hero__image,
  .split-hero__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--color-border-light, #ede8df);
  }

  .split-hero__image--desktop-only {
    display: none;
  }

  @media (min-width: 768px) {
    .split-hero__image--desktop-only {
      display: block;
    }

    .split-hero__image--below-fold-mobile {
      display: none;
    }
  }

  .split-hero__fallback {
    background:
      radial-gradient(ellipse at 30% 20%, rgba(196, 184, 168, 0.35) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 80%, rgba(217, 208, 196, 0.3) 0%, transparent 55%),
      linear-gradient(160deg, var(--color-background) 0%, var(--color-accent-light) 40%, var(--color-border-light) 100%);
  }

  .split-hero__fallback--right {
    background:
      radial-gradient(ellipse at 70% 20%, rgba(196, 184, 168, 0.3) 0%, transparent 60%),
      radial-gradient(ellipse at 30% 80%, rgba(217, 208, 196, 0.25) 0%, transparent 55%),
      linear-gradient(200deg, var(--color-border-light) 0%, var(--color-accent-light) 40%, var(--color-background) 100%);
  }

  /* Soft shade behind the floating header (top) and the headline (bottom) so the
     type reads on any photograph, without visibly darkening the picture. */
  .split-hero__overlay {
    --shade-top: linear-gradient(to bottom, rgba(var(--hero-shade), 0.42) 0, rgba(var(--hero-shade), 0) 9.5rem);
    --shade-bottom: linear-gradient(to top, rgba(var(--hero-shade), 0.5) 0, rgba(var(--hero-shade), 0) 55%);
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgba(var(--hero-shade), 0.06);
  }

  /* Phone: header floats over the first photo, headline sits on the second. */
  .split-hero__panel--left .split-hero__overlay {
    background: var(--shade-top), rgba(var(--hero-shade), 0.06);
  }

  .split-hero__panel--right .split-hero__overlay {
    background: var(--shade-bottom), rgba(var(--hero-shade), 0.06);
  }

  @media (min-width: 768px) {
    .split-hero__panel--left .split-hero__overlay {
      background: var(--shade-top), var(--shade-bottom), rgba(var(--hero-shade), 0.06);
    }

    /* Right half is a light photograph with dark header ink. A dark top shade
       would drop that ink under 4.5:1, so the top shade stays cream. */
    .split-hero__panel--right .split-hero__overlay {
      background:
        linear-gradient(to bottom, rgba(245, 244, 241, 0.5) 0, rgba(245, 244, 241, 0) 9.5rem),
        var(--shade-bottom),
        rgba(245, 244, 241, 0.05);
    }
  }

  .split-hero__doorway {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    transform: translate(-50%, -50%);
    font-family: var(--font-heading--family);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--hero-ink);
    text-shadow: 0 0 18px rgba(var(--hero-shade), 0.55);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .split-hero__doorway {
      font-size: 0.92rem;
    }
  }

  .split-hero__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    text-align: center;
    padding: 0 1.5rem 2.5rem;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .split-hero__text {
      padding-bottom: clamp(2.5rem, 5vw, 4rem);
    }
  }

  .split-hero__title {
    font-family: var(--font-heading--family);
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--hero-ink);
    text-shadow: 0 1px 24px rgba(var(--hero-shade), 0.35);
    margin: 0 auto 1.15rem;
    line-height: 1.1;
    max-width: 12ch;
  }

  .split-hero__title span { display: block; }

  @media (min-width: 768px) {
    .split-hero__title {
      font-size: clamp(1.6rem, 3.4vw, 2.4rem);
      max-width: none;
      white-space: nowrap;
    }

    .split-hero__title span { display: inline; }
  }

  .split-hero__shop {
    pointer-events: auto;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hero-ink);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .split-hero__image,
    .split-hero__fallback,
    .split-hero picture img {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Split Hero (Diptych)",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_optimized_assets",
      "label": "Use optimized WebP hero images",
      "info": "Serves pre-compressed theme assets for faster mobile load. Disable to use the images below.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left image",
      "info": "Also set Theme settings → Performance → LCP preload image to this same image for fastest mobile load."
    },
    {
      "type": "text",
      "id": "label_left",
      "label": "Left label",
      "default": "Gifting"
    },
    {
      "type": "url",
      "id": "link_left",
      "label": "Left link"
    },
    {
      "type": "textarea",
      "id": "blurb_left",
      "label": "Left blurb",
      "default": "Thoughtfully chosen pieces to make every moment feel special."
    },
    {
      "type": "text",
      "id": "cta_left",
      "label": "Left CTA",
      "default": "Explore"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right image"
    },
    {
      "type": "text",
      "id": "label_right",
      "label": "Right label",
      "default": "Homewares"
    },
    {
      "type": "url",
      "id": "link_right",
      "label": "Right link"
    },
    {
      "type": "textarea",
      "id": "blurb_right",
      "label": "Right blurb",
      "default": "Objects that bring warmth, texture, and quiet beauty into your space."
    },
    {
      "type": "text",
      "id": "cta_right",
      "label": "Right CTA",
      "default": "Explore"
    },
    {
      "type": "select",
      "id": "header_ink_left",
      "label": "Header ink on the left photo",
      "info": "Auto samples the photograph. Light ink or dark ink forces that colour for header items on this half.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "light", "label": "Light ink" },
        { "value": "dark", "label": "Dark ink" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "header_ink_right",
      "label": "Header ink on the right photo",
      "info": "Auto samples the photograph. Light ink or dark ink forces that colour for header items on this half.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "light", "label": "Light ink" },
        { "value": "dark", "label": "Dark ink" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Text over the photos",
      "info": "Light text suits dark or mid-tone photographs; choose Dark text if both hero photos are pale. Header ink is sampled from the photo unless a half is forced below.",
      "options": [
        { "value": "light", "label": "Light text" },
        { "value": "dark", "label": "Dark text" }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Holistic Health, Beauty & Home"
    },
    {
      "type": "text",
      "id": "headline_cta",
      "label": "Headline link label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "headline_link",
      "label": "Headline link"
    }
  ],
  "presets": [
    {
      "name": "Split Hero (Diptych)",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
