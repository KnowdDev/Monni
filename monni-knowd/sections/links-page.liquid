<section class="lk">
  <div class="lk__inner">
    {%- if section.settings.image != blank -%}
      <div class="lk__avatar">
        {{ section.settings.image | image_url: width: 320 | image_tag: loading: 'eager', alt: section.settings.name, width: 160, height: 160 }}
      </div>
    {%- endif -%}
    <a class="lk__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 600 | image_tag: class: 'lk__logo', width: 200, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <span class="lk__wordmark">Tea &amp; Tonic</span>
      {%- endif -%}
    </a>
    <h1 class="lk__name">{{ section.settings.name }}</h1>
    {%- if section.settings.bio != blank -%}<p class="lk__bio">{{ section.settings.bio }}</p>{%- endif -%}

    <ul class="lk__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'latest_article' -%}
          {%- assign blog_obj = blogs[block.settings.blog] -%}
          {%- assign latest = blog_obj.articles.first -%}
          {%- if latest != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="lk__link" href="{{ latest.url }}">
                <span class="lk__label">{{ block.settings.label | default: 'Latest from the journal' }}</span>
                <span class="lk__sub">{{ latest.title }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- else -%}
          <li {{ block.shopify_attributes }}>
            <a class="lk__link{% if block.settings.highlight %} lk__link--hl{% endif %}" href="{{ block.settings.url | default: '/' }}">
              <span class="lk__label">{{ block.settings.label }}</span>
              {%- if block.settings.subtext != blank -%}<span class="lk__sub">{{ block.settings.subtext }}</span>{%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <p class="lk__foot"><a href="{{ routes.root_url }}">{{ shop.name }}</a></p>
  </div>
</section>

{% stylesheet %}
  .lk { min-height: 100vh; display: flex; justify-content: center; padding: 3.5rem 1.25rem 3rem; background: #f5f4f1; }
  .lk__inner { width: 100%; max-width: 30rem; text-align: center; }
  .lk__avatar { width: 7rem; height: 7rem; margin: 0 auto 1.4rem; border-radius: 50%; overflow: hidden; border: 1px solid #dcd9d3; }
  .lk__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lk__brand { display: inline-block; color: #2f2f2f; text-decoration: none; margin-bottom: 1.2rem; }
  .lk__wordmark { font-family: 'Jost', 'Helvetica Neue', Arial, sans-serif; font-weight: 300; font-size: 1.5rem; letter-spacing: .14em; text-transform: uppercase; line-height: 1; }
  .lk__logo { display: block; width: 12rem; max-width: 100%; height: auto; margin: 0 auto; }
  .lk__name { font-family: var(--display); font-weight: 300; font-size: 1.15rem; font-style: italic; letter-spacing: .02em; margin: 0; position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .lk__bio { font-family: var(--body); font-weight: 300; font-size: .95rem; line-height: 1.7; color: #6b6965; margin: 0 auto 2.2rem; max-width: 26rem; }
  .lk__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .lk__link { display: flex; flex-direction: column; gap: .15rem; padding: 1rem 1.25rem; border: 1px solid #2f2f2f; color: #2f2f2f; text-decoration: none; background: transparent; transition: background-color .25s ease, color .25s ease; }
  .lk__link:hover, .lk__link:focus-visible { background: #2f2f2f; color: #f5f4f1; }
  .lk__link:hover .lk__sub, .lk__link:focus-visible .lk__sub { color: #dcd9d3; }
  .lk__link--hl { background: #ede8df; border-color: #ede8df; }
  .lk__label { font-family: var(--body); font-size: .8rem; font-weight: 400; letter-spacing: .16em; text-transform: uppercase; }
  .lk__sub { font-family: var(--body); font-size: .8rem; font-weight: 300; color: #6b6965; letter-spacing: .02em; }
  .lk__foot { margin: 2.5rem 0 0; font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; }
  .lk__foot a { color: #6b6965; text-decoration: none; }
{% endstylesheet %}

