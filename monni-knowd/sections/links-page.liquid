<section class="lt">
  <div class="lt__inner">
    {% render 'links-brand' %}
    {%- if section.settings.tagline != blank -%}<h1 class="lt__tagline">{{ section.settings.tagline }}</h1>{%- endif -%}
    {%- if section.settings.bio != blank -%}<p class="lt__bio">{{ section.settings.bio }}</p>{%- endif -%}
    {%- if section.settings.place != blank -%}<p class="lt__place">{{ section.settings.place }}</p>{%- endif -%}

    <ul class="lt__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- continue -%}
        {%- endif -%}
        {%- if block.type == 'latest_article' -%}
          {%- assign latest = blogs[block.settings.blog].articles.first -%}
          {%- if latest != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="lt__btn" href="{{ latest.url }}">
                <span class="lt__btn-label">{{ block.settings.label | default: 'Latest from the journal' }}</span>
                <span class="lt__btn-sub">{{ latest.title }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- else -%}
          <li {{ block.shopify_attributes }}>
            <a class="lt__btn{% if block.settings.highlight %} lt__btn--solid{% endif %}" href="{{ block.settings.url | default: '/' }}">
              <span class="lt__btn-label">{{ block.settings.label }}</span>
              {%- if block.settings.subtext != blank -%}<span class="lt__btn-sub">{{ block.settings.subtext }}</span>{%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_feed -%}
      {% render 'links-feed', section: section, collection: section.settings.feed_collection, limit: section.settings.feed_limit, heading: section.settings.feed_heading %}
    {%- endif -%}

    <div class="lt__links">
      {%- if section.settings.show_instagram -%}<a class="lt__link" href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/teaandtonicmatakana/' }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if section.settings.show_facebook -%}<a class="lt__link" href="{{ settings.social_facebook_link | default: 'https://www.facebook.com/teaandtonicmatakana' }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Link in bio",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "A place to pause. A place to connect." },
    { "type": "textarea", "id": "bio", "label": "Bio", "default": "Natural skincare, organic tea, jewellery, art, slow fashion and pieces for the home, from women-founded makers." },
    { "type": "text", "id": "place", "label": "Location line", "default": "Matakana Village, Aotearoa" },
    { "type": "checkbox", "id": "show_instagram", "label": "Show Instagram link", "default": false },
    { "type": "checkbox", "id": "show_facebook", "label": "Show Facebook link", "default": true },
    { "type": "header", "content": "Product feed" },
    { "type": "checkbox", "id": "show_feed", "label": "Show product feed under the buttons", "default": true },
    { "type": "text", "id": "feed_heading", "label": "Feed heading", "default": "In store now" },
    { "type": "collection", "id": "feed_collection", "label": "Fallback collection", "info": "Used only when no Feed product blocks are added.", "info": "Tiles show product photos and link straight to each product." },
    { "type": "range", "id": "feed_limit", "label": "Tiles (collection fallback)", "min": 6, "max": 24, "step": 3, "default": 12 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Feed product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Adds a photo tile that links to this product. If you add any, they replace the collection fallback." }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "text", "id": "subtext", "label": "Small text (optional)" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "highlight", "label": "Filled button", "default": false }
      ]
    },
    {
      "type": "latest_article",
      "name": "Latest blog post",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Latest from the journal" },
        { "type": "blog", "id": "blog", "label": "Blog" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Link in bio" }]
}
{% endschema %}
