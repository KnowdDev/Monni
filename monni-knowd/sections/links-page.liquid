<section class="lt">
  <div class="lt__inner">
    {% render 'links-brand' %}
    <h1 class="lt__title">{{ section.settings.name }}</h1>
    {%- if section.settings.bio != blank -%}<p class="lt__bio">{{ section.settings.bio }}</p>{%- endif -%}
    {% render 'links-social' %}

    <ul class="lt__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'latest_article' -%}
          {%- assign latest = blogs[block.settings.blog].articles.first -%}
          {%- if latest != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="lt__btn" href="{{ latest.url }}">
                <span class="lt__btn-label">{{ block.settings.label | default: 'Latest from the journal' }}</span>
                <span class="lt__btn-sub">{{ latest.title }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- else -%}
          <li {{ block.shopify_attributes }}>
            <a class="lt__btn{% if block.settings.highlight %} lt__btn--solid{% endif %}" href="{{ block.settings.url | default: '/' }}">
              <span class="lt__btn-label">{{ block.settings.label }}</span>
              {%- if block.settings.subtext != blank -%}<span class="lt__btn-sub">{{ block.settings.subtext }}</span>{%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_feed -%}
      {% render 'links-feed', collection: section.settings.feed_collection, limit: section.settings.feed_limit, heading: section.settings.feed_heading %}
    {%- endif -%}

    <p class="lt__foot"><a href="{{ routes.root_url }}">teaandtonic.co.nz</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Link in bio",
  "settings": [
    { "type": "text", "id": "name", "label": "Heading", "default": "Tea & Tonic Matakana" },
    { "type": "textarea", "id": "bio", "label": "Bio", "default": "Women-led wellness, fashion, homewares & gifts. Matakana Village, Aotearoa NZ." },
    { "type": "header", "content": "Product feed" },
    { "type": "checkbox", "id": "show_feed", "label": "Show product feed under the buttons", "default": true },
    { "type": "text", "id": "feed_heading", "label": "Feed heading", "default": "In store now" },
    { "type": "collection", "id": "feed_collection", "label": "Feed collection", "info": "Tiles show product photos and link straight to each product." },
    { "type": "range", "id": "feed_limit", "label": "Tiles", "min": 6, "max": 24, "step": 3, "default": 12 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "text", "id": "subtext", "label": "Small text (optional)" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "highlight", "label": "Filled button", "default": false }
      ]
    },
    {
      "type": "latest_article",
      "name": "Latest blog post",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Latest from the journal" },
        { "type": "blog", "id": "blog", "label": "Blog" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Link in bio" }]
}
{% endschema %}
