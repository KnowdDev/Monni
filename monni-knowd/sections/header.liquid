<style>
  .header__mega-panel[hidden],
  .header__drawer[hidden],
  .header__drawer-backdrop[hidden],
  .header__mobile-submenu[hidden] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

{%- liquid
  assign header_over_photo = false
  if template.name == 'index' or template.name == 'product'
    assign header_over_photo = true
  endif
  if page.handle == 'contact'
    assign header_over_photo = true
  endif
-%}
<header
  class="header{% if header_over_photo %} header--over-photo{% endif %}"
  data-section-id="{{ section.id }}"
  data-header-root
  data-header-breakpoint="1160"
  style="--header-logo-width: {{ settings.logo_width | default: 180 }}px;"
>
  <div class="header__shell">
    <div class="header__inner">
      {%- liquid
        assign header_about_url = '/pages/about'
        assign header_brands_url = '/pages/brands'
        assign header_journal_url = routes.blog_url
        assign header_shop_url = '/pages/shop'
        if pages.shop != blank
          assign header_shop_url = pages.shop.url
        endif
        if pages.brands != blank
          assign header_brands_url = pages.brands.url
        endif

        if header_journal_url == blank
          for blog in blogs
            assign header_journal_url = blog.url
            break
          endfor
        endif

        if header_journal_url == blank or header_journal_url == '/blogs/news'
          assign header_journal_url = '/blogs/journal'
        endif

        if section.settings.menu != blank
          for menu_link in section.settings.menu.links
            assign menu_link_handle = menu_link.title | handleize
            if menu_link_handle == 'about'
              assign header_about_url = menu_link.url
            elsif menu_link_handle == 'brands' or menu_link_handle == 'brand'
              assign header_brands_url = menu_link.url
            elsif menu_link_handle == 'journal' or menu_link_handle == 'blog'
              assign header_journal_url = menu_link.url
            elsif menu_link_handle == 'shop'
              assign header_shop_url = menu_link.url
            endif
          endfor
        endif

        if header_journal_url == blank or header_journal_url == '/blogs/news'
          assign header_journal_url = '/blogs/journal'
        endif

        assign header_shop_url = '/collections/all'
      -%}

      <div class="header__side header__side--start">
  <button
    type="button"
    class="header__menu-toggle"
    data-ink-item="Menu"
    aria-controls="header-drawer-{{ section.id }}"
    aria-expanded="false"
    aria-label="Open navigation menu"
    data-header-menu-toggle
  >
    <span class="header__burger" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="sr-only">Menu</span>
  </button>

        <nav class="header__nav header__nav--desktop" aria-label="Primary navigation">
          <ul class="header__menu" role="list">
            <li class="header__menu-item header__menu-item--mega">
              <a
                href="{{ header_shop_url }}"
                class="header__menu-link"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="HeaderShopMega-{{ section.id }}"
                data-header-shop-trigger
                data-ink-item="Shop"
              >Shop</a>
            </li>
            <li class="header__menu-item">
              <a href="{{ header_brands_url }}" class="header__menu-link" data-ink-item="Brands"{% if request.path == header_brands_url %} aria-current="page"{% endif %}>Brands</a>
            </li>
            <li class="header__menu-item">
              <a href="{{ header_journal_url }}" class="header__menu-link" data-ink-item="Journal"{% if request.page_type == 'blog' or request.page_type == 'article' %} aria-current="page"{% endif %}>Journal</a>
            </li>
            <li class="header__menu-item">
              <a href="{{ header_about_url }}" class="header__menu-link" data-ink-item="About"{% if request.path == header_about_url %} aria-current="page"{% endif %}>About</a>
            </li>
          </ul>
        </nav>
      </div>

      <div class="header__logo" data-ink-item="Logo">
        <a href="{{ routes.root_url }}" aria-label="Tea &amp; Tonic" class="header__logo-link">
          <span class="header__logo-text" data-logo-face="a">Tea &amp; Tonic</span>
          <span class="header__logo-text header__logo-text--mirror" data-logo-face="b" aria-hidden="true">Tea &amp; Tonic</span>
        </a>
      </div>

      <div class="header__side header__side--end">
        <nav class="header__utilities" aria-label="Utility navigation">
          <a href="{{ routes.search_url }}" class="header__utility-link" data-ink-item="Search">Search</a>

          {% if section.settings.show_utility_extras %}
            {% if shop.customer_accounts_enabled %}
              {% if customer %}
                <a href="{{ routes.account_url }}" class="header__utility-link header__utility-link--account" data-ink-item="Account">Account</a>
              {% else %}
                <a href="{{ routes.account_login_url }}" class="header__utility-link header__utility-link--account" data-ink-item="Account">Login</a>
              {% endif %}
            {% endif %}

            {% if section.settings.show_wishlist %}
              <a href="/pages/wishlist" class="header__utility-link header__utility-link--wishlist" data-ink-item="Wishlist">Wishlist</a>
            {% endif %}
          {% endif %}

          <a href="{{ routes.cart_url }}" class="header__utility-link header__utility-link--cart" data-ink-item="Cart" data-cart-toggle>
            Cart (<span data-cart-count>{{ cart.item_count }}</span>)
          </a>
        </nav>

        <a href="{{ routes.search_url }}" class="header__mobile-search" data-ink-item="Search">Search</a>
        <a href="{{ routes.cart_url }}" class="header__mobile-cart" data-ink-item="Cart" data-cart-toggle aria-label="Cart, {{ cart.item_count }} items">
          <span class="header__mobile-cart-text">Cart (<span data-cart-count>{{ cart.item_count }}</span>)</span>
        </a>
      </div>
    </div>

    {%- render 'header-shop-megamenu', menu: section.settings.menu, section: section, section_id: section.id, variant: 'desktop' -%}
  </div>
  <p class="sr-only" data-header-ink-report></p>

  <button
    type="button"
    class="header__drawer-backdrop"
    data-header-menu-backdrop
    aria-label="Close navigation menu"
    tabindex="-1"
    hidden
  ></button>

  <div
    id="header-drawer-{{ section.id }}"
    class="header__drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="header-drawer-title-{{ section.id }}"
    aria-hidden="true"
    data-header-menu-drawer
    hidden
  >
    <div class="header__drawer-panel">
      <div class="header__drawer-top">
        <a href="{{ routes.root_url }}" class="header__drawer-brand" id="header-drawer-title-{{ section.id }}">
          <span class="header__logo-text">Tea &amp; Tonic</span>
        </a>

        <button
          type="button"
          class="header__drawer-close"
          data-header-menu-close
          aria-label="Close navigation menu"
        >
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="header__drawer-scroll">
        <nav class="header__nav header__nav--mobile" aria-label="Mobile navigation">
          <ul class="header__mobile-list" role="list" data-header-mobile-list>
            <li class="header__mobile-item header__mobile-item--shop" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_shop_url }}" class="header__mobile-link">Shop</a>
                <button
                  type="button"
                  class="header__mobile-toggle header__mobile-toggle--symbol"
                  aria-label="Toggle Shop categories"
                  aria-expanded="false"
                  aria-controls="HeaderMobileShop-{{ section.id }}"
                  data-header-mobile-toggle
                  data-header-shop-toggle
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
              {%- render 'header-shop-megamenu', menu: section.settings.menu, section: section, section_id: section.id, variant: 'mobile' -%}
            </li>
            <li class="header__mobile-item" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_brands_url }}" class="header__mobile-link"{% if request.path == header_brands_url %} aria-current="page"{% endif %}>Brands</a>
              </div>
            </li>
            <li class="header__mobile-item" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_journal_url }}" class="header__mobile-link"{% if request.page_type == 'blog' or request.page_type == 'article' %} aria-current="page"{% endif %}>Journal</a>
              </div>
            </li>
            <li class="header__mobile-item" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_about_url }}" class="header__mobile-link"{% if request.path == header_about_url %} aria-current="page"{% endif %}>About</a>
              </div>
            </li>
          </ul>
        </nav>

        <div class="header__drawer-separator" aria-hidden="true"></div>

        <div class="header__drawer-utilities">
          <a href="{{ routes.search_url }}" class="header__drawer-utility-link">Search</a>

          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a href="{{ routes.account_url }}" class="header__drawer-utility-link">Account</a>
            {% else %}
              <a href="{{ routes.account_login_url }}" class="header__drawer-utility-link">Login</a>
            {% endif %}
          {% endif %}

          {% if section.settings.show_wishlist %}
            <a href="/pages/wishlist" class="header__drawer-utility-link">Wishlist</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</header>

{% style %}
  .header__announcement {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    background-color: var(--color-foreground);
    color: var(--color-background);
    text-align: center;
    padding: 0.625rem var(--page-margin);
    font-size: var(--text-announcement);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .header__announcement-text {
    display: inline-block;
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101;
    width: 100%;
    overflow: visible;
  }

  body {
    padding-top: 64px;
  }

  body:has(.header--over-photo) {
    padding-top: 0;
  }

  .header__shell {
    position: relative;
    background: transparent;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    overflow: visible;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .shopify-section.shopify-section-group-header-group { display: contents; }

  .header:not(.header--over-photo) .header__shell,
  .header--over-photo.is-solid .header__shell,
  .header.is-open .header__shell,
  .header.header--menu-open .header__shell {
    background: #f5f4f1;
    border-bottom-color: #dcd9d3;
  }

  .header--over-photo:not(.is-solid):not(.is-open):not(.header--menu-open) .header__shell {
    background: transparent;
    border-bottom-color: transparent;
  }

  .header [data-tone="light"] {
    --tone-ink: #faf8f4;
    text-shadow: 0 0 12px rgba(20, 16, 12, 0.4);
  }

  .header [data-tone="light"] .header__menu-link,
  .header [data-tone="light"] .header__utility-link,
  .header [data-tone="light"] .header__mobile-cart,
  .header [data-tone="light"] .header__mobile-search,
  .header [data-tone="light"] .header__menu-toggle,
  .header .header__logo[data-tone="light"] a {
    color: #faf8f4;
  }

  .header [data-tone="light"] .header__menu-link::before,
  .header [data-tone="light"] .header__utility-link::before {
    background-color: #faf8f4;
  }

  .header [data-tone="light"] .header__logo-img {
    filter: brightness(0) invert(1) drop-shadow(0 0 8px rgba(20, 16, 12, 0.5));
  }

  .header [data-ink-item] {
    transition: color 200ms ease, filter 200ms ease, -webkit-text-fill-color 200ms ease;
  }

  /* Shop menu or mobile drawer open: normal ink on a solid bar. */
  .header.is-open .header__shell {
    background: var(--color-background);
    border-bottom-color: #dcd9d3;
  }

  .header.is-open [data-tone="light"],
  .header.header--menu-open [data-tone="light"] { text-shadow: none; }

  .header.is-open [data-tone="light"] .header__menu-link,
  .header.is-open [data-tone="light"] .header__utility-link,
  .header.is-open [data-tone="light"] .header__mobile-cart,
  .header.is-open [data-tone="light"] .header__mobile-search,
  .header.is-open [data-tone="light"] .header__menu-toggle,
  .header.is-open .header__logo[data-tone="light"] a {
    color: var(--color-foreground);
  }

  .header.is-open [data-tone="light"] .header__menu-link::before,
  .header.is-open [data-tone="light"] .header__utility-link::before {
    background-color: var(--color-foreground);
  }

  .header.is-open [data-tone="light"] .header__logo-img { filter: none; }

  .header__burger {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .header__burger i {
    display: block;
    height: 1.5px;
    background: currentColor;
  }

  .header__mobile-search {
    display: none;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__mobile-search:hover {
    color: var(--color-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .header__shell,
    .header [data-ink-item] { transition: none; }
  }

  .header__drawer-backdrop,
  .header__drawer-close,
  .header__menu-toggle {
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    padding: 0;
  }

  .header__menu-toggle {
    cursor: pointer;
  }

  .header__inner {
    position: relative;
    width: calc(min(105rem, 100%) - 2 * clamp(1.25rem, 4vw, 3.5rem));
    min-height: 5rem;
    margin: 0 auto;
    padding: 0.875rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(1rem, 2vw, 2rem);
  }

  .header__side {
    min-width: 0;
    display: flex;
    align-items: center;
    max-width: calc(50% - (var(--header-logo-width) / 2) - clamp(1rem, 2vw, 2rem));
  }

  .header__side--start {
    justify-content: flex-start;
  }

  .header__side--end {
    justify-content: flex-end;
    justify-self: end;
  }

  .header__logo {
    grid-column: 2;
    justify-self: center;
    line-height: 1;
    text-align: center;
  }

  .header__logo a,
  .header__drawer-brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    transition: opacity var(--transition-fast);
  }

  .header__logo-link {
    display: inline-grid;
  }

  .header__logo-text,
  .header__logo-text--mirror {
    grid-area: 1 / 1;
  }

  .header__logo-text--mirror {
    visibility: hidden;
    pointer-events: none;
  }

  .header__logo a:hover,
  .header__drawer-brand:hover {
    opacity: 0.85;
  }

  .header__logo-img {
    display: block;
    width: auto;
    max-width: min(var(--header-logo-width), 13rem);
    max-height: 3rem;
    margin: 0 auto;
    object-fit: contain;
  }

  .header__logo-text {
    font-family: 'Jost', 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.12rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2f2f2f;
    white-space: nowrap;
  }

  .header__logo-svg {
    display: block;
    width: auto;
    max-width: 13rem;
    height: 2rem;
    margin: 0 auto;
  }

  .header__nav--desktop {
    width: 100%;
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.45vw, 1.45rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__menu-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__menu-link::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-foreground);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--transition-normal);
  }

  .header__menu-item--mega {
    position: static;
  }

  .header__menu-link:hover,
  .header__menu-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  .header__menu-link:hover::before,
  .header__menu-link[aria-current="page"]::before,
  .header__menu-item--mega:hover > .header__menu-link::before,
  .header__menu-item--mega.is-shop-open > .header__menu-link::before {
    transform: scaleX(1);
  }

  .header__mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 6;
    display: none;
    padding: 1.75rem 0 2.25rem;
    background: var(--color-background);
    border-top: 1px solid rgba(229, 224, 220, 0.85);
    border-bottom: 1px solid rgba(229, 224, 220, 0.85);
    box-shadow: 0 1.5rem 3rem rgba(61, 61, 61, 0.08);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .header[data-mega-ready="true"] .header__mega-panel {
    transition:
      opacity var(--transition-fast),
      visibility var(--transition-fast);
  }

  /* Invisible bridge between Shop link and panel — keeps hover alive while moving down */
  .header__mega-panel::before {
    content: '';
    position: absolute;
    top: -2rem;
    left: 0;
    right: 0;
    height: 2rem;
  }

  .header[data-mega-ready="true"] .header__shell:has(.header__menu-item--mega.is-shop-open) .header__mega-panel {
    display: block;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .header__mega-inner {
    width: calc(min(105rem, 100%) - 2 * clamp(1.25rem, 4vw, 3.5rem));
    margin: 0 auto;
  }

  .header__mega-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 20rem) minmax(0, 1fr);
    column-gap: clamp(3rem, 5vw, 5.5rem);
    align-items: start;
  }

  .header__mega-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8.75rem, 10.5rem);
    column-gap: clamp(2rem, 3.5vw, 3.5rem);
    align-items: start;
    min-width: 0;
  }

  .header__mega-categories {
    min-width: 0;
  }

  .header__mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.35rem, 2vw, 2rem) clamp(2rem, 3.5vw, 4.5rem);
  }

  .header__mega-aside {
    padding-left: clamp(1rem, 1.5vw, 1.5rem);
    border-left: 1px solid rgba(196, 184, 168, 0.28);
  }

  .header__mega-aside-label {
    margin: 0 0 0.85rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: var(--color-foreground-muted);
  }

  .header__mega-aside-list {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__mega-aside-link {
    font-family: var(--font-heading--family);
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--color-foreground);
    transition: color var(--transition-fast);
  }

  .header__mega-aside-link:hover,
  .header__mega-aside-link[aria-current="page"] {
    color: var(--color-accent-dark);
  }

  .header__mega-featured {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .header__mega-featured-media {
    display: block;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-border-light);
  }

  .header__mega-featured-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(0.98);
    transition: transform var(--transition-normal), filter var(--transition-normal);
  }

  .header__mega-featured:hover .header__mega-featured-image {
    transform: scale(1.03);
    filter: saturate(1) contrast(1);
  }

  .header__mega-featured-caption {
    display: block;
    max-width: 20rem;
    margin-top: 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 0.88rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__mega-featured:hover .header__mega-featured-caption {
    color: var(--color-foreground);
  }

  .header__mega-heading {
    display: block;
    margin-bottom: 0.85rem;
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-foreground);
    transition: color var(--transition-fast);
  }

  .header__mega-heading:hover {
    color: var(--color-accent-dark);
  }

  .header__mega-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__mega-link {
    font-family: var(--font-heading--family);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__mega-link:hover,
  .header__mega-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  .header__utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.9rem, 1.45vw, 1.45rem);
    white-space: nowrap;
  }

  .header__utility-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__utility-link::before {
