{% if section.settings.announcement_text != blank %}
  <div class="header__announcement" data-section-id="{{ section.id }}--announcement">
    <span class="header__announcement-text">{{ section.settings.announcement_text | escape }}</span>
  </div>
{% endif %}

<style>
  .header__mega-panel[hidden],
  .header__drawer[hidden],
  .header__drawer-backdrop[hidden],
  .header__mobile-submenu[hidden] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

<header
  class="header"
  data-section-id="{{ section.id }}"
  data-header-root
  data-header-breakpoint="1160"
  style="--header-logo-width: {{ settings.logo_width | default: 180 }}px;"
>
  <div class="header__shell">
    <div class="header__inner">
      {%- liquid
        assign header_about_url = '/pages/about'
        assign header_brands_url = '/pages/brands'
        assign header_journal_url = routes.blog_url
        assign header_shop_url = '/pages/shop'
        if pages.shop != blank
          assign header_shop_url = pages.shop.url
        endif
        if pages.brands != blank
          assign header_brands_url = pages.brands.url
        endif

        if header_journal_url == blank
          for blog in blogs
            assign header_journal_url = blog.url
            break
          endfor
        endif

        if header_journal_url == blank
          assign header_journal_url = '/blogs/news'
        endif

        if section.settings.menu != blank
          for menu_link in section.settings.menu.links
            assign menu_link_handle = menu_link.title | handleize
            if menu_link_handle == 'about'
              assign header_about_url = menu_link.url
            elsif menu_link_handle == 'brands' or menu_link_handle == 'brand'
              assign header_brands_url = menu_link.url
            elsif menu_link_handle == 'journal' or menu_link_handle == 'blog'
              assign header_journal_url = menu_link.url
            elsif menu_link_handle == 'shop'
              assign header_shop_url = menu_link.url
            endif
          endfor
        endif
      -%}

      <div class="header__side header__side--start">
  <button
    type="button"
    class="header__menu-toggle"
    aria-controls="header-drawer-{{ section.id }}"
    aria-expanded="false"
    aria-label="Open navigation menu"
    data-header-menu-toggle
  >
    <span class="header__menu-toggle-label" aria-hidden="true">Menu</span>
  </button>

        <nav class="header__nav header__nav--desktop" aria-label="Primary navigation">
          <ul class="header__menu" role="list">
            <li class="header__menu-item header__menu-item--mega">
              <a
                href="{{ header_shop_url }}"
                class="header__menu-link"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="HeaderShopMega-{{ section.id }}"
                data-header-shop-trigger
              >Shop</a>
            </li>
            <li class="header__menu-item">
              <a href="{{ header_brands_url }}" class="header__menu-link"{% if request.path == header_brands_url %} aria-current="page"{% endif %}>Brands</a>
            </li>
            <li class="header__menu-item">
              <a href="{{ header_journal_url }}" class="header__menu-link"{% if request.page_type == 'blog' or request.page_type == 'article' %} aria-current="page"{% endif %}>Journal</a>
            </li>
            <li class="header__menu-item">
              <a href="{{ header_about_url }}" class="header__menu-link"{% if request.path == header_about_url %} aria-current="page"{% endif %}>About</a>
            </li>
          </ul>
        </nav>
      </div>

      <div class="header__logo">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}" class="header__logo-link">
          {% if settings.logo != blank %}
            <img
              src="{{ settings.logo | image_url: width: settings.logo_width }}"
              srcset="
                {{ settings.logo | image_url: width: 400 }} 400w,
                {{ settings.logo | image_url: width: settings.logo_width }} {{ settings.logo_width }}w
              "
              sizes="(max-width: 400px) 100vw, {{ settings.logo_width }}px"
              alt="{{ shop.name | escape }}"
              width="{{ settings.logo_width }}"
              height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}"
              class="header__logo-img"
              loading="eager"
              {% if template.name == 'index' %}fetchpriority="low"{% endif %}
            >
          {% else %}
            <span class="header__logo-text">{{ shop.name | escape }}</span>
          {% endif %}
        </a>
      </div>

      <div class="header__side header__side--end">
        <nav class="header__utilities" aria-label="Utility navigation">
          <a href="{{ routes.search_url }}" class="header__utility-link">Search</a>

          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a href="{{ routes.account_url }}" class="header__utility-link header__utility-link--account">Account</a>
            {% else %}
              <a href="{{ routes.account_login_url }}" class="header__utility-link header__utility-link--account">Login</a>
            {% endif %}
          {% endif %}

          {% if section.settings.show_wishlist %}
            <a href="/pages/wishlist" class="header__utility-link header__utility-link--wishlist">Wishlist</a>
          {% endif %}

          <a href="{{ routes.cart_url }}" class="header__utility-link header__utility-link--cart" data-cart-toggle>
            Cart (<span data-cart-count>{{ cart.item_count }}</span>)
          </a>
        </nav>

        <a href="{{ routes.cart_url }}" class="header__mobile-cart" data-cart-toggle>
          Cart (<span data-cart-count>{{ cart.item_count }}</span>)
        </a>
      </div>
    </div>

    {%- render 'header-shop-megamenu', menu: section.settings.menu, section: section, section_id: section.id, variant: 'desktop' -%}
  </div>

  <button
    type="button"
    class="header__drawer-backdrop"
    data-header-menu-backdrop
    aria-label="Close navigation menu"
    tabindex="-1"
    hidden
  ></button>

  <div
    id="header-drawer-{{ section.id }}"
    class="header__drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="header-drawer-title-{{ section.id }}"
    aria-hidden="true"
    data-header-menu-drawer
    hidden
  >
    <div class="header__drawer-panel">
      <div class="header__drawer-top">
        <a href="{{ routes.root_url }}" class="header__drawer-brand" id="header-drawer-title-{{ section.id }}">
          {% if settings.logo != blank %}
            <img
              src="{{ settings.logo | image_url: width: 220 }}"
              alt="{{ shop.name | escape }}"
              width="{{ settings.logo_width }}"
              height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}"
              class="header__logo-img"
            >
          {% else %}
            <span class="header__logo-text">{{ shop.name | escape }}</span>
          {% endif %}
        </a>

        <button
          type="button"
          class="header__drawer-close"
          data-header-menu-close
          aria-label="Close navigation menu"
        >
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="header__drawer-scroll">
        <nav class="header__nav header__nav--mobile" aria-label="Mobile navigation">
          <ul class="header__mobile-list" role="list" data-header-mobile-list>
            <li class="header__mobile-item header__mobile-item--shop" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_shop_url }}" class="header__mobile-link">Shop</a>
                <button
                  type="button"
                  class="header__mobile-toggle header__mobile-toggle--symbol"
                  aria-label="Toggle Shop categories"
                  aria-expanded="false"
                  aria-controls="HeaderMobileShop-{{ section.id }}"
                  data-header-mobile-toggle
                  data-header-shop-toggle
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
              {%- render 'header-shop-megamenu', menu: section.settings.menu, section: section, section_id: section.id, variant: 'mobile' -%}
            </li>
            <li class="header__mobile-item" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_brands_url }}" class="header__mobile-link"{% if request.path == header_brands_url %} aria-current="page"{% endif %}>Brands</a>
              </div>
            </li>
            <li class="header__mobile-item" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_journal_url }}" class="header__mobile-link"{% if request.page_type == 'blog' or request.page_type == 'article' %} aria-current="page"{% endif %}>Journal</a>
              </div>
            </li>
            <li class="header__mobile-item" data-header-mobile-item>
              <div class="header__mobile-row">
                <a href="{{ header_about_url }}" class="header__mobile-link"{% if request.path == header_about_url %} aria-current="page"{% endif %}>About</a>
              </div>
            </li>
          </ul>
        </nav>

        <div class="header__drawer-separator" aria-hidden="true"></div>

        <div class="header__drawer-utilities">
          <a href="{{ routes.search_url }}" class="header__drawer-utility-link">Search</a>

          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a href="{{ routes.account_url }}" class="header__drawer-utility-link">Account</a>
            {% else %}
              <a href="{{ routes.account_login_url }}" class="header__drawer-utility-link">Login</a>
            {% endif %}
          {% endif %}

          {% if section.settings.show_wishlist %}
            <a href="/pages/wishlist" class="header__drawer-utility-link">Wishlist</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</header>

{% style %}
  .header__announcement {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    background-color: var(--color-foreground);
    color: var(--color-background);
    text-align: center;
    padding: 0.625rem var(--page-margin);
    font-size: var(--text-announcement);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .header__announcement-text {
    display: inline-block;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 101;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow-x: hidden;
    overflow-x: clip;
  }

  .header__shell {
    position: relative;
    background: rgba(248, 246, 244, 0.95);
    border-bottom: 1px solid rgba(229, 224, 220, 0.85);
    box-shadow: 0 0.75rem 2.25rem rgba(61, 61, 61, 0.035);
    backdrop-filter: blur(18px);
  }

  .header__drawer-backdrop,
  .header__drawer-close,
  .header__menu-toggle {
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    padding: 0;
  }

  .header__menu-toggle {
    cursor: pointer;
  }

  .header__inner {
    position: relative;
    width: min(var(--content-width), calc(100% - (var(--page-margin) * 2)));
    min-height: 5rem;
    margin: 0 auto;
    padding: 0.875rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(1rem, 2vw, 2rem);
  }

  .header__side {
    min-width: 0;
    display: flex;
    align-items: center;
    max-width: calc(50% - (var(--header-logo-width) / 2) - clamp(1rem, 2vw, 2rem));
  }

  .header__side--start {
    justify-content: flex-start;
  }

  .header__side--end {
    justify-content: flex-end;
    justify-self: end;
  }

  .header__logo {
    grid-column: 2;
    justify-self: center;
    line-height: 1;
    text-align: center;
  }

  .header__logo a,
  .header__drawer-brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    transition: opacity var(--transition-fast);
  }

  .header__logo a:hover,
  .header__drawer-brand:hover {
    opacity: 0.85;
  }

  .header__logo-img {
    display: block;
    width: auto;
    max-width: min(var(--header-logo-width), 13rem);
    max-height: 3rem;
    margin: 0 auto;
    object-fit: contain;
  }

  .header__logo-text {
    font-family: var(--font-heading--family);
    font-size: 1.35rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .header__logo-svg {
    display: block;
    width: auto;
    max-width: 13rem;
    height: 2rem;
    margin: 0 auto;
  }

  .header__nav--desktop {
    width: 100%;
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.45vw, 1.45rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__menu-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0;
    font-family: var(--font-heading--family);
    font-size: clamp(0.92rem, 0.88rem + 0.15vw, 1.05rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    white-space: nowrap;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__menu-link::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-foreground);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--transition-normal);
  }

  .header__menu-item--mega {
    position: static;
  }

  .header__menu-link:hover,
  .header__menu-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  .header__menu-link:hover::before,
  .header__menu-link[aria-current="page"]::before,
  .header__menu-item--mega:hover > .header__menu-link::before,
  .header__menu-item--mega.is-shop-open > .header__menu-link::before {
    transform: scaleX(1);
  }

  .header__mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 6;
    display: none;
    padding: 1.75rem 0 2.25rem;
    background: rgba(252, 250, 248, 0.98);
    border-top: 1px solid rgba(229, 224, 220, 0.85);
    border-bottom: 1px solid rgba(229, 224, 220, 0.85);
    box-shadow: 0 1.5rem 3rem rgba(61, 61, 61, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.25rem);
    pointer-events: none;
  }

  .header[data-mega-ready="true"] .header__mega-panel {
    transition:
      opacity var(--transition-fast),
      transform var(--transition-normal),
      visibility var(--transition-fast);
  }

  .header__mega-panel::before {
    content: '';
    position: absolute;
    top: -1.25rem;
    left: 0;
    right: 0;
    height: 1.25rem;
  }

  .header[data-mega-ready="true"] .header__shell:has(.header__menu-item--mega.is-shop-open) .header__mega-panel {
    display: block;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .header__mega-inner {
    width: min(var(--content-width), calc(100% - (var(--page-margin) * 2)));
    margin: 0 auto;
  }

  .header__mega-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 20rem) minmax(0, 1fr);
    column-gap: clamp(3rem, 5vw, 5.5rem);
    align-items: start;
  }

  .header__mega-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8.75rem, 10.5rem);
    column-gap: clamp(2rem, 3.5vw, 3.5rem);
    align-items: start;
    min-width: 0;
  }

  .header__mega-categories {
    min-width: 0;
  }

  .header__mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.35rem, 2vw, 2rem) clamp(2rem, 3.5vw, 4.5rem);
  }

  .header__mega-aside {
    padding-left: clamp(1rem, 1.5vw, 1.5rem);
    border-left: 1px solid rgba(196, 184, 168, 0.28);
  }

  .header__mega-aside-label {
    margin: 0 0 0.85rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: var(--color-foreground-muted);
  }

  .header__mega-aside-list {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__mega-aside-link {
    font-family: var(--font-heading--family);
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--color-foreground);
    transition: color var(--transition-fast);
  }

  .header__mega-aside-link:hover,
  .header__mega-aside-link[aria-current="page"] {
    color: var(--color-accent-dark);
  }

  .header__mega-featured {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .header__mega-featured-media {
    display: block;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-border-light);
  }

  .header__mega-featured-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(0.98);
    transition: transform var(--transition-normal), filter var(--transition-normal);
  }

  .header__mega-featured:hover .header__mega-featured-image {
    transform: scale(1.03);
    filter: saturate(1) contrast(1);
  }

  .header__mega-featured-caption {
    display: block;
    max-width: 20rem;
    margin-top: 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 0.88rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__mega-featured:hover .header__mega-featured-caption {
    color: var(--color-foreground);
  }

  .header__mega-heading {
    display: block;
    margin-bottom: 0.85rem;
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-foreground);
    transition: color var(--transition-fast);
  }

  .header__mega-heading:hover {
    color: var(--color-accent-dark);
  }

  .header__mega-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__mega-link {
    font-family: var(--font-heading--family);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__mega-link:hover,
  .header__mega-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  .header__utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.9rem, 1.45vw, 1.45rem);
    white-space: nowrap;
  }

  .header__utility-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0;
    font-family: var(--font-heading--family);
    font-size: clamp(0.92rem, 0.88rem + 0.15vw, 1.05rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__utility-link::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-foreground);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--transition-normal);
  }

  .header__utility-link:hover {
    color: var(--color-foreground);
  }

  .header__utility-link:hover::before {
    transform: scaleX(1);
  }

  .header__mobile-cart {
    display: none;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__mobile-cart:hover {
    color: var(--color-foreground);
  }

  .header__submenu-panel {
    position: absolute;
    top: calc(100% - 0.2rem);
    left: -1rem;
    z-index: 4;
    width: min(28rem, 36vw);
    padding-top: 1.2rem;
    opacity: 0;
    transform: translateY(0.75rem);
    pointer-events: none;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-normal);
  }

  .header__submenu-panel::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1.2rem;
  }

  .header__menu-item--has-children:hover > .header__submenu-panel,
  .header__menu-item--has-children:focus-within > .header__submenu-panel {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .header__submenu-shell {
    display: grid;
    gap: 0.9rem;
    padding: 1.2rem 1.2rem 1.1rem;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(229, 224, 220, 0.9);
    box-shadow: 0 1.4rem 3.2rem rgba(61, 61, 61, 0.11);
    backdrop-filter: blur(22px);
  }

  .header__submenu-list {
    display: grid;
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__submenu-item--group {
    padding-top: 0.85rem;
    border-top: 1px solid rgba(229, 224, 220, 0.8);
  }

  .header__submenu-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-foreground-light);
  }

  .header__submenu-link:hover,
  .header__submenu-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  .header__submenu-link--heading {
    font-family: var(--font-heading--family);
    font-size: 0.96rem;
    font-weight: 300;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
  }

  .header__submenu-list--nested {
    gap: 0.45rem;
    margin-top: 0.6rem;
  }

  .header__submenu-grandlink {
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-foreground-light);
  }

  .header__submenu-grandlink:hover,
  .header__submenu-grandlink[aria-current="page"] {
    color: var(--color-foreground);
  }

  .header__menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    margin-left: -0.1rem;
    min-height: 2.75rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-foreground-light);
    cursor: pointer;
    position: relative;
    z-index: 6;
    transition: color var(--transition-fast);
  }

  .header__menu-toggle:hover {
    color: var(--color-foreground);
  }

  .header__menu-toggle-label {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .header__drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 109;
    background: rgba(61, 61, 61, 0.22);
    backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .header__drawer {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: flex;
    justify-content: flex-start;
    visibility: hidden;
    pointer-events: none;
  }

  .header__drawer-panel {
    width: min(31rem, 100%);
    height: 100%;
    padding:
      calc(env(safe-area-inset-top) + 1.25rem)
      clamp(1.25rem, 5vw, 2.1rem)
      calc(env(safe-area-inset-bottom) + 1.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    background:
      linear-gradient(180deg, rgba(248, 246, 244, 0.985) 0%, rgba(255, 255, 255, 0.985) 100%);
    border-right: 1px solid rgba(196, 184, 168, 0.32);
    box-shadow: 1.15rem 0 3.8rem rgba(61, 61, 61, 0.14);
    transform: translateX(-100%);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header--menu-open .header__drawer-panel {
    transform: translateX(0);
  }

  .header--menu-open .header__drawer-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .header--menu-open .header__drawer {
    visibility: visible;
    pointer-events: auto;
  }

  .header--menu-open .header__drawer-panel {
    transform: translateX(0);
  }

  .header__drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header__drawer-brand {
    justify-content: flex-start;
    max-width: min(var(--header-logo-width), 11rem);
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header__drawer-brand img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 2.5rem;
    object-fit: contain;
  }

  .header__drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-foreground);
    line-height: 0;
  }

  .header__drawer-close:hover {
    opacity: 0.72;
  }

  .header__drawer-close svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .header__drawer-scroll {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .header__mobile-list,
  .header__mobile-submenu-list,
  .header__mobile-grandlist {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__mobile-row,
  .header__mobile-submenu-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid rgba(196, 184, 168, 0.22);
  }

  .header__mobile-link,
  .header__mobile-sublink,
  .header__mobile-grandlink {
    display: block;
  }

  .header__mobile-link {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--color-foreground);
    transition: color var(--transition-fast);
  }

  .header__mobile-link:hover,
  .header__mobile-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  .header__mobile-sublink {
    font-size: 0.96rem;
    line-height: 1.5;
    color: var(--color-foreground-light);
  }

  .header__mobile-sublink--heading {
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 300;
    color: var(--color-foreground);
  }

  .header__mobile-grandlink {
    padding: 0.7rem 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-foreground-light);
  }

  .header__mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-foreground-light);
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .header__mobile-toggle svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .header__mobile-toggle--symbol {
    width: auto;
    min-width: 1.5rem;
    font-family: var(--font-heading--family);
    font-size: 1.35rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-foreground-muted);
  }

  .header__mobile-toggle--symbol[aria-expanded="true"] {
    color: var(--color-foreground);
    transform: none;
  }

  .header__mobile-submenu {
    padding: 0.2rem 0 0.25rem 0.9rem;
  }

  .header__mobile-submenu--shop {
    padding: 1rem 0 0.5rem;
  }

  .header__mobile-shop-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(196, 184, 168, 0.22);
  }

  .header__mobile-shop-action {
    font-family: var(--font-heading--family);
    font-size: 0.95rem;
    color: var(--color-foreground);
  }

  .header__mobile-shop-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .header__mobile-shop-heading {
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--font-heading--family);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-foreground);
  }

  .header__mobile-shop-list {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__mobile-shop-link {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-foreground-light);
  }

  .header__mobile-grandmenu {
    padding: 0.15rem 0 0.2rem 0.9rem;
  }

  .header__drawer-separator {
    height: 1px;
    margin: 1.25rem 0 0;
    background-color: var(--color-accent);
    border: none;
  }

  .header__drawer-utilities {
    display: grid;
    gap: 0;
  }

  .header__drawer-utility-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 0;
    border-bottom: 1px solid rgba(196, 184, 168, 0.22);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .header__drawer-utility-link::after {
    content: '→';
    font-size: 0.9rem;
    color: var(--color-foreground-muted);
  }

  .header__drawer-utility-link:hover {
    color: var(--color-foreground);
  }

  .header a:focus-visible,
  .header button:focus-visible {
    outline: 1px solid rgba(168, 154, 138, 0.85);
    outline-offset: 0.25rem;
  }

  html.header-menu-open {
    overflow: hidden;
  }

  @media (max-width: 1320px) {
    .header__inner {
      min-height: 4.75rem;
    }

    .header__menu {
      gap: 1rem;
    }

    .header__menu-link {
      font-size: 0.92rem;
      letter-spacing: 0.02em;
    }
  }

  @media (max-width: 1160px) {
    .header__inner {
      min-height: 4.4rem;
      padding-block: 0.75rem;
    }

    .header__side {
      max-width: none;
    }

    .header__menu-toggle {
      display: inline-flex;
    }

    .header__nav--desktop {
      display: none;
    }

    .header__utilities {
      display: none;
    }

    .header__mobile-cart {
      display: inline-flex;
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
    }

    .header__menu-toggle-label {
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
    }

    .header__logo-img {
      max-width: min(var(--header-logo-width), 11rem);
      max-height: 2.7rem;
    }

    .header__logo-svg {
      max-width: 11rem;
      height: 1.8rem;
    }
  }

  @media (min-width: 1161px) {
    .header__drawer,
    .header__drawer-backdrop {
      display: none !important;
    }
  }

  @media (max-width: 767px) {
    .header__announcement {
      padding-block: 0.55rem;
      font-size: var(--text-announcement);
      letter-spacing: 0.11em;
    }

    .header__inner {
      width: min(var(--content-width), calc(100% - (var(--page-margin) * 1.6)));
      min-height: 4.05rem;
      column-gap: 0.7rem;
    }

    .header__logo-text {
      font-size: 1rem;
      letter-spacing: 0.12em;
    }

    .header__logo-svg {
      max-width: 9rem;
      height: 1.5rem;
    }

    .header__drawer-panel {
      width: 100%;
      padding-inline: clamp(1.15rem, 5vw, 1.55rem);
    }
  }

  @media (max-width: 1320px) {
    .header__mega-layout {
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }

    .header__mega-content {
      grid-template-columns: minmax(0, 1fr) minmax(8rem, 9.5rem);
      column-gap: clamp(1.5rem, 2.5vw, 2.5rem);
    }

    .header__mega-grid {
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: 1.5rem;
    }
  }

  @media (max-width: 1160px) {
    .header__mega-aside {
      display: none;
    }

    .header__mega-content {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstyle %}

{% javascript %}
  document.querySelectorAll('[data-header-menu-toggle]').forEach(function(el) {
    el.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.click();
      }
    });
  });
{% endjavascript %}

