{% javascript %}
  (function () {
    var hdr = document.querySelector('[data-header-root]');
    if (!hdr) return;
    var ticking = false;

    function solidNow() {
      var menuOpen = hdr.classList.contains('header--menu-open') || hdr.classList.contains('is-open') || !!hdr.querySelector('.is-shop-open');
      if (!hdr.classList.contains('header--over-photo') || menuOpen) return true;
      var photo = document.querySelector('[data-header-photo]');
      if (!photo) return true;
      var bar = hdr.getBoundingClientRect().bottom;
      return photo.getBoundingClientRect().bottom <= bar + 1;
    }

    function relLuminance(r, g, b) {
      function lin(c) {
        c = c / 255;
        return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      }
      return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
    }

    function contrast(a, b) {
      var hi = Math.max(a, b), lo = Math.min(a, b);
      return (hi + 0.05) / (lo + 0.05);
    }

    var DARK_L = relLuminance(31, 29, 26);
    var LIGHT_L = relLuminance(250, 248, 244);
    var inkCanvas;
    var bitmaps = {};
    var pendingSrc = {};
    var failedSrc = {};

    function percentile(sorted, p) {
      if (!sorted.length) return null;
      var idx = (sorted.length - 1) * p;
      var lo = Math.floor(idx);
      var hi = Math.ceil(idx);
      if (lo === hi) return sorted[lo];
      return sorted[lo] + (sorted[hi] - sorted[lo]) * (idx - lo);
    }

    function axisPos(token, space, size) {
      if (!token || token === 'center') return (space - size) / 2;
      if (token === 'left' || token === 'top') return 0;
      if (token === 'right' || token === 'bottom') return space - size;
      if (token.charAt(token.length - 1) === '%') return (space - size) * (parseFloat(token) / 100);
      if (token.slice(-2) === 'px') return parseFloat(token);
      return (space - size) / 2;
    }

    function imgUsable(img) {
      if (!img || !img.complete || !img.naturalWidth) return false;
      var node = img;
      var depth = 0;
      while (node && node !== document.body && depth < 8) {
        var style = window.getComputedStyle(node);
        if (style.display === 'none' || style.visibility === 'hidden' || parseFloat(style.opacity) === 0) return false;
        node = node.parentElement;
        depth += 1;
      }
      var ir = img.getBoundingClientRect();
      return ir.width >= 2 && ir.height >= 2;
    }

    function ensureBitmap(src) {
      if (!src || bitmaps[src] || pendingSrc[src] || failedSrc[src]) return;
      pendingSrc[src] = true;
      var loader = new Image();
      loader.crossOrigin = 'anonymous';
      loader.onload = function () {
        bitmaps[src] = loader;
        pendingSrc[src] = false;
        schedule();
      };
      loader.onerror = function () {
        pendingSrc[src] = false;
        failedSrc[src] = true;
      };
      loader.src = src;
    }

    function sampleBox(x0, y0, x1, y1) {
      var photo = document.querySelector('[data-header-photo]');
      if (!photo) return null;
      if (!inkCanvas) inkCanvas = document.createElement('canvas');
      var ctx = inkCanvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;
      var values = [];
      var imgs = photo.querySelectorAll('img');
      for (var k = 0; k < imgs.length; k++) {
        var img = imgs[k];
        if (!imgUsable(img)) continue;
        var ir = img.getBoundingClientRect();
        var ix0 = Math.max(x0, ir.left);
        var iy0 = Math.max(y0, ir.top);
        var ix1 = Math.min(x1, ir.right);
        var iy1 = Math.min(y1, ir.bottom);
        if (ix1 - ix0 < 2 || iy1 - iy0 < 2) continue;
        var style = window.getComputedStyle(img);
        var fit = style.objectFit || 'cover';
        var parts = (style.objectPosition || '50% 50%').trim().split(/\s+/);
        var nw = img.naturalWidth;
        var nh = img.naturalHeight;
        var scaleX;
        var scaleY;
        if (fit === 'contain' || fit === 'scale-down') {
          var contain = Math.min(ir.width / nw, ir.height / nh);
          if (fit === 'scale-down') contain = Math.min(1, contain);
          scaleX = scaleY = contain;
        } else if (fit === 'none') {
          scaleX = scaleY = 1;
        } else if (fit === 'fill') {
          scaleX = ir.width / nw;
          scaleY = ir.height / nh;
        } else {
          var cover = Math.max(ir.width / nw, ir.height / nh);
          scaleX = scaleY = cover;
        }
        var dispW = nw * scaleX;
        var dispH = nh * scaleY;
        var offX = ir.left + axisPos(parts[0], ir.width, dispW);
        var offY = ir.top + axisPos(parts[1] || parts[0], ir.height, dispH);
        var sx = (ix0 - offX) / scaleX;
        var sy = (iy0 - offY) / scaleY;
        var sw = (ix1 - ix0) / scaleX;
        var sh = (iy1 - iy0) / scaleY;
        if (sx < 0) { sw += sx; sx = 0; }
        if (sy < 0) { sh += sy; sy = 0; }
        if (sx + sw > nw) sw = nw - sx;
        if (sy + sh > nh) sh = nh - sy;
        if (sw < 1 || sh < 1) continue;
        var src = img.currentSrc || img.src;
        var drawable = (src && bitmaps[src]) ? bitmaps[src] : img;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var cw = Math.max(4, Math.min(48, Math.round((ix1 - ix0) * dpr)));
        var ch = Math.max(4, Math.min(24, Math.round((iy1 - iy0) * dpr)));
        inkCanvas.width = cw;
        inkCanvas.height = ch;
        try {
          ctx.drawImage(drawable, sx, sy, sw, sh, 0, 0, cw, ch);
          var data = ctx.getImageData(0, 0, cw, ch).data;
          for (var i = 0; i < data.length; i += 4) {
            if (data[i + 3] < 20) continue;
            values.push(relLuminance(data[i], data[i + 1], data[i + 2]));
          }
        } catch (err) {
          ensureBitmap(src);
        }
      }
      if (!values.length) return null;
      values.sort(function (a, b) { return a - b; });
      return { p10: percentile(values, 0.1), p90: percentile(values, 0.9) };
    }

    function fromSample(box) {
      var darkMin = Math.min(contrast(DARK_L, box.p10), contrast(DARK_L, box.p90));
      var lightMin = Math.min(contrast(LIGHT_L, box.p10), contrast(LIGHT_L, box.p90));
      var ink = darkMin >= lightMin ? 'dark' : 'light';
      var score = ink === 'dark' ? darkMin : lightMin;
      return { ink: ink, contrast: score, scrim: score < 4.5, source: 'sample' };
    }

    function overlapW(x0, x1, rect) {
      return Math.max(0, Math.min(x1, rect.right) - Math.max(x0, rect.left));
    }

    function hitsBand(rect, y0, y1) {
      return rect.width >= 2 && rect.bottom > y0 && rect.top < y1;
    }

    function forcedInk(x0, x1, y0, y1) {
      var nodes = document.querySelectorAll('[data-header-photo] [data-ink-override]');
      var best = null;
      var bestW = 0;
      var width = Math.max(1, x1 - x0);
      for (var i = 0; i < nodes.length; i++) {
        var mode = nodes[i].getAttribute('data-ink-override');
        if (!mode || mode === 'auto') continue;
        var rect = nodes[i].getBoundingClientRect();
        if (!hitsBand(rect, y0, y1)) continue;
        var w = overlapW(x0, x1, rect);
        if (w > bestW) { bestW = w; best = mode; }
      }
      if (!best || bestW / width < 0.6) return null;
      return { ink: best, contrast: null, scrim: false, source: 'override' };
    }

    function declaredInk(x0, x1, y0, y1) {
      var nodes = document.querySelectorAll('[data-header-photo] [data-bg]');
      var darkW = 0;
      var lightW = 0;
      for (var i = 0; i < nodes.length; i++) {
        var rect = nodes[i].getBoundingClientRect();
        if (!hitsBand(rect, y0, y1)) continue;
        var w = overlapW(x0, x1, rect);
        var tone = nodes[i].getAttribute('data-bg');
        if (tone === 'dark') darkW += w;
        else if (tone === 'light') lightW += w;
      }
      if (darkW + lightW < 1) return null;
      return { ink: darkW >= lightW ? 'light' : 'dark', contrast: null, scrim: false, source: 'fallback' };
    }

    function decide(x0, x1, y0, y1) {
      var forced = forcedInk(x0, x1, y0, y1);
      if (forced) return forced;
      var box = sampleBox(x0, y0, x1, y1);
      if (box) return fromSample(box);
      return declaredInk(x0, x1, y0, y1) || { ink: 'dark', contrast: null, scrim: false, source: 'fallback' };
    }

    function paintItem(el, decision) {
      el.setAttribute('data-ink', decision.ink);
      el.setAttribute('data-ink-source', decision.source);
      if (decision.contrast == null) el.removeAttribute('data-contrast');
      else el.setAttribute('data-contrast', decision.contrast.toFixed(2));
      if (decision.scrim) el.setAttribute('data-scrim', 'true');
      else el.removeAttribute('data-scrim');
      el.style.removeProperty('--ink-l');
      el.style.removeProperty('--ink-r');
      el.style.removeProperty('--logo-split');
    }

    function findSeam(el, y0, y1) {
      var rect = el.getBoundingClientRect();
      var cols = 20;
      var prev = null;
      var best = 0;
      var at = null;
      for (var i = 0; i < cols; i++) {
        var x = rect.left + (rect.width * (i + 0.5)) / cols;
        var box = sampleBox(x - 1, y0, x + 1, y1);
        var L = box ? (box.p10 + box.p90) / 2 : null;
        if (L != null && prev != null) {
          var delta = Math.abs(L - prev);
          if (delta > best) {
            best = delta;
            at = rect.left + (rect.width * i) / cols;
          }
        }
        if (L != null) prev = L;
      }
      if (at != null && best >= 0.08) return at;
      var panels = document.querySelectorAll('[data-header-photo] [data-bg]');
      for (var j = 0; j < panels.length; j++) {
        var pr = panels[j].getBoundingClientRect();
        if (pr.right > rect.left + 8 && pr.right < rect.right - 8 && pr.bottom > y0 && pr.top < y1) return pr.right;
      }
      return rect.left + rect.width / 2;
    }

    function paintLogo(el, y0, y1) {
      var rect = el.getBoundingClientRect();
      if (rect.width < 2) return;
      var mid = rect.left + rect.width / 2;
      var left = decide(rect.left - 6, mid, y0, y1);
      var right = decide(mid, rect.right + 6, y0, y1);
      if (left.ink === right.ink) {
        var matched = left;
        if (left.contrast != null && right.contrast != null) {
          matched = {
            ink: left.ink,
            contrast: Math.min(left.contrast, right.contrast),
            scrim: left.scrim || right.scrim,
            source: left.source === 'sample' || right.source === 'sample' ? 'sample' : left.source
          };
        }
        paintItem(el, matched);
        return;
      }
      var seam = findSeam(el, y0, y1);
      var pct = ((seam - rect.left) / rect.width) * 100;
      pct = Math.max(4, Math.min(96, pct));
      var scores = [left.contrast, right.contrast].filter(function (n) { return n != null; });
      el.setAttribute('data-ink', 'split');
      el.setAttribute('data-ink-source', left.source === 'sample' || right.source === 'sample' ? 'sample' : (left.source === 'override' || right.source === 'override' ? 'override' : 'fallback'));
      if (scores.length) el.setAttribute('data-contrast', Math.min.apply(null, scores).toFixed(2));
      else el.removeAttribute('data-contrast');
      el.style.setProperty('--ink-l', left.ink === 'light' ? '#faf8f4' : '#1f1d1a');
      el.style.setProperty('--ink-r', right.ink === 'light' ? '#faf8f4' : '#1f1d1a');
      el.style.setProperty('--logo-split', pct.toFixed(2) + '%');
      if (left.scrim || right.scrim) el.setAttribute('data-scrim', 'true');
      else el.removeAttribute('data-scrim');
    }

    function paintInk() {
      var items = hdr.querySelectorAll('[data-ink-item]');
      var forcedSolid = solidNow();
      var bits = [];
      var sampled = false;
      for (var i = 0; i < items.length; i++) {
        var el = items[i];
        var rect = el.getBoundingClientRect();
        if (rect.width < 2 || rect.height < 2) continue;
        if (forcedSolid) {
          paintItem(el, { ink: 'dark', contrast: null, scrim: false, source: 'solid' });
        } else if (el.classList.contains('header__logo')) {
          paintLogo(el, rect.top - 6, rect.bottom + 6);
        } else {
          decidePaint(el, rect);
        }
        if (el.getAttribute('data-ink-source') === 'sample') sampled = true;
        bits.push(
          el.getAttribute('data-ink-item') +
          ' ink=' + el.getAttribute('data-ink') +
          ' contrast=' + (el.getAttribute('data-contrast') || 'n/a') +
          ' source=' + el.getAttribute('data-ink-source') +
          (el.getAttribute('data-scrim') === 'true' ? ' scrim' : '')
        );
      }
      hdr.setAttribute('data-ink-mode', forcedSolid ? 'solid' : (sampled ? 'sample' : 'fallback'));
      var report = hdr.querySelector('[data-header-ink-report]');
      if (report) report.textContent = bits.join(' | ');
      document.body.setAttribute('data-ink-ready', 'true');
    }

    function decidePaint(el, rect) {
      paintItem(el, decide(rect.left - 6, rect.right + 6, rect.top - 6, rect.bottom + 6));
    }

    function bindPhoto() {
      var photo = document.querySelector('[data-header-photo]');
      if (!photo || photo.getAttribute('data-ink-bound') === '1') return;
      photo.setAttribute('data-ink-bound', '1');
      var imgs = photo.querySelectorAll('img');
      for (var i = 0; i < imgs.length; i++) imgs[i].addEventListener('load', schedule);
      var scroller = photo.querySelector('.media-gallery__main');
      if (scroller) scroller.addEventListener('scroll', schedule, { passive: true });
      new MutationObserver(schedule).observe(photo, { subtree: true, attributes: true, attributeFilter: ['class'] });
    }

    function update() {
      ticking = false;
      hdr.classList.toggle('is-open', !!hdr.querySelector('.is-shop-open') || hdr.classList.contains('header--menu-open'));
      hdr.classList.toggle('is-solid', solidNow());
      bindPhoto();
      paintInk();
    }

    function schedule() {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('orientationchange', schedule);
    document.addEventListener('DOMContentLoaded', update);
    window.addEventListener('load', update);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(schedule);
    if (document.fonts && document.fonts.addEventListener) document.fonts.addEventListener('loadingdone', schedule);
    new MutationObserver(schedule).observe(hdr, { subtree: true, attributes: true, attributeFilter: ['class'] });
    update();
  })();
  document.querySelectorAll('[data-header-menu-toggle]').forEach(function(el) {
    el.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.click();
      }
    });
  });
{% endjavascript %}

