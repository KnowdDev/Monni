{% comment %}
  404 Error Page - Monni Theme
{% endcomment %}

<section class="section-404" data-section-id="{{ section.id }}">
  <div class="container section-404__container">
    <div class="section-404__inner">
      <p class="section-404__eyebrow">{{ section.settings.eyebrow }}</p>

      <h1 class="section-404__title">
        <span class="section-404__number">404</span>
        {{ section.settings.heading }}
      </h1>

      <p class="section-404__text">{{ section.settings.text }}</p>

      <div class="section-404__actions">
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary section-404__primary">
          {{ section.settings.button_label }}
        </a>
        <a href="{{ routes.root_url }}" class="section-404__secondary-link">
          {{ section.settings.secondary_link_label }}
        </a>
      </div>

      <div class="section-404__quick-links" aria-label="Quick links">
        <a href="/collections/beauty">{{ section.settings.quick_link_one }}</a>
        <a href="/collections/giftboxes">{{ section.settings.quick_link_two }}</a>
        <a href="/pages/contact">{{ section.settings.quick_link_three }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.404",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "We couldn't find that page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lost in the quiet?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The page you requested has moved, expired, or never existed. Let's guide you back to something beautiful."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "text",
      "id": "secondary_link_label",
      "label": "Secondary link label",
      "default": "Return home"
    },
    {
      "type": "text",
      "id": "quick_link_one",
      "label": "Quick link one label",
      "default": "Beauty"
    },
    {
      "type": "text",
      "id": "quick_link_two",
      "label": "Quick link two label",
      "default": "Gifting"
    },
    {
      "type": "text",
      "id": "quick_link_three",
      "label": "Quick link three label",
      "default": "Contact"
    }
  ]
}
{% endschema %}
