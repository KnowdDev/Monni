<section class="makers full-width" data-section-id="{{ section.id }}">
  <div class="makers__inner">
    <div class="makers__image-wrap">
      {% if section.settings.image %}
        {% render 'responsive-img',
          image: section.settings.image,
          alt: section.settings.maker_name,
          class: 'makers__image',
          sizes: '(max-width: 767px) 100vw, 50vw',
          widths: '280,360,480,640',
          default_width: 360,
          width: 900,
          height: 1100,
          loading: 'lazy'
        %}
      {% else %}
        <img
          src="{{ 'wild-earth-nelly-720.webp' | asset_url }}"
          alt="{{ section.settings.maker_name | escape }}"
          loading="lazy"
          decoding="async"
          width="720"
          height="828"
          class="makers__image"
        >
      {% endif %}
    </div>

    <div class="makers__text">
      <span class="makers__eyebrow">{{ section.settings.eyebrow | default: "Maker of the Month" | escape }}</span>
      <h2 class="makers__name">{{ section.settings.maker_name | escape }}</h2>
      {% if section.settings.maker_location != blank %}
        <p class="makers__location">{{ section.settings.maker_location | escape }}</p>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="makers__desc">{{ section.settings.description | escape }}</p>
      {% endif %}
      {% if section.settings.cta != blank or section.settings.cta_secondary != blank %}
        <div class="makers__ctas">
          {% if section.settings.cta != blank %}
            <a href="{{ section.settings.link | default: '#' }}" class="makers__cta">
              {{ section.settings.cta | escape }}
            </a>
          {% endif %}
          {% if section.settings.cta_secondary != blank %}
            <a href="{{ section.settings.link_secondary | default: '#' }}" class="makers__cta makers__cta--secondary">
              {{ section.settings.cta_secondary | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .makers {
    background-color: #ede8df;
    padding: 0;
    margin-top: 0;
    margin-bottom: 80px;
  }

  .makers__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    max-width: 105rem;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .makers__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .makers__image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-border-light);
  }

  @media (min-width: 768px) {
    .makers__image-wrap { aspect-ratio: 3 / 2; }
  }

  .makers__image,
  .makers__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .makers__fallback {
    background: linear-gradient(135deg, var(--color-accent-light), var(--color-border-light));
  }

  .makers__text {
    padding: 26px 22px 34px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .makers__text { padding: clamp(28px, 4vw, 48px); }
  }

  .makers__eyebrow {
    display: block;
    font-family: var(--font-body--family);
    font-size: 0.64rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-foreground-light);
    margin: 0 0 8px;
  }

  .makers__name {
    font-family: var(--font-heading--family);
    font-size: 1.8rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.15;
    color: var(--color-foreground);
    margin: 0 0 8px;
    text-wrap: balance;
  }

  .makers__location {
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--color-foreground-light);
    margin: 0 0 12px;
  }

  .makers__desc {
    font-family: var(--font-body--family);
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-foreground-light);
    margin: 0 auto 16px;
    max-width: 30ch;
  }

  @media (min-width: 768px) {
    .makers__eyebrow { font-size: 0.68rem; letter-spacing: 0.28em; margin-bottom: 12px; }
    .makers__name { font-size: clamp(2rem, 3.2vw, 2.6rem); margin-bottom: 12px; }
    .makers__desc { font-size: 1rem; line-height: 1.65; max-width: 34ch; margin-bottom: 22px; }
  }

  .makers__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    align-items: center;
  }

  .makers__cta {
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .makers__cta:hover { opacity: 0.7; }
{% endstyle %}

{% schema %}
{
  "name": "From the Makers",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Maker of the Month"
    },
    {
      "type": "text",
      "id": "maker_name",
      "label": "Maker name",
      "default": "Wild Earth Perfume"
    },
    {
      "type": "text",
      "id": "maker_location",
      "label": "Maker location",
      "default": "Nelly, Gisborne"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Nelly founded Wild Earth in Gisborne, a handmade perfume studio where every bottle begins as a plant. Completely natural fragrance, made slowly, to feel like something you've always carried."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Primary CTA",
      "default": "Shop Wild Earth"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "cta_secondary",
      "label": "Secondary CTA",
      "default": "Read the Journal"
    },
    {
      "type": "url",
      "id": "link_secondary",
      "label": "Secondary link"
    }
  ],
  "presets": [
    {
      "name": "From the Makers",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
