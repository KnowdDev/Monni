        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Own Creations",
      "category": "Homepage",
      "blocks": {
        "creation-0": {
          "type": "creation",
          "settings": {
            "title": "Monni Botanicals",
            "description": "Skincare made in rhythm with the seasons.",
            "cta": "Discover",
