<section class="creations full-width" data-section-id="{{ section.id }}">
  <div class="creations__head">
    {% if section.settings.title != blank %}
      <h2 class="creations__title">{{ section.settings.title }}</h2>
    {% endif %}
    <div class="creations__tools">
      <div class="creations__arrows">
        <button class="creations__arrow creations__arrow--prev" type="button" aria-label="Previous" data-creations-prev></button>
        <button class="creations__arrow creations__arrow--next" type="button" aria-label="Next" data-creations-next></button>
      </div>
      <p class="creations__count" data-creations-count>1 / 3</p>
    </div>
  </div>

  <div class="creations__rail" data-creations-rail>
    {% for block in section.blocks %}
      {%- liquid
        assign title_down = block.settings.title | downcase
        assign sort = 4
        if title_down contains 'botanical'
          assign sort = 1
        elsif title_down contains 'label'
          assign sort = 2
        elsif title_down contains 'art'
          assign sort = 3
        endif
        assign treatment = block.settings.image_treatment | default: 'auto'
        if treatment == blank or treatment == 'auto'
          if title_down contains 'art'
            assign treatment = 'contain_bottom'
          else
            assign treatment = 'cover'
          endif
        endif
        assign desc = block.settings.description | escape | replace: 'self-expression', '<span class="creations__keep">self-expression</span>' | replace: 'women-founded', '<span class="creations__keep">women-founded</span>'
      -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="creations__item"
        style="--sort: {{ sort }}"
        {{ block.shopify_attributes }}
      >
        <div class="creations__image-wrap{% if treatment == 'contain_bottom' %} creations__image-wrap--contain{% endif %}">
          {% if block.settings.image %}
            {% render 'responsive-img',
              image: block.settings.image,
              alt: block.settings.title,
              class: 'creations__image',
              sizes: '(max-width: 767px) 82vw, 68vw',
              widths: '480,720,960,1200,1600',
              default_width: 960,
              width: 1400,
              height: 1200,
              loading: 'lazy'
            %}
          {% else %}
            {% assign unsplash_creation_ids = "photo-1608248543803-ba4f9554aef6,photo-1516762689617-e1cffcef479d,photo-1513364776144-60967b0f800f" | split: "," %}
            {% assign fallback_i = forloop.index0 | modulo: 3 %}
            <img
              src="https://images.unsplash.com/{{ unsplash_creation_ids[fallback_i] }}?w=1200&h=1000&fit=crop&q=80"
              alt="{{ block.settings.title | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="1200"
              height="1000"
              class="creations__image"
            >
          {% endif %}
        </div>
        <h3 class="creations__label">{{ block.settings.title | escape }}</h3>
        {% if block.settings.description != blank %}
          <p class="creations__desc">{{ desc }}</p>
        {% endif %}
        {% if block.settings.cta != blank %}
          <span class="creations__cta">{{ block.settings.cta | escape }}</span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var rail = root.querySelector('[data-creations-rail]');
    var prev = root.querySelector('[data-creations-prev]');
    var next = root.querySelector('[data-creations-next]');
    var count = root.querySelector('[data-creations-count]');
    if (!rail) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function slides() { return rail.querySelectorAll('.creations__item'); }
    function step() {
      var first = slides()[0];
      if (!first) return rail.clientWidth;
      return first.getBoundingClientRect().width + 16;
    }
    function paint() {
      var list = slides();
      var total = list.length || 1;
      var i = Math.round(rail.scrollLeft / step());
      i = Math.max(0, Math.min(total - 1, i));
      if (count) count.textContent = (i + 1) + ' / ' + total;
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= total - 1;
    }
    function go(dir) {
      rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });
    }
    if (next) next.addEventListener('click', function () { go(1); });
    if (prev) prev.addEventListener('click', function () { go(-1); });
    rail.addEventListener('scroll', function () {
      window.clearTimeout(rail._t);
      rail._t = window.setTimeout(paint, 80);
    }, { passive: true });
    window.addEventListener('resize', paint);
    paint();
  })();
</script>

{% style %}
  .creations {
    min-width: 0;
    max-width: 100%;
    background-color: var(--color-background);
    padding: 0 0 80px;
  }

  .creations__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin: 0 0 20px;
    padding: 0 16px;
  }

  .creations__title {
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }

  @media (min-width: 768px) {
    .creations__title { font-size: 1rem; }
  }

  .creations__tools { display: flex; align-items: center; }

  .creations__arrows { display: none; gap: 6px; }

  @media (min-width: 768px) {
    .creations__arrows { display: flex; }
    .creations__count { display: none; }
  }

  .creations__count {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 400;
    color: #6b6965;
  }

  .creations__arrow {
    width: 30px;
    height: 30px;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
    padding: 0;
  }

  .creations__arrow::before {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid #2f2f2f;
    border-bottom: 1.5px solid #2f2f2f;
  }

  .creations__arrow--prev::before { transform: translateX(2px) rotate(135deg); }
  .creations__arrow--next::before { transform: translateX(-2px) rotate(-45deg); }
  .creations__arrow:disabled { opacity: 0.25; cursor: default; }
  .creations__arrow:focus-visible { outline: 1px solid #2f2f2f; outline-offset: 2px; }

  .creations__rail {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 16px;
    padding: 0 16px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .creations__rail::-webkit-scrollbar { display: none; }

  .creations__item {
    display: block;
    flex: 0 0 82%;
    order: var(--sort, 4);
    scroll-snap-align: start;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 768px) {
    .creations__item { flex-basis: 68%; }
  }

  .creations__image-wrap {
    aspect-ratio: 1.15 / 1;
    overflow: hidden;
    background: #fff;
  }

  .creations__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .creations__image-wrap--contain .creations__image {
    object-fit: contain;
    object-position: center bottom;
  }

  .creations__keep { white-space: nowrap; }

  .creations__label {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 18px 0 0;
  }

  .creations__desc {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 15px;
    letter-spacing: 0;
    color: #6b6965;
    line-height: 1.55;
    margin: 6px 0 0;
  }

  .creations__cta {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  @media (min-width: 768px) {
    .creations__label,
    .creations__cta { font-size: 0.875rem; }
    .creations__desc { font-size: 1rem; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Our Own Creations",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Own Creations"
    }
  ],
  "blocks": [
    {
      "type": "creation",
      "name": "Creation",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_treatment",
          "label": "Image fit",
          "default": "auto",
          "options": [
            { "value": "auto", "label": "Automatic (Art sits at the bottom)" },
            { "value": "cover", "label": "Fill the frame" },
            { "value": "contain_bottom", "label": "Whole image, sitting at the bottom" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "MONNI Botanicals"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Skincare made in rhythm with the seasons."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Own Creations",
      "category": "Homepage",
      "blocks": {
        "creation-0": {
          "type": "creation",
          "settings": {
            "title": "MONNI Botanicals",
            "description": "Skincare made in rhythm with the seasons.",
            "cta": "Discover",
            "link": "/collections/face"
          }
        },
        "creation-1": {
          "type": "creation",
          "settings": {
            "title": "MONNI Label",
            "description": "Clothing as a form of feeling and self-expression.",
            "cta": "Discover",
            "link": "/collections/monni-label"
          }
        },
        "creation-2": {
          "type": "creation",
          "settings": {
            "title": "MONNI Art",
            "description": "Creativity as an act of healing for the artist and the earth.",
            "cta": "Discover",
            "link": "/collections/monni-art",
            "image_treatment": "contain_bottom"
          }
        }
      }
    }
  ]
}
{% endschema %}
