<section class="creations full-width" data-section-id="{{ section.id }}">
  <div class="creations__inner">
    {% if section.settings.title != blank %}
      <h2 class="creations__title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="creations__slider" data-swipe-row>
      <div class="creations__grid" data-swipe-scroller>
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="creations__item"
          {{ block.shopify_attributes }}
        >
          <div class="creations__image-wrap">
            {% if block.settings.image %}
              {% render 'responsive-img',
                image: block.settings.image,
                alt: block.settings.title,
                class: 'creations__image',
                sizes: '(max-width: 767px) 100vw, 33vw',
                widths: '200,240,280,360',
                default_width: 240,
                width: 600,
                height: 780,
                loading: 'lazy'
              %}
            {% else %}
              {% assign unsplash_creation_ids = "photo-1608248543803-ba4f9554aef6,photo-1516762689617-e1cffcef479d,photo-1513364776144-60967b0f800f" | split: "," %}
              <img
                src="https://images.unsplash.com/{{ unsplash_creation_ids[forloop.index0] }}?w=600&h=780&fit=crop&q=80"
                srcset="
                  https://images.unsplash.com/{{ unsplash_creation_ids[forloop.index0] }}?w=300&h=390&fit=crop&q=80 300w,
                  https://images.unsplash.com/{{ unsplash_creation_ids[forloop.index0] }}?w=600&h=780&fit=crop&q=80 600w,
                  https://images.unsplash.com/{{ unsplash_creation_ids[forloop.index0] }}?w=900&h=1170&fit=crop&q=80 900w
                "
                sizes="(max-width: 767px) 100vw, 33vw"
                alt="{{ block.settings.title | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="600"
                height="780"
                class="creations__image"
              >
            {% endif %}
            <div class="creations__shade" aria-hidden="true"></div>
            <div class="creations__text">
            <h3 class="creations__label">{{ block.settings.title | escape }}</h3>
            {% if block.settings.description != blank %}
              <p class="creations__desc">{{ block.settings.description | escape }}</p>
            {% endif %}
            {% if block.settings.cta != blank %}
              <span class="creations__cta">{{ block.settings.cta | escape }}</span>
            {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}
      </div>
      <button class="swipe-arrow" type="button" aria-label="Next" data-swipe-next>
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9,4 17,12 9,20" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
    </div>
  </div>
</section>
{% render 'swipe-row-script' %}

{% style %}
  .creations {
    min-width: 0;
    max-width: 100%;
    --hp-gutter: clamp(1.25rem, 4vw, 3.5rem);
    background-color: var(--color-background);
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 0;
  }

  .creations__inner {
    max-width: 105rem;
    margin: 0 auto;
  }

  .creations__title {
    font-family: var(--font-body--family);
    font-size: 0.76rem;
    font-weight: 400;
    text-align: left;
    color: var(--color-foreground);
    margin: 0 0 1.1rem;
    padding: 0 var(--hp-gutter);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .creations__slider { position: relative; }

  /* Phone: swipeable row of large photographs. */
  .creations__grid {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 0 var(--hp-gutter);
    scroll-padding-left: var(--hp-gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .creations__grid::-webkit-scrollbar { display: none; }

  .creations__item {
    position: relative;
    display: block;
    flex: 0 0 min(290px, 78vw);
    scroll-snap-align: start;
    text-decoration: none;
    color: #faf8f4;
  }

  /* Tablet / desktop: three across. */
  @media (min-width: 768px) {
    .creations__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      overflow: visible;
    }

    .creations__item { flex: none; }
    .creations .swipe-arrow { display: none; }
  }

  .creations__image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-border-light);
  }

  .creations__image,
  .creations__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .creations__item:hover .creations__image { transform: scale(1.03); }
  }

  .creations__fallback {
    background: linear-gradient(135deg, var(--color-accent-light), var(--color-border-light));
  }

  .creations__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(34, 30, 26, 0.62) 0%, rgba(34, 30, 26, 0.28) 38%, rgba(34, 30, 26, 0) 62%);
    pointer-events: none;
  }

  .creations__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 22px;
    text-align: left;
  }

  @media (min-width: 768px) {
    .creations__text { padding: clamp(20px, 2.4vw, 32px) clamp(16px, 2.2vw, 28px); }
  }

  .creations__label {
    font-family: var(--font-heading--family);
    font-size: clamp(1.7rem, 2.6vw, 2rem);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.15;
    color: #faf8f4;
    margin: 0 0 6px;
  }

  .creations__desc {
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.45;
    color: #faf8f4;
    margin: 0 0 14px;
    max-width: 26ch;
  }

  @media (min-width: 768px) {
    .creations__desc { font-size: 0.9rem; }
  }

  .creations__cta {
    display: inline-block;
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #faf8f4;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
{% endstyle %}

{% schema %}
