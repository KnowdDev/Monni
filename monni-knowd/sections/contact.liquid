{% comment %}
  Contact section with form, contact information, and social links
  Designed with Monni's calm, thoughtful aesthetic
{% endcomment %}

<div class="contact section--padding" data-section-id="{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="contact__inner container">
    
    {% comment %} Header {% endcomment %}
    <header class="contact__header">
      <h1 class="contact__title">{{ section.settings.heading | default: page.title | default: 'Contact' }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="contact__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div class="contact__grid">
      
      {% comment %} Contact Form {% endcomment %}
      <div class="contact__form-wrapper">
        {% render 'contact-form' %}
      </div>

      {% comment %} Contact Information {% endcomment %}
      <div class="contact__info">
        
        {% if section.settings.show_store_details %}
          <div class="contact__info-section">
            <h2 class="contact__info-heading">{{ section.settings.store_heading | default: 'Visit Us' }}</h2>
            
            {% if section.settings.store_address != blank %}
              <address class="contact__address">
                {{ section.settings.store_address | newline_to_br }}
              </address>
            {% endif %}

            {% if section.settings.store_hours != blank %}
              <div class="contact__hours">
                <h3 class="contact__hours-heading">Hours</h3>
                {{ section.settings.store_hours | newline_to_br }}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.show_contact_details %}
          <div class="contact__info-section">
            <h2 class="contact__info-heading">{{ section.settings.contact_heading | default: 'Get in Touch' }}</h2>
            
            <ul class="contact__details">
              {% if section.settings.contact_email != blank %}
                <li class="contact__detail">
                  <a href="mailto:{{ section.settings.contact_email }}" class="contact__link">
                    {{ section.settings.contact_email }}
                  </a>
                </li>
              {% endif %}

              {% if section.settings.contact_phone != blank %}
                <li class="contact__detail">
                  <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}" class="contact__link">
                    {{ section.settings.contact_phone }}
                  </a>
                </li>
              {% endif %}
            </ul>
          </div>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="contact__info-section">
            <h2 class="contact__info-heading">{{ section.settings.social_heading | default: 'Follow Us' }}</h2>
            <div class="contact__social">
              {% if settings.social_instagram_link != blank %}
                <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram" class="contact__social-link">
                  {{ 'icon-instagram.svg' | inline_asset_content }}
                  <span class="visually-hidden">Instagram</span>
                </a>
              {% endif %}
              {% if settings.social_facebook_link != blank %}
                <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook" class="contact__social-link">
                  {{ 'icon-facebook.svg' | inline_asset_content }}
                  <span class="visually-hidden">Facebook</span>
                </a>
              {% endif %}
              {% if settings.social_pinterest_link != blank %}
                <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest" class="contact__social-link">
                  {{ 'icon-pinterest.svg' | inline_asset_content }}
                  <span class="visually-hidden">Pinterest</span>
                </a>
              {% endif %}
              {% if settings.social_tiktok_link != blank %}
                <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok" class="contact__social-link">
                  {{ 'icon-tiktok.svg' | inline_asset_content }}
                  <span class="visually-hidden">TikTok</span>
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .contact {
    background-color: var(--color-background);
    color: var(--color-foreground);
    margin-top: var(--spacing-xxl);
    margin-bottom: var(--spacing-xxl);
  }

  .contact__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .contact__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .contact__title {
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    margin: 0 0 var(--spacing-md);
  }

  @media (min-width: 768px) {
    .contact__title {
      font-size: 3rem;
    }
  }

  .contact__subheading {
    font-size: 1rem;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: var(--color-foreground-light);
    max-width: 560px;
    margin: 0 auto;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xxl);
    }
  }

  .contact__form-wrapper {
    background-color: var(--color-background-alt);
    padding: var(--spacing-lg);
    border-radius: var(--style-border-radius-inputs);
  }

  @media (min-width: 768px) {
    .contact__form-wrapper {
      padding: var(--spacing-xl);
    }
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .contact__label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .contact__input,
  .contact__textarea {
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: var(--spacing-sm) var(--spacing-md);
    font-family: inherit;
    transition: border-color var(--transition-fast),
                box-shadow var(--transition-fast);
  }

  .contact__input:focus,
  .contact__textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px var(--color-accent-light);
  }

  .contact__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact__button {
    margin-top: var(--spacing-sm);
    width: 100%;
    padding: var(--spacing-md) var(--spacing-lg);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    background-color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 2px;
    cursor: pointer;
    font-family: inherit;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast);
  }

  .contact__button:hover,
  .contact__button:focus {
    background-color: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    color: var(--color-foreground);
    outline: none;
  }

  .contact__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact__success {
    padding: var(--spacing-md);
    background-color: var(--color-accent-light);
    border-radius: var(--style-border-radius-inputs);
    color: var(--color-foreground);
    font-size: 1rem;
    line-height: 1.6;
  }

  .contact__errors {
    padding: var(--spacing-md);
    background-color: #F5E6E6;
    border-radius: var(--style-border-radius-inputs);
    color: var(--color-error);
    font-size: 1rem;
    line-height: 1.6;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .contact__info-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .contact__info-heading {
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .contact__address {
    font-size: 1rem;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: var(--color-foreground-light);
    font-style: normal;
    margin: 0;
  }

  .contact__hours {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .contact__hours-heading {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .contact__details {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .contact__detail {
    font-size: 1rem;
    line-height: 1.7;
  }

  .contact__link {
    color: var(--color-foreground-light);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact__link:hover,
  .contact__link:focus {
    color: var(--color-foreground);
    outline: none;
  }

  .contact__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact__social {
    display: flex;
    gap: var(--spacing-md);
  }

  .contact__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--color-foreground-light);
    background-color: var(--color-border);
    border-radius: 100px;
    transition: color var(--transition-fast),
                background-color var(--transition-fast);
  }

  .contact__social-link:hover,
  .contact__social-link:focus {
    color: var(--color-foreground);
    background-color: var(--color-accent);
    outline: none;
  }

  .contact__social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact__social-link svg {
    width: 20px;
    height: 20px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact__input,
    .contact__textarea,
    .contact__link,
    .contact__social-link {
      transition: border-color var(--transition-fast),
                  box-shadow var(--transition-fast),
                  color var(--transition-fast),
                  background-color var(--transition-fast);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We'd love to hear from you. Send us a message and we'll respond as soon as possible."
    },
    {
      "type": "header",
      "content": "Store Details"
    },
    {
      "type": "checkbox",
      "id": "show_store_details",
      "label": "Show store details",
      "default": true
    },
    {
      "type": "text",
      "id": "store_heading",
      "label": "Store heading",
      "default": "Visit Us"
    },
    {
      "type": "textarea",
      "id": "store_address",
      "label": "Store address",
      "default": "123 Queen Street\nAuckland, New Zealand"
    },
    {
      "type": "textarea",
      "id": "store_hours",
      "label": "Store hours",
      "default": "Monday - Friday: 9am - 6pm\nSaturday: 10am - 5pm\nSunday: Closed"
    },
    {
      "type": "header",
      "content": "Contact Details"
    },
    {
      "type": "checkbox",
      "id": "show_contact_details",
      "label": "Show contact details",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "hello@teaandtonic.co.nz"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone",
      "default": "+64 9 123 4567"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow Us"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 96,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 96,
      "unit": "px",
      "label": "Padding bottom"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
