{% comment %}
  Contact: one photo (optional), then everything centred. Email and phone are tap-to-use.
{% endcomment %}

<div class="contact" data-section-id="{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="contact__banner">
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '800, 1200, 1600, 2000', sizes: '100vw', class: 'contact__banner-image', alt: '' }}
    </div>
  {%- endif -%}

  <div class="contact__inner">
    <header class="contact__header">
      <h1 class="contact__title">{{ section.settings.heading | default: page.title | default: 'Contact' }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="contact__subheading">{{ section.settings.subheading | newline_to_br }}</p>
      {% endif %}
    </header>

    <div class="contact__info">
      {% if section.settings.show_contact_details %}
        {% if section.settings.contact_email != blank %}
          <p><span class="contact__label-inline">Email</span><br><a class="contact__inline-link" href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></p>
        {% endif %}
        {% if section.settings.contact_phone != blank %}
          <p><span class="contact__label-inline">Phone</span><br><a class="contact__inline-link" href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}">{{ section.settings.contact_phone }}</a><br>During store hours</p>
        {% endif %}
      {% endif %}

      {% if section.settings.show_store_details %}
        {% if section.settings.store_hours != blank %}
          <p><span class="contact__label-inline">Store hours</span><br>{{ section.settings.store_hours | newline_to_br | replace: 'Sunday to Friday:', 'Sunday – Friday |' | replace: 'Saturday:', 'Saturday |' }}</p>
        {% endif %}
        {% if section.settings.store_address != blank %}
          <p><span class="contact__label-inline">Address</span><br>{{ section.settings.store_address | replace: ', Matakana, New Zealand', '<br>Matakana 0985' | newline_to_br }}<br><a class="contact__inline-link" href="https://maps.google.com/?q=5A+2+Matakana+Valley+Road+Matakana" target="_blank" rel="noopener">Visit us</a></p>
        {% endif %}
      {% endif %}

      {% if section.settings.show_social %}
        <p class="contact__social">
          <span class="contact__label-inline">{{ section.settings.social_heading | default: 'Follow us' }}</span><br>
          {%- if settings.social_instagram_link != blank -%}<a class="contact__inline-link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
          {%- if settings.social_instagram_link != blank and settings.social_facebook_link != blank %} &nbsp;.&nbsp; {% endif -%}
          {%- if settings.social_facebook_link != blank -%}<a class="contact__inline-link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
        </p>
      {% endif %}
    </div>

    <div class="contact__form-wrapper">
      <h2 class="contact__form-heading">Send us a message</h2>
      {% render 'contact-form' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact {
    background-color: var(--color-background);
    color: var(--color-foreground);
    width: 100%;
    min-width: 0;
  }

  .contact__banner {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-border-light);
  }

  @media (min-width: 768px) {
    .contact__banner { aspect-ratio: 16 / 6; }
  }

  .contact__banner-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact__inner {
    max-width: 34rem;
    margin: 0 auto;
    padding: 44px 22px 56px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .contact__inner { padding: 72px 24px 88px; }
  }

  .contact__header { margin-bottom: 34px; }

  .contact__title {
    font-family: var(--font-body--family);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.4;
    margin: 0 0 22px;
  }

  .contact__subheading {
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
    margin: 0;
  }

  .contact__info p {
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
    margin: 0 0 18px;
  }

  .contact__label-inline {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .contact__inline-link {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .contact__inline-link:hover { opacity: 0.7; }

  .contact .contact__form-heading {
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 56px 0 12px;
  }

  .contact__form-wrapper { text-align: left; }
  .contact__form-wrapper .contact__form-heading { text-align: center; }

  .contact__form {
    display: grid;
    gap: 12px;
    max-width: 26.25rem;
    margin: 0 auto;
  }

  .contact__field { display: block; }

  .contact__input,
  .contact__textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #2f2f2f;
    border-radius: 0;
    background: transparent;
    padding: 13px 14px;
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.5;
    color: #2f2f2f;
    -webkit-appearance: none;
    appearance: none;
  }

  .contact__input::placeholder,
  .contact__textarea::placeholder {
    color: var(--color-foreground-light);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    opacity: 1;
  }

  .contact__input:focus-visible,
  .contact__textarea:focus-visible {
    outline: 1px solid #2f2f2f;
    outline-offset: 2px;
  }

  .contact__textarea {
    resize: vertical;
    min-height: 7.5rem;
  }

  .contact__button {
    width: 100%;
    margin-top: 8px;
    padding: 14px 34px;
    border: 1px solid #2f2f2f;
    border-radius: 0;
    background: transparent;
    color: #2f2f2f;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .contact__button:hover,
  .contact__button:focus-visible {
    background: #2f2f2f;
    color: var(--color-background);
    outline: none;
  }

  .contact__success,
  .contact__errors {
    padding: 14px 16px;
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: center;
  }

  .contact__success { background: #ede8df; }
  .contact__errors { background: #f5e6e6; color: var(--color-error, #8a3b3b); }
  .contact__success p, .contact__errors p, .contact__errors ul { margin: 0; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner photo",
      "info": "Optional photo across the top of the page, e.g. the Matakana store. Wide photos work best (about 4:3 on phones, 16:6 on desktop)."
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We'd love to hear from you. We reply within 1–2 working days."
    },
    {
      "type": "header",
      "content": "Store Details"
    },
    {
      "type": "checkbox",
      "id": "show_store_details",
      "label": "Show store details",
      "default": true
    },
    {
      "type": "text",
      "id": "store_heading",
      "label": "Store heading",
      "default": "Visit Us"
    },
    {
      "type": "textarea",
      "id": "store_address",
      "label": "Store address",
      "default": "5A, 2 Matakana Valley Road, Matakana, New Zealand"
    },
    {
      "type": "textarea",
      "id": "store_hours",
      "label": "Store hours",
      "default": "Sunday to Friday: 10am – 4pm\nSaturday: 9am – 5pm"
    },
    {
      "type": "header",
      "content": "Contact Details"
    },
    {
      "type": "checkbox",
      "id": "show_contact_details",
      "label": "Show contact details",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "hello@teaandtonic.co.nz"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone",
      "default": "09 422 9083"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": false
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow Us"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 96,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 96,
      "unit": "px",
      "label": "Padding bottom"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
