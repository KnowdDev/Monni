{% comment %}
  Monni Collection Page — Brand-aligned, hyper-converting, modular for collection-type customization
  seo-copy-sync-2026-08-17c
{% endcomment %}

{%- assign collection_type = collection.template_suffix | default: 'default' -%}

{%- assign collection_types = 'fragrance|beauty|homewares|clothing|jewellery' | split: '|' -%}
{%- for type in collection_types -%}
  {%- assign type_key = 'is_' | append: type -%}
  {%- if collection.tags contains type or collection_type contains type -%}
    {%- assign type_value = true -%}
  {%- else -%}
    {%- assign type_value = false -%}
  {%- endif -%}
  {%- assign renamed_variable__5b_type_key_5d_ = type_value -%}
{%- endfor -%}

<collection-page class="collection-page" data-section-id="{{ section.id }}" data-collection-id="{{ collection.id }}">
  <!-- seo-copy-sync-2026-08-17c -->
  <!-- Collection Header -->
  <header class="collection-page__header">
    <!-- Breadcrumb -->
    {%- if section.settings.show_breadcrumb and collection.handle != 'all' -%}
      {%- render 'breadcrumb-taxonomy', nav_class: 'collection-page__breadcrumb', collection: collection -%}
    {%- endif -%}

    <!-- Title -->
    {%- capture collection_display_title -%}{%- render 'monni-line-label', text: collection.title -%}{%- endcapture -%}
    {%- assign collection_display_title = collection_display_title | strip -%}
    {%- assign collection_eyebrow = blank -%}
    {%- assign collection_intro = blank -%}
    {%- if collection.handle == 'all' -%}
      {%- assign collection_display_title = 'The Collection' -%}
      {%- assign collection_intro = 'Considered pieces for slow living.' -%}
    {%- endif -%}
    {%- case collection.handle -%}
      {%- when 'wellness' -%}
        {%- assign collection_intro = 'Nourishment for the body and mind.' -%}
      {%- when 'beauty' -%}
        {%- assign collection_intro = 'What we place on our skin matters.' -%}
      {%- when 'clothing' -%}
        {%- assign collection_intro = 'Natural fibres. Worn for years, not for a moment.' -%}
      {%- when 'all-jewellery' or 'jewellery' -%}
        {%- assign collection_intro = 'Pieces to wear daily and treasure over time.' -%}
      {%- when 'all-home' or 'home' or 'homewares' -%}
        {%- assign collection_intro = 'Made to be lived with.' -%}
      {%- when 'all-gifting' or 'gifting' -%}
        {%- assign collection_intro = 'Chosen with intention. Wrapped with love.' -%}
    {%- endcase -%}
    {%- if collection_eyebrow != blank -%}
      <p class="collection-page__eyebrow">{{ collection_eyebrow }}</p>
    {%- endif -%}
    <h1 class="collection-page__title">{{ collection_display_title }}</h1>
    {% render 'collection-subnav', collection: collection %}

    {%- if collection_intro != blank -%}
      <p class="collection-page__intro">{{ collection_intro }}</p>
    {%- else -%}
      {%- assign top_line = collection.metafields.monni.top_line.value | default: collection.metafields.monni.top_line -%}
      {%- if top_line != blank and section.settings.show_top_line -%}
        {%- capture top_line_label -%}{%- render 'monni-line-label', text: top_line -%}{%- endcapture -%}
        <p class="collection-page__topline">{{ top_line_label | strip | escape }}</p>
      {%- endif -%}
    {%- endif -%}

    <!-- Product Count -->
    {%- if section.settings.show_product_count -%}
      <p class="collection-page__count">
        {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
      </p>
    {%- endif -%}
  </header>

  <!-- Collection Controls (Filtering & Sorting) -->
  {%- if section.settings.show_filters or section.settings.show_sort -%}
    <div class="collection-page__controls">
      {%- if section.settings.show_filters -%}
        <button type="button" class="collection-page__filter-toggle" data-filter-toggle aria-label="Open filters">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
            <line x1="4" y1="21" x2="4" y2="14"/>
            <line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/>
            <line x1="20" y1="12" x2="20" y2="3"/>
            <line x1="1" y1="14" x2="7" y2="14"/>
            <line x1="9" y1="8" x2="15" y2="8"/>
            <line x1="17" y1="16" x2="23" y2="16"/>
          </svg>
          Filter + Sort
        </button>
        <p class="collection-page__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
      {%- endif -%}

      {%- if section.settings.show_sort -%}
        <div class="collection-page__sort">
          <label for="SortBy-{{ section.id }}" class="collection-page__sort-label">sort</label>
          <select id="SortBy-{{ section.id }}" class="collection-page__sort-select" data-sort-select>
            <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
            <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>Alphabetical: A-Z</option>
            <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>Alphabetical: Z-A</option>
            <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
            <option value="created-ascending" {% if collection.sort_by == 'created-ascending' %}selected{% endif %}>Oldest</option>
            <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
          </select>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Collection Content -->
  <div class="collection-page__content">
    <!-- Filters Backdrop -->
    {%- if section.settings.show_filters -%}
      <div class="collection-page__filters-backdrop" data-filters-backdrop></div>
    {%- endif -%}

    <!-- Filters Drawer (slide-in from left) -->
    {%- if section.settings.show_filters -%}
      <aside class="collection-page__filters" data-filters>
        <div class="collection-page__filters-header">
          <h2>Filter</h2>
          <button type="button" class="collection-page__filters-close" data-filters-close aria-label="Close filters">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <form action="{{ request.path }}" method="get" class="collection-page__filters-form">
          <details class="collection-page__filter-group" open>
            <summary class="collection-page__filter-title">Sort</summary>
            <div class="collection-page__filter-options">
              <label class="collection-page__filter-label"><input type="radio" name="sort_by" value="manual" {% if collection.sort_by == 'manual' or collection.sort_by == blank %}checked{% endif %}> Featured</label>
              <label class="collection-page__filter-label"><input type="radio" name="sort_by" value="created-descending" {% if collection.sort_by == 'created-descending' %}checked{% endif %}> Newest</label>
              <label class="collection-page__filter-label"><input type="radio" name="sort_by" value="price-ascending" {% if collection.sort_by == 'price-ascending' %}checked{% endif %}> Price low to high</label>
              <label class="collection-page__filter-label"><input type="radio" name="sort_by" value="price-descending" {% if collection.sort_by == 'price-descending' %}checked{% endif %}> Price high to low</label>
            </div>
          </details>
          {%- for filter in collection.filters -%}
            <details class="collection-page__filter-group">
              <summary class="collection-page__filter-title">{{ filter.label }}</summary>
              <div class="collection-page__filter-options">
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    <ul class="collection-page__filter-list">
                      {%- for filter_value in filter.values -%}
                        {%- liquid
                          assign value_down = filter_value.label | downcase | strip
                          assign skip_value = false
                          if value_down == 'pillows' or value_down == 'not specified' or value_down == 'monni' or value_down == 'monique jansen art' or value_down == 'art'
                            assign skip_value = true
                          endif
                          if value_down == 'b' or value_down == 'g' or value_down contains 'water-resistant' or value_down contains 'water resistant'
                            assign skip_value = true
                          endif
                          assign filter_label_down = filter.label | downcase
                          assign home_handles = 'all-home,home,homewares,ceramics,ceramics-shop,crystals-and-rituals,home-care,monni-art,teaware,pantry'
                          if filter_label_down contains 'color' or filter_label_down contains 'colour'
                            unless home_handles contains collection.handle
                              assign skip_value = true
                            endunless
                          endif
                        -%}
                        {%- unless skip_value -%}
                        <li class="collection-page__filter-item">
                          <label class="collection-page__filter-label">
                            <input type="checkbox" 
                                   name="{{ filter.param_name }}" 
                                   value="{{ filter_value.value }}" 
                                   {% if filter_value.active %}checked{% endif %}
                                   class="collection-page__filter-input">
                            <span class="collection-page__filter-swatch"></span>
                            <span>{{ filter_value.label }}</span>
                            <span class="collection-page__filter-count">({{ filter_value.count }})</span>
                          </label>
                        </li>
                        {%- endunless -%}
                      {%- endfor -%}
                    </ul>
                  {%- when 'price_range' -%}
                    <div class="collection-page__filter-price">
                      <div class="collection-page__filter-price-inputs">
                        <div>
                          <label for="FilterPriceFrom-{{ section.id }}" class="visually-hidden">From</label>
                          <input type="number" 
                                 id="FilterPriceFrom-{{ section.id }}" 
                                 name="{{ filter.min_value.param_name }}" 
                                 value="{{ filter.min_value.value | default: '' }}" 
                                 min="20"
                                 placeholder="20"
                                 class="collection-page__filter-price-input">
                        </div>
                        <span>—</span>
                        <div>
                          <label for="FilterPriceTo-{{ section.id }}" class="visually-hidden">To</label>
                          <input type="number" 
                                 id="FilterPriceTo-{{ section.id }}" 
                                 name="{{ filter.max_value.param_name }}" 
                                 value="{{ filter.max_value.value | default: '' }}" 
                                 min="20"
                                 placeholder="250"
                                 class="collection-page__filter-price-input">
                        </div>
                      </div>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}

          <div class="collection-page__filters-footer">
            <button type="submit" class="collection-page__filters-apply btn btn--outline" data-filters-apply>Show {{ collection.products_count }} products</button>
            <button type="button" class="collection-page__filters-clear" data-filters-clear>Clear All</button>
          </div>
        </form>
      </aside>
    {%- endif -%}

    <!-- Product Grid -->
    <div class="collection-page__products">
      {%- if collection.products.size > 0 -%}
        {%- paginate collection.products by section.settings.products_per_page -%}
          <div class="collection-page__grid" data-grid-columns="{{ section.settings.grid_columns }}" data-card-aspect-ratio="{{ section.settings.card_aspect_ratio }}">
            {%- for product in collection.products -%}
              {%- render 'card-product',
                card_product: product,
                aspect_ratio: section.settings.card_aspect_ratio,
                show_quick_add: section.settings.show_quick_add,
                show_wishlist: false,
                show_badges: false,
                first_eager: forloop.first
              -%}
            {%- endfor -%}
          </div>

          {%- if paginate.next -%}
            <p class="collection-page__load">
              <button type="button" class="btn btn--outline" data-load-more data-next="{{ paginate.next.url }}">Load more</button>
            </p>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="collection-page__empty">
          <p class="collection-page__empty-text">No products found in this collection.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue Shopping</a>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- assign bottom_intro = collection.metafields.monni.bottom_intro -%}
  {%- if bottom_intro != blank and section.settings.show_bottom_intro -%}
    <section class="collection-page__bottom-intro">
      <div class="collection-page__bottom-intro-content rte">
        {%- capture bottom_intro_html -%}{{ bottom_intro | metafield_tag }}{%- endcapture -%}
        {%- render 'monni-line-label', text: bottom_intro_html -%}
      </div>
    </section>
  {%- endif -%}
</collection-page>

<script>
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-load-more]');
    if (!button) return;
    var next = button.getAttribute('data-next');
    var grid = document.querySelector('.collection-page__grid');
    if (!next || !grid) return;
    button.disabled = true;
    fetch(next)
      .then(function (res) { return res.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        doc.querySelectorAll('.collection-page__grid > *').forEach(function (card) { grid.appendChild(card); });
        var more = doc.querySelector('[data-load-more]');
        if (more) {
          button.setAttribute('data-next', more.getAttribute('data-next'));
          button.disabled = false;
        } else {
          button.remove();
        }
      })
      .catch(function () { button.disabled = false; });
  });
</script>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_top_line",
      "label": "Show top line (above products)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_intro",
      "label": "Show bottom intro (below products)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort options",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "Grid columns (desktop)",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "card_aspect_ratio",
      "label": "Product card aspect ratio",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "portrait"
    }
  ]
}
{% endschema %}
