{%- liquid
  assign free_shipping_threshold = settings.cart_free_shipping_threshold | default: 250
-%}
<cart-drawer
  class="cart-drawer"
  data-section-id="{{ section.id }}"
  data-shipping-threshold="{{ free_shipping_threshold }}"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.drawer.title' | t | default: 'Your cart' }}"
>
  <div class="cart-drawer__backdrop" data-cart-drawer-backdrop></div>

  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Cart (<span data-cart-count>{{ cart.item_count }}</span>)</h2>
      <button
        type="button"
        class="cart-drawer__close"
        data-cart-drawer-close
        aria-label="{{ 'cart.drawer.close' | t | default: 'Close cart' }}"
      >
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    <div class="cart-drawer__scroll" data-cart-drawer-body>
      <div class="cart-drawer__items" data-cart-drawer-items {% unless cart.item_count > 0 %}hidden{% endunless %}>
        {%- for item in cart.items -%}
          {%- if item.product.handle == 'gift-wrap' or item.title == 'Gift Wrap' -%}{%- continue -%}{%- endif -%}
          <div class="cart-drawer__item" data-cart-item data-line="{{ forloop.index }}" data-variant-id="{{ item.variant.id }}">
            <div class="cart-drawer__item-image">
              <a href="{{ item.url }}">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 160 }}"
                    srcset="
                      {{ item.image | image_url: width: 80 }} 80w,
                      {{ item.image | image_url: width: 160 }} 160w
                    "
                    sizes="80px"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="cart-drawer__item-image-placeholder">{{ item.product.title | escape | slice: 0 }}</div>
                {%- endif -%}
              </a>
            </div>

            <div class="cart-drawer__item-details"{% if item.product.tags contains 'made-to-order' or item.product.tags contains 'made to order' %} data-mto{% endif %}>
              <div class="cart-drawer__item-row">
                <a href="{{ item.url }}" class="cart-drawer__item-title">
                  {%- unless item.product.vendor == blank or item.product.vendor == 'Tea & Tonic' -%}{{ item.product.vendor | escape }} {% endunless -%}{{ item.product.title | replace: 'Tea & Tonic Matakana', '' | strip | escape }}
                </a>
                <div class="cart-drawer__item-price">{{ item.final_line_price | money }}</div>
              </div>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="cart-drawer__item-variant">{{ item.variant.title | escape }}</p>
              {%- endunless -%}
              {%- if item.product.tags contains 'made-to-order' or item.product.tags contains 'made to order' -%}
                <p class="cart-drawer__item-mto">Made to order. Ships within 4 weeks.</p>
              {%- endif -%}
            </div>

            <div class="cart-drawer__item-actions">
              <div class="cart-drawer__item-quantity">
                <button type="button" data-quantity-decrease aria-label="{{ 'cart.drawer.decrease_quantity' | t | default: 'Decrease quantity' }}">−</button>
                <input
                  type="number"
                  name="quantity"
                  value="{{ item.quantity }}"
                  min="0"
                  data-quantity-input
                  aria-label="{{ 'cart.drawer.quantity' | t | default: 'Quantity' }}"
                >
                <button type="button" data-quantity-increase aria-label="{{ 'cart.drawer.increase_quantity' | t | default: 'Increase quantity' }}">+</button>
              </div>
              <button
                type="button"
                class="cart-drawer__item-remove"
                data-cart-remove
                aria-label="{{ 'cart.drawer.remove' | t | default: 'Remove' }} {{ item.product.title | escape }}"
              >
                Remove
              </button>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="cart-drawer__empty" data-cart-drawer-empty {% if cart.item_count > 0 %}hidden{% endif %}>
        <p>Your cart is empty.</p>
        <p class="cart-drawer__empty-note">Free NZ shipping on orders over $250.</p>
        <a href="/collections/all" class="btn btn--outline">Shop the collection</a>
      </div>

      {%- if section.settings.show_free_shipping_bar or section.settings.enable_gift_note -%}
      <div class="cart-drawer__scroll-extras" data-cart-drawer-scroll-extras {% unless cart.item_count > 0 %}hidden{% endunless %}>
        {%- if section.settings.show_free_shipping_bar -%}
          {%- assign threshold_cents = free_shipping_threshold | times: 100 -%}
          {%- assign progress = cart.total_price | times: 100 | divided_by: threshold_cents -%}
          {%- if progress > 100 -%}{%- assign progress = 100 -%}{%- endif -%}

          <div class="cart-drawer__shipping" data-cart-drawer-shipping>
            <div class="cart-drawer__shipping-label" data-cart-drawer-shipping-label>
              {%- if cart.total_price >= threshold_cents -%}
                Your order ships free within NZ.
              {%- else -%}
                {%- assign remaining = threshold_cents | minus: cart.total_price | money -%}
                Spend {{ remaining }} more for free NZ shipping.
              {%- endif -%}
            </div>
            <div class="cart-drawer__shipping-bar">
              <div class="cart-drawer__shipping-progress" style="width: {{ progress }}%" data-cart-drawer-shipping-progress></div>
            </div>
          </div>
        {%- endif -%}

        <label class="cart-drawer__gift">
          <input type="checkbox" data-gift-toggle {% if cart.note != blank %}checked{% endif %}>
          This is a gift
        </label>
        <p class="cart-drawer__gift-help">We'll gift wrap it for you.</p>
        <textarea
          class="cart-drawer__note-input"
          name="note"
          data-cart-note
          placeholder="Gift message"
          {% if cart.note == blank %}hidden{% endif %}
        >{{ cart.note | escape }}</textarea>
      </div>
      {%- endif -%}
    </div>

    <div class="cart-drawer__footer" data-cart-drawer-footer {% unless cart.item_count > 0 %}hidden{% endunless %}>
        <div class="cart-drawer__totals">
          <div class="cart-drawer__subtotal">
            <span>{{ 'cart.drawer.subtotal' | t | default: 'Subtotal' }}</span>
            <span data-cart-drawer-subtotal>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-drawer__tax-note">Shipping and discount codes are added at checkout.</p>
        </div>

        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout">
          <button type="submit" name="checkout" class="btn btn--primary cart-drawer__checkout-btn">
            {{ 'cart.drawer.checkout' | t | default: 'Checkout' }}
          </button>
        </form>
        <p class="cart-drawer__afterpay">Or 4 payments of <span data-cart-afterpay>{{ cart.total_price | divided_by: 4 | money }}</span> with Afterpay</p>
      </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "class": "section-cart-drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_cart_drawer",
      "label": "Enable cart drawer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping_bar",
      "label": "Show free shipping progress bar",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "default": 250,
      "info": "Amount in your store currency. Overridden by Theme settings → Cart → Free shipping threshold when set."
    },
    {
      "type": "checkbox",
      "id": "enable_gift_note",
      "label": "Enable gift note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_express_checkout",
      "label": "Show Shop Pay / express checkout in cart drawer",
      "default": false,
      "info": "Leave off unless Shop Pay is fully enabled. Reduces console errors from wallet scripts."
    }
  ]
}
{% endschema %}
