{% comment %}
  About MONNI page — vertical editorial layout aligned with the original
  Tea & Tonic about page (centred copy, image gallery, stacked sections on mobile).
{% endcomment %}

<section
  class="about-monni section--padding"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="about-monni__inner">
    <header class="about-monni__page-header">
      {% if section.settings.hero_eyebrow != blank %}
        <p class="about-monni__eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {% endif %}
      {% if section.settings.hero_title != blank %}
        <p class="about-monni__tagline">{{ section.settings.hero_title }}</p>
      {% endif %}
    </header>

    <article class="about-monni__block about-monni__block--center">
      {% if section.settings.story_heading != blank %}
        <h2 class="about-monni__heading">{{ section.settings.story_heading }}</h2>
      {% endif %}
      <div class="about-monni__richtext">{{ section.settings.story_body }}</div>
    </article>

    {% liquid
      assign gallery_count = 0
      if section.settings.gallery_image_1 != blank
        assign gallery_count = gallery_count | plus: 1
      endif
      if section.settings.gallery_image_2 != blank
        assign gallery_count = gallery_count | plus: 1
      endif
      if section.settings.gallery_image_3 != blank
        assign gallery_count = gallery_count | plus: 1
      endif
    %}
    {% if gallery_count > 0 %}
      <div class="about-monni__gallery" data-count="{{ gallery_count }}">
        {% for i in (1..3) %}
          {% liquid
            case i
              when 1
                assign gallery_image = section.settings.gallery_image_1
              when 2
                assign gallery_image = section.settings.gallery_image_2
              when 3
                assign gallery_image = section.settings.gallery_image_3
            endcase
          %}
          {% if gallery_image != blank %}
            <div class="about-monni__gallery-item">
              {{
                gallery_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 960, 1200',
                  sizes: '(min-width: 900px) 33vw, 100vw',
                  alt: gallery_image.alt
              }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <article class="about-monni__block about-monni__block--center">
      {% if section.settings.offer_heading != blank %}
        <h2 class="about-monni__heading">{{ section.settings.offer_heading }}</h2>
      {% endif %}
      <div class="about-monni__richtext">{{ section.settings.offer_body }}</div>
    </article>

    <article class="about-monni__row about-monni__row--media-right">
      <div class="about-monni__row-copy">
        {% if section.settings.creations_heading != blank %}
          <h2 class="about-monni__heading">{{ section.settings.creations_heading }}</h2>
        {% endif %}
        <div class="about-monni__richtext">{{ section.settings.creations_body }}</div>
      </div>
      {% if section.settings.creations_image != blank %}
        <div class="about-monni__row-media">
          {{
            section.settings.creations_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 900px) 40vw, 100vw',
              alt: section.settings.creations_image.alt
          }}
        </div>
      {% endif %}
    </article>

    <article class="about-monni__row about-monni__row--media-right">
      <div class="about-monni__row-copy">
        {% if section.settings.space_heading != blank %}
          <h2 class="about-monni__heading">{{ section.settings.space_heading }}</h2>
        {% endif %}
        <div class="about-monni__richtext">{{ section.settings.space_body }}</div>
      </div>
      {% if section.settings.space_image != blank %}
        <div class="about-monni__row-media">
          {{
            section.settings.space_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 900px) 40vw, 100vw',
              alt: section.settings.space_image.alt
          }}
        </div>
      {% endif %}
    </article>

    <article class="about-monni__block about-monni__block--center">
      {% if section.settings.values_heading != blank %}
        <h2 class="about-monni__heading">{{ section.settings.values_heading }}</h2>
      {% endif %}
      {% if section.settings.values_intro != blank %}
        <div class="about-monni__richtext about-monni__values-intro">{{ section.settings.values_intro }}</div>
      {% endif %}
    </article>

    <div class="about-monni__values">
      {% for block in section.blocks %}
        {% if block.type == 'value_row' %}
          <article
            class="about-monni__row{% if block.settings.image_position == 'right' %} about-monni__row--reverse{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="about-monni__row-copy">
              {% if block.settings.title != blank %}
                <h2 class="about-monni__heading">{{ block.settings.title }}</h2>
              {% endif %}
              <div class="about-monni__richtext">{{ block.settings.body }}</div>
            </div>
            {% if block.settings.image != blank %}
              <div class="about-monni__row-media">
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 900px) 40vw, 100vw',
                    alt: block.settings.image.alt
                }}
              </div>
            {% endif %}
          </article>
        {% elsif block.type == 'value' %}
          <article class="about-monni__value about-monni__block--center" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}
              <h3 class="about-monni__subheading">{{ block.settings.title }}</h3>
            {% endif %}
            <div class="about-monni__richtext about-monni__value-body">{{ block.settings.body }}</div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <article class="about-monni__block about-monni__founder about-monni__block--center">
      {% if section.settings.founder_heading != blank %}
        <h2 class="about-monni__heading">{{ section.settings.founder_heading }}</h2>
      {% endif %}
      {% if section.settings.founder_pepeha != blank %}
        <div class="about-monni__pepeha about-monni__richtext">{{ section.settings.founder_pepeha }}</div>
      {% endif %}
      <div class="about-monni__richtext">{{ section.settings.founder_body }}</div>
      {% if section.settings.founder_signoff != blank %}
        <p class="about-monni__signoff">{{ section.settings.founder_signoff }}</p>
      {% endif %}
    </article>

    {% if section.settings.show_visit %}
      <article class="about-monni__block about-monni__visit about-monni__block--center">
        {% if section.settings.visit_heading != blank %}
          <h2 class="about-monni__heading">{{ section.settings.visit_heading }}</h2>
        {% endif %}
        {% if section.settings.visit_address != blank %}
          <p class="about-monni__visit-line">{{ section.settings.visit_address }}</p>
        {% endif %}
        {% if section.settings.visit_phone != blank %}
          <p class="about-monni__visit-line">
            <a href="tel:{{ section.settings.visit_phone | replace: ' ', '' }}">{{ section.settings.visit_phone }}</a>
          </p>
        {% endif %}
        {% if section.settings.visit_hours != blank %}
          <div class="about-monni__richtext about-monni__visit-hours">{{ section.settings.visit_hours }}</div>
        {% endif %}
      </article>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .about-monni {
    background: var(--color-background);
    color: var(--color-foreground);
    --about-inline-padding: clamp(1.25rem, 4.5vw, var(--page-margin));
  }

  .about-monni__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding-inline: var(--about-inline-padding);
    display: grid;
    gap: clamp(2.25rem, 6vw, 4rem);
  }

  .about-monni__page-header,
  .about-monni__block--center,
  .about-monni__founder,
  .about-monni__visit {
    text-align: center;
  }

  .about-monni__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 var(--spacing-sm);
    color: var(--color-foreground-muted);
  }

  .about-monni__tagline {
    margin: 0 auto;
    max-width: 34ch;
    font-size: clamp(1.35rem, 4vw, 2rem);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
  }

  .about-monni__heading {
    margin: 0 0 clamp(1rem, 3vw, 1.5rem);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    font-weight: 350;
    color: var(--color-foreground);
  }

  .about-monni__subheading {
    margin: 0 0 0.75rem;
    font-size: clamp(1.1rem, 2.8vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
  }

  .about-monni__richtext :is(p, ul, ol) {
    margin: 0 0 var(--spacing-md);
    color: var(--color-foreground);
    line-height: 1.75;
    letter-spacing: 0.01em;
  }

  .about-monni__richtext :is(p, ul, ol):last-child {
    margin-bottom: 0;
  }

  .about-monni__richtext ul,
  .about-monni__richtext ol {
    padding-left: 1.2rem;
    text-align: left;
    display: inline-block;
  }

  .about-monni__block--center .about-monni__richtext {
    max-width: 52rem;
    margin-inline: auto;
  }

  .about-monni__gallery {
    display: grid;
    gap: var(--spacing-sm);
    grid-template-columns: 1fr;
  }

  .about-monni__gallery-item {
    overflow: hidden;
    background: var(--color-border-light);
  }

  .about-monni__gallery-item img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .about-monni__row {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (max-width: 899px) {
    .about-monni__row--media-right .about-monni__row-media {
      margin-top: var(--spacing-xs);
    }
  }

  .about-monni__row-copy {
    display: grid;
    gap: 0;
  }

  .about-monni__row-media {
    overflow: hidden;
    background: var(--color-border-light);
  }

  .about-monni__row-media img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .about-monni__values {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .about-monni__value {
    display: grid;
    gap: 0.75rem;
  }

  .about-monni__values-intro {
    margin-top: 0;
  }

  .about-monni__pepeha {
    margin-bottom: var(--spacing-lg);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    line-height: 1.62;
  }

  .about-monni__signoff {
    margin: var(--spacing-lg) 0 0;
    font-style: italic;
    color: var(--color-foreground);
  }

  .about-monni__visit-line {
    margin: 0 0 var(--spacing-sm);
    line-height: 1.6;
  }

  .about-monni__visit-line a {
    color: inherit;
    text-decoration: none;
  }

  .about-monni__visit-line a:hover {
    text-decoration: underline;
  }

  .about-monni__visit-hours {
    margin-top: var(--spacing-sm);
  }

  @media (min-width: 900px) {
    .about-monni__inner {
      --about-inline-padding: var(--page-margin);
    }

    .about-monni__gallery[data-count='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-md);
    }

    .about-monni__gallery[data-count='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-monni__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .about-monni__row--reverse .about-monni__row-copy {
      order: 2;
    }

    .about-monni__row--reverse .about-monni__row-media {
      order: 1;
    }

    .about-monni__row-copy {
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Monni",
  "tag": "section",
  "class": "section-about-monni",
  "settings": [
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "ABOUT MONNI"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Tagline",
      "default": "A place to pause. A place to reconnect. A place to feel inspired by beauty, nature, and thoughtful living."
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Story content"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_1",
      "label": "Gallery image 1"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_2",
      "label": "Gallery image 2"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_3",
      "label": "Gallery image 3"
    },
    {
      "type": "text",
      "id": "offer_heading",
      "label": "Offer heading",
      "default": "What We Offer"
    },
    {
      "type": "richtext",
      "id": "offer_body",
      "label": "Offer content"
    },
    {
      "type": "text",
      "id": "creations_heading",
      "label": "Creations heading",
      "default": "Our Own Creations"
    },
    {
      "type": "richtext",
      "id": "creations_body",
      "label": "Creations content"
    },
    {
      "type": "image_picker",
      "id": "creations_image",
      "label": "Creations image"
    },
    {
      "type": "text",
      "id": "space_heading",
      "label": "Space heading",
      "default": "The Space"
    },
    {
      "type": "richtext",
      "id": "space_body",
      "label": "Space content"
    },
    {
      "type": "image_picker",
      "id": "space_image",
      "label": "Space image"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Values heading",
      "default": "Our Values"
    },
    {
      "type": "richtext",
      "id": "values_intro",
      "label": "Values intro (optional)"
    },
    {
      "type": "text",
      "id": "founder_heading",
      "label": "Founder heading",
      "default": "Our Founder"
    },
    {
      "type": "richtext",
      "id": "founder_pepeha",
      "label": "Founder pepeha"
    },
    {
      "type": "richtext",
      "id": "founder_body",
      "label": "Founder content"
    },
    {
      "type": "text",
      "id": "founder_signoff",
      "label": "Founder signoff",
      "default": "Aroha nui, Monni and the MONNI team"
    },
    {
      "type": "header",
      "content": "Visit in store"
    },
    {
      "type": "checkbox",
      "id": "show_visit",
      "label": "Show visit details",
      "default": true
    },
    {
      "type": "text",
      "id": "visit_heading",
      "label": "Visit heading",
      "default": "Visit us instore"
    },
    {
      "type": "text",
      "id": "visit_address",
      "label": "Address",
      "default": "5A, 2 Matakana Valley Road, Matakana, New Zealand"
    },
    {
      "type": "text",
      "id": "visit_phone",
      "label": "Phone",
      "default": "Tel. +6421975102"
    },
    {
      "type": "richtext",
      "id": "visit_hours",
      "label": "Opening hours",
      "default": "<p>Monday - Friday: 9am - 6pm<br>Saturday: 10am - 5pm<br>Sunday: Closed</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "value_row",
      "name": "Value with image",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position on desktop",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "value",
      "name": "Value (text only)",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Monni"
    }
  ]
}
{% endschema %}
