<section class="newsletter" data-section-id="{{ section.id }}" data-animate>
  <div class="newsletter__inner">
    {% if section.settings.title != blank %}
      <h2 class="newsletter__title">{{ section.settings.title | escape }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="newsletter__description">{{ section.settings.description | escape }}</p>
    {% endif %}

    {% form 'customer', class: 'newsletter__form' %}
      {% if form.posted_successfully? %}
        <p class="newsletter__message newsletter__message--success" role="status">
          {{ section.settings.success_message | default: 'Thank you for subscribing.' }}
        </p>
      {% elsif form.errors %}
        <p class="newsletter__message newsletter__message--error" role="alert">
          {{ form.errors.messages['form'] }}
        </p>
      {% endif %}

      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="newsletter__fields">
        <div class="newsletter__field newsletter__field--name newsletter__field--first-name">
          <label for="newsletter-first-name-{{ section.id }}" class="sr-only">
            {{ section.settings.first_name_label | default: 'First name' }}
          </label>
          <input
            id="newsletter-first-name-{{ section.id }}"
            type="text"
            name="contact[first_name]"
            placeholder="{{ section.settings.first_name_placeholder | escape }}"
            required
            autocomplete="given-name"
            class="newsletter__input"
          >
        </div>

        {% if section.settings.collect_last_name %}
          <div class="newsletter__field newsletter__field--name newsletter__field--last-name">
            <label for="newsletter-last-name-{{ section.id }}" class="sr-only">
              {{ section.settings.last_name_label | default: 'Last name' }}
            </label>
            <input
              id="newsletter-last-name-{{ section.id }}"
              type="text"
              name="contact[last_name]"
              placeholder="{{ section.settings.last_name_placeholder | escape }}"
              autocomplete="family-name"
              class="newsletter__input"
            >
          </div>
        {% endif %}

        <div class="newsletter__field newsletter__field--email">
          <label for="newsletter-email-{{ section.id }}" class="sr-only">
            {{ section.settings.email_label | default: 'Email address' }}
          </label>
          <input
            id="newsletter-email-{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | escape }}"
            required
            autocomplete="email"
            autocapitalize="off"
            class="newsletter__input"
          >
        </div>
      </div>

      <div class="newsletter__actions">
        <button type="submit" class="newsletter__button">
          {{ section.settings.button_label | default: 'Subscribe' | escape }}
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .newsletter {
    padding: var(--spacing-xxl) 0;
    text-align: center;
  }

  .newsletter__inner {
    grid-column: 2;
    max-width: 60ch;
    margin: 0 auto;
  }

  .newsletter__title {
    margin-bottom: var(--spacing-sm);
    font-weight: 300;
  }

  .newsletter__description {
    font-size: 1rem;
    color: var(--color-foreground-light);
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
  }

  .newsletter__form {
    width: 100%;
  }

  .newsletter__message {
    font-size: 0.875rem;
    margin-bottom: var(--spacing-sm);
  }

  .newsletter__message--success { color: var(--color-foreground-light); }
  .newsletter__message--error { color: var(--color-error); }

  .newsletter__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      "first-name last-name"
      "email email";
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .newsletter__field {
    min-width: 0;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--spacing-xs);
  }

  .newsletter__field--first-name { grid-area: first-name; }
  .newsletter__field--last-name { grid-area: last-name; }
  .newsletter__field--email { grid-area: email; }

  .newsletter__input {
    width: 100%;
    border: none;
    background: transparent;
    padding: var(--spacing-sm) 0;
    font-size: 1rem;
    color: var(--color-foreground);
  }

  .newsletter__input:focus {
    outline: none;
    border: none;
  }

  .newsletter__input::placeholder {
    color: var(--color-foreground-muted);
  }

  .newsletter__button {
    width: 100%;
    padding: 0.95rem var(--spacing-md);
    font-size: var(--text-cta);
    border: 1px solid var(--color-foreground);
    color: var(--color-background-alt);
    cursor: pointer;
    white-space: nowrap;
    text-align: center;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .newsletter__actions {
    display: block;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--spacing-sm);
  }

  .newsletter__button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-background-alt);
  }

  @media (max-width: 480px) {
    .newsletter__inner {
      max-width: 100%;
    }

    .newsletter__fields {
      gap: var(--spacing-xs);
    }

    .newsletter__input {
      font-size: 0.95rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Stay connected"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Receive quiet notes on new arrivals, seasonal rituals, and thoughtful stories."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "first_name_placeholder",
      "label": "First name placeholder",
      "default": "First name"
    },
    {
      "type": "checkbox",
      "id": "collect_last_name",
      "label": "Collect last name",
      "default": true
    },
    {
      "type": "text",
      "id": "last_name_placeholder",
      "label": "Last name placeholder",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email input label (screen readers)",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First name input label (screen readers)",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last name input label (screen readers)",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing."
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
