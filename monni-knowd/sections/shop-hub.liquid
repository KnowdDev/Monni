      "label": "Show curated edits",
      "default": true
    },
    {
      "type": "text",
      "id": "edits_title",
      "label": "Edits title",
      "default": "Start here"
    },
    {
      "type": "text",
      "id": "edit_one_label",
      "label": "Edit one label",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "edit_one_note",
      "label": "Edit one note",
      "default": "Fresh pieces from the store floor"
    },
    {
      "type": "url",
      "id": "edit_one_link",
      "label": "Edit one link"
    },
    {
      "type": "text",
      "id": "edit_two_label",
      "label": "Edit two label",
      "default": "Gift card"
    },
    {
      "type": "text",
      "id": "edit_two_note",
      "label": "Edit two note",
      "default": "Let them choose something meaningful"
    },
    {
      "type": "url",
      "id": "edit_two_link",
      "label": "Edit two link"
    },
    {
      "type": "text",
      "id": "edit_three_label",
      "label": "Edit three label",
      "default": "Our brands"
    },
    {
      "type": "text",
      "id": "edit_three_note",
      "label": "Edit three note",
      "default": "Meet the makers behind MONNI"
    },
    {
      "type": "url",
      "id": "edit_three_link",
      "label": "Edit three link"
    }
  ],
  "presets": [
    {
      "name": "Shop hub",
      "category": "Pages"
    }
