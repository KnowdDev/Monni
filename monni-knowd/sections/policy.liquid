{% comment %}
  Policy page section
  Renders Shopify policies (terms, privacy, shipping, refunds) with premium typography.
{% endcomment %}

{%- liquid
  assign policy_handle = request.path | split: '/' | last
  assign policy_display_title = 'Policy'
  assign policy_body = blank

  comment
    When this section is rendered from theme.liquid (Shopify ignores
    templates/policy.liquid), the global `policy` object has no body.
    Pull content from shop.*_policy / shop.policies instead.
  endcomment

  case policy_handle
    when 'privacy-policy'
      assign policy_display_title = 'Privacy Policy'
      assign policy_body = shop.privacy_policy.body
    when 'terms-of-service'
      assign policy_display_title = 'Terms + Conditions'
      assign policy_body = shop.terms_of_service.body
    when 'refund-policy'
      assign policy_display_title = 'Returns'
      assign policy_body = shop.refund_policy.body
    when 'shipping-policy'
      assign policy_display_title = 'Shipping + Delivery'
      assign policy_body = shop.shipping_policy.body
    when 'contact-information'
      assign policy_display_title = 'Contact'
      if shop.contact_information
        assign policy_body = shop.contact_information.body
      endif
  endcase

  if policy_body == blank
    for shop_policy in shop.policies
      assign shop_policy_handle = shop_policy.url | split: '/' | last
      if shop_policy_handle == policy_handle
        if policy_display_title == 'Policy'
          assign policy_display_title = shop_policy.title
        endif
        assign policy_body = shop_policy.body
        break
      endif
    endfor
  endif
-%}

<section class="policy section--padding full-width" data-section-id="{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="policy__inner container">
    <header class="policy__header">
      <h1 class="policy__title">{{ policy_display_title }}</h1>
    </header>

    <div class="policy__content rte">
      {{ policy_body }}
    </div>

    <p class="policy__legal">Ayson and Anastasia Limited trading as Tea &amp; Tonic</p>
  </div>
</section>

{% stylesheet %}
  .policy {
    background-color: var(--color-background);
    color: #2f2f2f;
    margin-top: 0;
    margin-bottom: 0;
  }

  .policy__inner {
    max-width: 105rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
  }

  .policy__header {
    text-align: center;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .policy .policy__title {
    font-family: var(--font-body--family);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
    color: #2f2f2f;
  }

  .policy__legal {
    max-width: 38rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: #6b6965;
  }

  .policy__content {
    max-width: 38rem;
    margin: 0 auto;
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0;
    color: #2f2f2f;
  }

  .policy__content :is(p, ul, ol) {
    margin: 0 0 1rem;
  }

  .policy__content p:empty,
  .policy__content p:has(> br:only-child),
  .policy__content p:has(> span:only-child > br:only-child) {
    display: none;
  }

  .policy__content strong,
  .policy__content b {
    font-weight: 400;
  }

  .policy__content :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--font-body--family);
    color: #2f2f2f;
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.5;
    margin: 2rem 0 0.6rem;
  }

  .policy__content :is(h1, h2, h3, h4, h5, h6):first-child { margin-top: 0; }

  .policy__content a {
    color: #2f2f2f;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .policy__content a:hover,
  .policy__content a:focus-visible {
    color: #6b6965;
  }

  .policy__content ul,
  .policy__content ol {
    padding-left: 1.25rem;
  }

  .policy__content li {
    margin-bottom: 0.35rem;
  }

  .policy__content hr {
    border: 0;
    height: 1px;
    background: #dcd9d3;
    margin: 2rem 0;
  }

  .policy__content table { width: 100%; display: block; overflow-x: auto; }

  .policy__content blockquote {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 1px solid #2f2f2f;
    color: #6b6965;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy",
  "tag": "section",
  "class": "section-policy",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Policy"
    }
  ]
}
{% endschema %}

