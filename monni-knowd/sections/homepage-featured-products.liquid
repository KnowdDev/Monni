{% liquid
  assign limit = section.settings.products_to_show | default: 8
  assign month = 'now' | date: '%m' | plus: 0
  assign day = 'now' | date: '%d' | plus: 0
  assign is_christmas = false
  if section.settings.seasonal_edit
    if month == 11
      assign is_christmas = true
    elsif month == 12 and day <= 25
      assign is_christmas = true
    endif
  endif
  if section.settings.preview_christmas_edit
    assign is_christmas = true
  endif

  assign row_products = blank
  assign row_collection = blank

  if is_christmas
    assign row_title = 'Christmas Gift Guide'
    assign row_label = 'Shop gifts'
    if section.settings.edit_products.size > 0
      assign row_products = section.settings.edit_products
    else
      assign row_collection = collections['the-christmas-edit']
      if row_collection == blank or row_collection.products_count == 0
        assign row_collection = collections['christmas']
      endif
      if row_collection == blank or row_collection.products_count == 0
        assign row_collection = collections['all-gifting']
      endif
      assign row_products = row_collection.products
    endif
    assign row_link = collections['the-christmas-edit'].url
    if row_link == blank
      assign row_link = '/collections/all-gifting'
    endif
  else
    assign row_title = section.settings.title | default: 'Best sellers'
    assign row_label = section.settings.view_all_label | default: 'Shop all'
    assign row_link = section.settings.view_all_link | default: '/collections/all'
    assign row_collection = section.settings.collection
    if row_collection == blank or row_collection.products_count == 0
      assign row_collection = collections['best-sellers']
    endif
    if row_collection == blank or row_collection.products_count == 0
      assign row_collection = collections['bestsellers']
    endif
    if row_collection == blank or row_collection.products_count == 0
      assign row_collection = collections['all']
    endif
    assign row_products = row_collection.products
  endif
%}

<section class="featured-products full-width" id="best" data-section-id="{{ section.id }}">
  <div class="featured-products__head">
    <h2 class="featured-products__title">{{ row_title | escape }}</h2>
    {% if section.settings.show_view_all and row_link != blank %}
      <a href="{{ row_link }}" class="featured-products__link">{{ row_label | escape }}</a>
    {% endif %}
  </div>

  {% if row_products != blank and row_products.size > 0 %}
    <div class="featured-products__slider">
      <div class="featured-products__scroller">
        <div class="featured-products__track">
          {% for product in row_products limit: limit %}
            {%- render 'card-product',
              card_product: product,
              aspect_ratio: '3/4',
              show_quick_add: false,
              show_wishlist: false,
              show_badges: false,
              first_eager: false,
              strip_divider: true
            -%}
          {% endfor %}
        </div>
      </div>
      <button class="featured-products__arrow" type="button" aria-label="Next">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9,6 16,12 9,18" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
  {% else %}
    <p class="featured-products__empty">{{ section.settings.empty_message | escape }}</p>
  {% endif %}
</section>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var scroller = root.querySelector('.featured-products__scroller');
    var button = root.querySelector('.featured-products__arrow');
    if (!scroller || !button) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function check() {
      button.classList.toggle('is-done', scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 8);
    }
    button.addEventListener('click', function () {
      scroller.scrollBy({ left: scroller.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    });
    scroller.addEventListener('scroll', function () {
      window.clearTimeout(scroller._t);
      scroller._t = window.setTimeout(check, 80);
    }, { passive: true });
    window.addEventListener('resize', check);
    check();
  })();
</script>

{% stylesheet %}
  .featured-products {
    width: 100%;
    min-width: 0;
    padding: 0 16px 80px;
  }

  .featured-products__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 20px;
  }

  .featured-products__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .featured-products__link {
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .featured-products__title,
    .featured-products__link { font-size: 1rem; }
  }

  .featured-products__slider {
    position: relative;
    container-type: inline-size;
  }

  .featured-products__scroller {
    container-type: inline-size;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .featured-products__scroller::-webkit-scrollbar { display: none; }

  .featured-products__track {
    display: flex;
    gap: 16px;
    width: max-content;
  }

  .featured-products__track > * {
    flex: 0 0 calc((100cqi - 16px) / 2);
    width: calc((100cqi - 16px) / 2);
    max-width: calc((100cqi - 16px) / 2);
    min-width: 0;
    scroll-snap-align: none;
  }

  .featured-products__track > *:nth-child(2n + 1) { scroll-snap-align: start; }

  @media (min-width: 768px) {
    .featured-products__track > * {
      flex-basis: calc((100cqi - 48px) / 4);
      width: calc((100cqi - 48px) / 4);
      max-width: calc((100cqi - 48px) / 4);
    }

    .featured-products__track > *:nth-child(2n + 1) { scroll-snap-align: none; }
    .featured-products__track > *:nth-child(4n + 1) { scroll-snap-align: start; }
  }

  .featured-products .card-product {
    gap: 0;
    height: auto;
  }

  .featured-products .card-product__image-link { height: auto; }

  .featured-products .card-product__info {
    gap: 0;
    padding-top: 0;
  }

  .featured-products .card-product__title {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 18px 0 0;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .featured-products .card-product__price,
  .featured-products .card-product__price--regular,
  .featured-products .card-product__price--sale {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 15px;
    letter-spacing: 0;
    color: #6b6965;
    line-height: 1.55;
    margin-top: 6px;
  }

  @media (min-width: 768px) {
    .featured-products .card-product__title { font-size: 0.875rem; }
    .featured-products .card-product__price,
    .featured-products .card-product__price--regular,
    .featured-products .card-product__price--sale { font-size: 1rem; }
  }

  .featured-products__arrow {
    position: absolute;
    right: 6px;
    top: calc((100cqi - 16px) / 3);
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    padding: 8px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #2f2f2f;
    cursor: pointer;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .featured-products__arrow { top: calc((100cqi - 48px) / 6); }
  }

  .featured-products__arrow:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .featured-products__arrow svg { width: 100%; height: 100%; display: block; }
  .featured-products__arrow.is-done { opacity: 0; pointer-events: none; }

  .featured-products__empty {
    text-align: center;
    color: var(--color-foreground-muted);
    padding: var(--spacing-xl) 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "New pieces we are loving"
    },
    {
      "type": "checkbox",
      "id": "seasonal_edit",
      "label": "Switch to Christmas Gift Guide from 1 November to 25 December",
      "default": true
    },
    {
      "type": "product_list",
      "id": "edit_products",
      "label": "Christmas Gift Guide products",
      "info": "Hand-pick the products for the Christmas Gift Guide. If empty, the row uses the 'the-christmas-edit' collection, then 'christmas', then 'all-gifting'.",
      "limit": 12
    },
    {
      "type": "checkbox",
      "id": "preview_christmas_edit",
      "label": "Preview Christmas Gift Guide now (ignores the date)",
      "info": "Ignores the calendar while this is on. Untick after review so the row follows 1 November to 25 December.",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Best sellers collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show the link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Best sellers link label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Best sellers link"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty collection message",
      "default": "Products will appear here once added to the collection."
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
