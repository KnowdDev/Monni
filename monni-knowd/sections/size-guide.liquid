<section class="size-guide" data-section-id="{{ section.id }}">
  <div class="size-guide__inner">
    <div class="size-guide__back" data-size-guide-back hidden>
      <a href="#" data-size-guide-back-link class="size-guide__back-link">
        <span class="size-guide__back-media" data-size-guide-back-image aria-hidden="true"></span>
        <span class="size-guide__back-copy">
          <span class="size-guide__back-eyebrow">Back to product</span>
          <span class="size-guide__back-title" data-size-guide-back-label></span>
        </span>
      </a>
    </div>

    <header class="size-guide__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="size-guide__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="size-guide__title">
        {{ section.settings.title_main | default: 'Size' }} {{ section.settings.title_accent | default: 'Guide' }}
      </h1>
      {%- if section.settings.intro != blank -%}
        <p class="size-guide__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="size-guide__tabs" role="tablist" aria-label="Size guide sections" data-size-guide-tabs>
      <button
        type="button"
        class="size-guide__tab is-active"
        role="tab"
        aria-selected="true"
        aria-controls="size-guide-clothing-{{ section.id }}"
        id="size-guide-tab-clothing-{{ section.id }}"
        data-tab="clothing"
      >
        {{ section.settings.tab_clothing_label | default: 'Clothing' }}
      </button>
      <button
        type="button"
        class="size-guide__tab"
        role="tab"
        aria-selected="false"
        aria-controls="size-guide-measure-{{ section.id }}"
        id="size-guide-tab-measure-{{ section.id }}"
        data-tab="measure"
      >
        {{ section.settings.tab_measure_label | default: 'How to Measure' }}
      </button>
    </div>

    <div
      class="size-guide__panel is-active"
      id="size-guide-clothing-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="size-guide-tab-clothing-{{ section.id }}"
      data-panel="clothing"
    >
      {%- capture size_rows -%}
0|XS/S|6|2|79|65|92
1|S/M|8|4|84|70|97
2|S/M|10|6|89|75|102
3|M/L|12|8|94|80|107
4|M/L|14|10|99|85|112
5|L/XL|16|12|105|91|118
6|L/XL|18|14|112|98|125
      {%- endcapture -%}
      {%- assign rows = size_rows | strip | split: '
' -%}

      <div class="size-guide__desktop-table size-guide__table-wrap">
        <table class="size-guide__table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">General</th>
              <th scope="col">AUS</th>
              <th scope="col">USA</th>
              <th scope="col">Bust (cm)</th>
              <th scope="col">Waist (cm)</th>
              <th scope="col">Hips (cm)</th>
            </tr>
          </thead>
          <tbody>
            {%- for row in rows -%}
              {%- assign cols = row | split: '|' -%}
              <tr>
                <th scope="row">{{ cols[0] }}</th>
                <td>{{ cols[1] }}</td>
                <td>{{ cols[2] }}</td>
                <td>{{ cols[3] }}</td>
                <td>{{ cols[4] }}</td>
                <td>{{ cols[5] }}</td>
                <td>{{ cols[6] }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <div class="size-guide__mobile-cards">
        {%- for row in rows -%}
          {%- assign cols = row | split: '|' -%}
          {%- assign general_label = cols[1] | replace: '/', ' / ' -%}
          <article class="size-guide__card">
            <div class="size-guide__card-head">
              <span class="size-guide__card-size">Size {{ cols[0] }}</span>
              <span class="size-guide__card-gen">{{ general_label }}</span>
            </div>
            <div class="size-guide__card-body">
              <div class="size-guide__stat">
                <span class="size-guide__stat-key">AUS</span>
                <span class="size-guide__stat-val">{{ cols[2] }}</span>
              </div>
              <div class="size-guide__stat">
                <span class="size-guide__stat-key">USA</span>
                <span class="size-guide__stat-val">{{ cols[3] }}</span>
              </div>
              <div class="size-guide__stat">
                <span class="size-guide__stat-key">Bust</span>
                <span class="size-guide__stat-val">{{ cols[4] }}cm</span>
              </div>
              <div class="size-guide__stat">
                <span class="size-guide__stat-key">Waist</span>
                <span class="size-guide__stat-val">{{ cols[5] }}cm</span>
              </div>
              <div class="size-guide__stat">
                <span class="size-guide__stat-key">Hips</span>
                <span class="size-guide__stat-val">{{ cols[6] }}cm</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.table_note != blank -%}
        <aside class="size-guide__note rte">
          {{ section.settings.table_note }}
        </aside>
      {%- endif -%}
    </div>

    <div
      class="size-guide__panel"
      id="size-guide-measure-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="size-guide-tab-measure-{{ section.id }}"
      data-panel="measure"
      hidden
    >
      <div class="size-guide__measure-grid">
        <article class="size-guide__measure-card">
          <h2 class="size-guide__measure-title">Bust</h2>
          <p>Measure around the fullest part of your chest, keeping the tape horizontal. Do not pull too tightly.</p>
        </article>
        <article class="size-guide__measure-card">
          <h2 class="size-guide__measure-title">Waist</h2>
          <p>Measure around your natural waist at the narrowest point, just above your belly button. Keep the tape relaxed.</p>
        </article>
        <article class="size-guide__measure-card">
          <h2 class="size-guide__measure-title">Hips</h2>
          <p>Stand with feet together and measure around the widest part of your hips, approximately 20cm below your natural waist.</p>
        </article>
      </div>

      {%- if section.settings.measure_tip != blank -%}
        <aside class="size-guide__tip rte">
          {{ section.settings.measure_tip }}
        </aside>
      {%- endif -%}
    </div>

    {%- if section.settings.footer_note != blank -%}
      <p class="size-guide__footer">
        {{ section.settings.footer_note }}
        <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Contact us</a>
        for personalised fit advice.
      </p>
    {%- endif -%}

    <section class="size-guide__recently-viewed" data-recently-viewed hidden>
      <h2 data-recently-viewed-heading>Recently viewed</h2>
      <div class="size-guide__recently-viewed-grid" data-recently-viewed-grid></div>
    </section>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;

    const tabs = root.querySelector('[data-size-guide-tabs]');
    const panels = [...root.querySelectorAll('[data-panel]')];

    tabs?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-tab]');
      if (!button) return;

      const target = button.dataset.tab;
      tabs.querySelectorAll('[data-tab]').forEach((tab) => {
        const active = tab === button;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === target;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    });
  })();
</script>

{% stylesheet %}
  .size-guide {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: clamp(4rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .size-guide__inner {
    max-width: 54rem;
    margin: 0 auto;
    padding-inline: var(--page-margin);
  }

  .size-guide__back {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .size-guide__back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    color: inherit;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-light);
    background: var(--color-background-alt);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .size-guide__back-link:hover {
    border-color: var(--color-border);
    background: var(--color-background);
  }

  .size-guide__back-media {
    flex-shrink: 0;
    width: 3rem;
    height: 3.75rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .size-guide__back-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .size-guide__back-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .size-guide__back-eyebrow {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .size-guide__back-title {
    font-family: var(--font-heading-family);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18rem;
  }

  .size-guide__recently-viewed {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border-light);
  }

  .size-guide__recently-viewed h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 400;
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .size-guide__recently-viewed-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .size-guide__recently-viewed-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .size-guide__header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .size-guide__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    font-family: var(--font-body--family);
  }

  .size-guide__title {
    margin: 0 0 var(--spacing-md);
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 7vw, 2.75rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .size-guide__intro {
    margin: 0 auto;
    max-width: 42ch;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-foreground-light);
    font-family: var(--font-body--family);
  }

  .size-guide__tabs {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .size-guide__tab {
    position: relative;
    padding: 0 0 1rem;
    margin-bottom: -1px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-foreground-muted);
    font-family: var(--font-heading--family);
    font-size: clamp(1rem, 2.5vw, 1.1875rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--transition-normal), border-color var(--transition-normal);
  }

  .size-guide__tab::after {
    content: none;
  }

  .size-guide__tab.is-active,
  .size-guide__tab:hover {
    color: var(--color-foreground);
  }

  .size-guide__tab.is-active {
    border-bottom-color: var(--color-foreground);
  }

  .size-guide__panel[hidden] {
    display: none;
  }

  .size-guide__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: var(--spacing-lg);
  }

  .size-guide__table {
    width: 100%;
    min-width: 33.75rem;
    border-collapse: collapse;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
  }

  .size-guide__table thead th {
    padding: 1rem 0.75rem;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  .size-guide__table tbody th,
  .size-guide__table tbody td {
    padding: 1rem 0.75rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border-light);
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: 400;
  }

  .size-guide__table tbody tr:nth-child(even) th,
  .size-guide__table tbody tr:nth-child(even) td {
    background: var(--color-background-alt);
  }

  .size-guide__table tbody th {
    color: var(--color-foreground);
  }

  .size-guide__table tbody td {
    color: var(--color-foreground);
  }

  .size-guide__mobile-cards {
    display: none;
    margin-bottom: var(--spacing-lg);
  }

  .size-guide__card {
    border: 1px solid var(--color-border-light);
    border-radius: 3px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .size-guide__card:last-child {
    margin-bottom: 0;
  }

  .size-guide__card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding: 0.875rem 1.25rem;
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .size-guide__card-size {
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .size-guide__card-gen {
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .size-guide__card-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem 1.5rem;
    padding: 0.875rem 1.25rem;
    background: var(--color-background);
  }

  .size-guide__stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding-bottom: 0.375rem;
    border-bottom: 1px dotted var(--color-border-light);
  }

  .size-guide__stat-key {
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .size-guide__stat-val {
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-foreground);
  }

  .size-guide__note,
  .size-guide__tip {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-foreground-muted);
    font-family: var(--font-body--family);
    text-align: center;
  }

  .size-guide__note p,
  .size-guide__tip p {
    margin: 0;
  }

  .size-guide__tip {
    padding: 1.25rem 1.5rem;
    background: var(--color-background-alt);
    border-radius: 3px;
    font-style: italic;
  }

  .size-guide__measure-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .size-guide__measure-card {
    padding: 1.75rem 1.5rem;
    background: var(--color-background);
    border: 1px solid var(--color-border-light);
    border-radius: 3px;
  }

  .size-guide__measure-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .size-guide__measure-card p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-foreground-light);
    font-family: var(--font-body--family);
  }

  .size-guide__footer {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-foreground-muted);
    font-family: var(--font-body--family);
  }

  .size-guide__footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .size-guide__footer a:hover {
    color: var(--color-foreground);
  }

  @media (max-width: 640px) {
    .size-guide__tabs {
      gap: 1.75rem;
    }

    .size-guide__desktop-table {
      display: none;
    }

    .size-guide__mobile-cards {
      display: block;
    }

    .size-guide__measure-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size guide",
  "tag": "section",
  "class": "section-size-guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fit & Sizing"
    },
    {
      "type": "text",
