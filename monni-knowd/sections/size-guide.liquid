<section class="size-guide" data-section-id="{{ section.id }}">
  <div class="size-guide__inner">
    <div class="size-guide__back" data-size-guide-back hidden>
      <a href="#" data-size-guide-back-link class="size-guide__back-link">
        <span class="size-guide__back-media" data-size-guide-back-image aria-hidden="true"></span>
        <span class="size-guide__back-copy">
          <span class="size-guide__back-eyebrow">Back to product</span>
          <span class="size-guide__back-title" data-size-guide-back-label></span>
        </span>
      </a>
    </div>

    <h1 class="size-guide__title">{{ section.settings.title | default: 'Size Guide' | escape }}</h1>
    <p class="size-guide__intro">{{ section.settings.lead | default: 'Our garments are designed to fit true to size. Fit can vary slightly by style, so check each product page for its fit notes.' | escape }}</p>

    <div class="size-guide__tabs" role="tablist" aria-label="Size guide sections" data-size-guide-tabs>
      <button
        type="button"
        class="size-guide__tab is-active"
        role="tab"
        aria-selected="true"
        aria-controls="size-guide-clothing-{{ section.id }}"
        id="size-guide-tab-clothing-{{ section.id }}"
        data-tab="clothing"
      >
        {{ section.settings.tab_clothing_label | default: 'Clothing' | escape }}
      </button>
      <button
        type="button"
        class="size-guide__tab"
        role="tab"
        aria-selected="false"
        aria-controls="size-guide-measure-{{ section.id }}"
        id="size-guide-tab-measure-{{ section.id }}"
        data-tab="measure"
      >
        {{ section.settings.tab_measure_label | default: 'How to measure' | escape }}
      </button>
    </div>

    <div
      class="size-guide__panel is-active"
      id="size-guide-clothing-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="size-guide-tab-clothing-{{ section.id }}"
      data-panel="clothing"
    >
      {%- capture size_rows -%}
0|XS/S|6|2|79|65|92
1|S/M|8|4|84|70|97
2|S/M|10|6|89|75|102
3|M/L|12|8|94|80|107
4|M/L|14|10|99|85|112
      {%- endcapture -%}
      {%- assign rows = size_rows | strip | split: '
' -%}

      <div class="size-guide__table-wrap">
        <table class="size-guide__table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">General</th>
              <th scope="col">AUS</th>
              <th scope="col">USA</th>
              <th scope="col">Bust (cm)</th>
              <th scope="col">Waist (cm)</th>
              <th scope="col">Hips (cm)</th>
            </tr>
          </thead>
          <tbody>
            {%- for row in rows -%}
              {%- assign cols = row | strip | split: '|' -%}
              {%- if cols.size > 1 -%}
                <tr>
                  <td>{{ cols[0] }}</td>
                  <td>{{ cols[1] }}</td>
                  <td>{{ cols[2] }}</td>
                  <td>{{ cols[3] }}</td>
                  <td>{{ cols[4] }}</td>
                  <td>{{ cols[5] }}</td>
                  <td>{{ cols[6] }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <p class="size-guide__between">Between sizes? Size up for a more relaxed fit, or down for a closer fit.</p>
    </div>

    <div
      class="size-guide__panel size-guide__measure"
      id="size-guide-measure-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="size-guide-tab-measure-{{ section.id }}"
      data-panel="measure"
      hidden
    >
      <p>Use a soft measuring tape and wear minimal clothing. A friend can help you get a more accurate measurement. Measure your body, not a garment.</p>
      <p><b>Bust</b><br>Around the fullest part of your bust.</p>
      <p><b>Waist</b><br>Around the narrowest part of your waist.</p>
      <p><b>Hips</b><br>Around the fullest part of your hips.</p>
    </div>

    <p class="size-guide__help">Questions? <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Contact us</a> for personalised fit advice.</p>

    <section class="size-guide__recently-viewed" data-recently-viewed hidden>
      <h2 data-recently-viewed-heading>Recently viewed</h2>
      <div class="size-guide__recently-viewed-grid" data-recently-viewed-grid></div>
    </section>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;

    const tabs = root.querySelector('[data-size-guide-tabs]');
    const panels = [...root.querySelectorAll('[data-panel]')];

    tabs?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-tab]');
      if (!button) return;

      const target = button.dataset.tab;
      tabs.querySelectorAll('[data-tab]').forEach((tab) => {
        const active = tab === button;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === target;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    });
  })();
</script>

{% stylesheet %}
  .size-guide {
    background: #f5f4f1;
    color: #2f2f2f;
    padding: 48px 0 72px;
  }

  @media (min-width: 761px) {
    .size-guide { padding: 72px 0 96px; }
  }

  .size-guide .size-guide__inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
    text-align: center;
  }

  @media (min-width: 761px) {
    .size-guide__inner { padding: 0 24px; }
  }

  .size-guide__back {
    margin: 0 auto 28px;
    text-align: left;
    max-width: 560px;
  }

  .size-guide__back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    color: inherit;
  }

  .size-guide__back-media {
    flex-shrink: 0;
    width: 3rem;
    height: 3.75rem;
    overflow: hidden;
    background: #ece7e1;
  }

  .size-guide__back-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .size-guide__back-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .size-guide__back-eyebrow {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6965;
  }

  .size-guide__back-title {
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .size-guide .size-guide__title {
    margin: 0 0 22px;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .size-guide__intro {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #6b6965;
    max-width: 560px;
    margin: 0 auto 48px;
    text-wrap: balance;
  }

  .size-guide__tabs {
    display: flex;
    justify-content: center;
    gap: 24px;
    border-bottom: 1px solid #dcd9d3;
    margin-bottom: 40px;
  }

  @media (min-width: 761px) {
    .size-guide__tabs { gap: 40px; }
  }

  .size-guide__tab {
    background: none;
    border: 0;
    border-bottom: 1.5px solid transparent;
    margin-bottom: -1px;
    padding: 0 0 14px;
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6b6965;
    cursor: pointer;
  }

  .size-guide__tab.is-active {
    color: #2f2f2f;
    border-bottom-color: #2f2f2f;
  }

  .size-guide__panel[hidden] { display: none; }

  .size-guide__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .size-guide__table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-body--family);
  }

  .size-guide__table th {
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0 8px 16px;
    border-bottom: 1px solid #2f2f2f;
  }

  .size-guide__table td {
    font-weight: 300;
    font-size: 1rem;
    padding: 18px 8px;
    border-bottom: 1px solid #dcd9d3;
  }

  .size-guide__table tbody tr:nth-child(odd) td { background: #ece7e1; }

  .size-guide__between {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 1rem;
    color: #6b6965;
    margin: 28px 0 0;
  }

  .size-guide__measure {
    max-width: 560px;
    margin: 0 auto;
    text-align: left;
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.7;
  }

  .size-guide__measure p { margin: 0 0 16px; }

  .size-guide__measure b {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
  }

  .size-guide__help {
    margin: 64px 0 0;
    padding-top: 40px;
    border-top: 1px solid #dcd9d3;
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 1rem;
    color: #6b6965;
  }

  .size-guide__help a {
    color: #2f2f2f;
    text-underline-offset: 4px;
  }

  .size-guide__recently-viewed {
    margin-top: 48px;
    text-align: left;
  }

  .size-guide__recently-viewed h2 {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 20px;
  }

  .size-guide__recently-viewed-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (min-width: 761px) {
    .size-guide__recently-viewed-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size guide",
  "tag": "section",
  "class": "section-size-guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Size Guide"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Introduction",
      "default": "Our garments are designed to fit true to size. Fit can vary slightly by style, so check each product page for its fit notes."
    },
    {
      "type": "text",
      "id": "tab_clothing_label",
      "label": "Clothing tab label",
      "default": "Clothing"
    },
    {
      "type": "text",
      "id": "tab_measure_label",
      "label": "How to measure tab label",
      "default": "How to measure"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    }
  ],
  "presets": [
    {
      "name": "Size guide"
    }
  ]
}
{% endschema %}
