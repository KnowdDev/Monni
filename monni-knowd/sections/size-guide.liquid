      "label": "Introduction",
      "default": "All measurements are in centimetres. Our garments are designed to fit true to size — when between sizes, we recommend sizing up for a more relaxed fit, or sizing down for a closer fit."
    },
    {
      "type": "text",
      "id": "tab_clothing_label",
      "label": "Clothing tab label",
      "default": "Clothing"
    },
    {
      "type": "text",
      "id": "tab_measure_label",
      "label": "How to measure tab label",
      "default": "How to Measure"
    },
    {
      "type": "richtext",
      "id": "table_note",
      "label": "Note below table",
      "default": "<p>If you are between sizes, we recommend sizing up for a more relaxed fit, or sizing down for a closer fit. Fit may vary slightly by style — refer to individual product pages for specific fit notes.</p>"
    },
    {
      "type": "text",
      "id": "measure_heading",
      "label": "How to measure heading",
