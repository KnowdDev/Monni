<section class="size-guide" data-section-id="{{ section.id }}">
  <div class="size-guide__inner">
    <div class="size-guide__back" data-size-guide-back hidden>
      <a href="#" data-size-guide-back-link class="size-guide__back-link">
        <span class="size-guide__back-media" data-size-guide-back-image aria-hidden="true"></span>
        <span class="size-guide__back-copy">
          <span class="size-guide__back-eyebrow">Back to product</span>
          <span class="size-guide__back-title" data-size-guide-back-label></span>
        </span>
      </a>
    </div>

    <header class="size-guide__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="size-guide__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="size-guide__title">
        <span class="size-guide__title-main">{{ section.settings.title_main | default: 'Size' }}</span>
        <span class="size-guide__title-accent">{{ section.settings.title_accent | default: 'Guide' }}</span>
      </h1>
      <div class="size-guide__rule" aria-hidden="true"></div>
      {%- if section.settings.intro != blank -%}
        <p class="size-guide__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="size-guide__tabs" role="tablist" aria-label="Size guide sections" data-size-guide-tabs>
      <button
        type="button"
        class="size-guide__tab is-active"
        role="tab"
        aria-selected="true"
        aria-controls="size-guide-clothing-{{ section.id }}"
        id="size-guide-tab-clothing-{{ section.id }}"
        data-tab="clothing"
      >
        {{ section.settings.tab_clothing_label | default: 'Clothing' }}
      </button>
      <button
        type="button"
        class="size-guide__tab"
        role="tab"
        aria-selected="false"
        aria-controls="size-guide-measure-{{ section.id }}"
        id="size-guide-tab-measure-{{ section.id }}"
        data-tab="measure"
      >
        {{ section.settings.tab_measure_label | default: 'How to Measure' }}
      </button>
    </div>

    <div
      class="size-guide__panel is-active"
      id="size-guide-clothing-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="size-guide-tab-clothing-{{ section.id }}"
      data-panel="clothing"
    >
      <div class="size-guide__table-wrap">
        <table class="size-guide__table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">General</th>
              <th scope="col">AUS</th>
              <th scope="col">USA</th>
              <th scope="col">Bust (cm)</th>
              <th scope="col">Waist (cm)</th>
              <th scope="col">Hips (cm)</th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">0</th><td>XS/S</td><td>6</td><td>2</td><td>79</td><td>65</td><td>92</td></tr>
            <tr><th scope="row">1</th><td>S/M</td><td>8</td><td>4</td><td>84</td><td>70</td><td>97</td></tr>
            <tr><th scope="row">2</th><td>S/M</td><td>10</td><td>6</td><td>89</td><td>75</td><td>102</td></tr>
            <tr><th scope="row">3</th><td>M/L</td><td>12</td><td>8</td><td>94</td><td>80</td><td>107</td></tr>
            <tr><th scope="row">4</th><td>M/L</td><td>14</td><td>10</td><td>99</td><td>85</td><td>112</td></tr>
            <tr><th scope="row">5</th><td>L/XL</td><td>16</td><td>12</td><td>105</td><td>91</td><td>118</td></tr>
            <tr><th scope="row">6</th><td>L/XL</td><td>18</td><td>14</td><td>112</td><td>98</td><td>125</td></tr>
          </tbody>
        </table>
      </div>

      {%- if section.settings.table_note != blank -%}
        <aside class="size-guide__note rte">
          {{ section.settings.table_note }}
        </aside>
      {%- endif -%}
    </div>

    <div
      class="size-guide__panel"
      id="size-guide-measure-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="size-guide-tab-measure-{{ section.id }}"
      data-panel="measure"
      hidden
    >
      <p class="size-guide__panel-label">{{ section.settings.measure_heading | default: 'Measuring guide' }}</p>

      <ol class="size-guide__steps">
        <li class="size-guide__step">
          <span class="size-guide__step-index" aria-hidden="true">01</span>
          <div class="size-guide__step-copy">
            <h2 class="size-guide__step-title">Bust</h2>
            <p>Measure around the fullest part of your chest, keeping the tape horizontal. Do not pull too tightly.</p>
          </div>
        </li>
        <li class="size-guide__step">
          <span class="size-guide__step-index" aria-hidden="true">02</span>
          <div class="size-guide__step-copy">
            <h2 class="size-guide__step-title">Waist</h2>
            <p>Measure around your natural waist at the narrowest point, just above your belly button. Keep the tape relaxed.</p>
          </div>
        </li>
        <li class="size-guide__step">
          <span class="size-guide__step-index" aria-hidden="true">03</span>
          <div class="size-guide__step-copy">
            <h2 class="size-guide__step-title">Hips</h2>
            <p>Stand with feet together and measure around the widest part of your hips, approximately 20cm below your natural waist.</p>
          </div>
        </li>
      </ol>

      {%- if section.settings.measure_tip != blank -%}
        <aside class="size-guide__tip rte">
          {{ section.settings.measure_tip }}
        </aside>
      {%- endif -%}
    </div>

    {%- if section.settings.footer_note != blank -%}
      <p class="size-guide__footer">
        {{ section.settings.footer_note }}
        <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Contact us</a>
        for personalised fit advice.
      </p>
    {%- endif -%}

    <section class="size-guide__recently-viewed" data-recently-viewed hidden>
      <h2 data-recently-viewed-heading>Recently viewed</h2>
      <div class="size-guide__recently-viewed-grid" data-recently-viewed-grid></div>
    </section>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;

    const tabs = root.querySelector('[data-size-guide-tabs]');
    const panels = [...root.querySelectorAll('[data-panel]')];

    tabs?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-tab]');
      if (!button) return;

      const target = button.dataset.tab;
      tabs.querySelectorAll('[data-tab]').forEach((tab) => {
        const active = tab === button;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === target;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    });
  })();
</script>

{% stylesheet %}
  .size-guide {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: clamp(4rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .size-guide__inner {
    max-width: 54rem;
    margin: 0 auto;
    padding-inline: var(--page-margin);
  }

  .size-guide__back {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .size-guide__back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    color: inherit;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-light);
    background: var(--color-background-alt);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .size-guide__back-link:hover {
    border-color: var(--color-border);
    background: var(--color-background);
  }

  .size-guide__back-media {
    flex-shrink: 0;
    width: 3rem;
    height: 3.75rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .size-guide__back-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .size-guide__back-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .size-guide__back-eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .size-guide__back-title {
    font-family: var(--font-heading-family);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18rem;
  }

  .size-guide__recently-viewed {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border-light);
  }

  .size-guide__recently-viewed h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 400;
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .size-guide__recently-viewed-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .size-guide__recently-viewed-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .size-guide__header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .size-guide__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    font-family: var(--font-body--family);
  }

  .size-guide__title {
    margin: 0 0 var(--spacing-md);
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .size-guide__title-main {
    color: var(--color-foreground);
  }

  .size-guide__title-accent {
    color: var(--color-accent-dark);
    font-style: italic;
    font-weight: 300;
  }

  .size-guide__rule {
    width: 2.5rem;
    height: 1px;
    margin: 0 auto var(--spacing-md);
    background: var(--color-accent);
  }

  .size-guide__intro {
    margin: 0 auto;
    max-width: 42ch;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-foreground-light);
    font-family: var(--font-body--family);
  }

  .size-guide__tabs {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .size-guide__tab {
    position: relative;
    padding: 0.75rem 0 1rem;
    border: 0;
    background: transparent;
    color: var(--color-foreground-muted);
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--transition-normal);
  }

  .size-guide__tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-foreground);
    transform: scaleX(0);
    transition: transform var(--transition-normal);
  }

  .size-guide__tab.is-active,
  .size-guide__tab:hover {
    color: var(--color-foreground);
  }

  .size-guide__tab.is-active::after {
    transform: scaleX(1);
  }

  .size-guide__panel-label {
    margin: 0 0 var(--spacing-lg);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    font-family: var(--font-body--family);
  }

  .size-guide__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: var(--spacing-lg);
    border: 1px solid var(--color-border-light);
    background: var(--color-background-alt);
  }

  .size-guide__table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
  }

  .size-guide__table thead th {
    padding: 0.9rem 0.75rem;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  .size-guide__table tbody th,
  .size-guide__table tbody td {
    padding: 0.85rem 0.75rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border-light);
  }

  .size-guide__table tbody tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.45);
  }

  .size-guide__table tbody th {
    font-family: var(--font-heading--family);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-foreground);
  }

  .size-guide__table tbody td {
    color: var(--color-foreground-light);
  }

  .size-guide__note,
  .size-guide__tip {
    position: relative;
    padding: 1.1rem 1.25rem 1.1rem 1.5rem;
    background: var(--color-background-alt);
    border: 1px solid var(--color-border-light);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-foreground-light);
    font-family: var(--font-body--family);
  }

  .size-guide__note::before,
  .size-guide__tip::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent);
  }

  .size-guide__tip {
    font-style: italic;
  }

  .size-guide__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .size-guide__step {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--spacing-md);
    padding: clamp(1.5rem, 4vw, 2rem) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .size-guide__step:last-child {
    border-bottom: 0;
  }

  .size-guide__step-index {
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1;
    color: var(--color-accent-light);
    font-weight: 300;
  }

  .size-guide__step-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .size-guide__step-copy p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-foreground-light);
    font-family: var(--font-body--family);
  }

  .size-guide__footer {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-foreground-muted);
    font-family: var(--font-body--family);
  }

  .size-guide__footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .size-guide__footer a:hover {
    color: var(--color-foreground);
  }

  @media (max-width: 640px) {
    .size-guide__step {
      grid-template-columns: 3.25rem 1fr;
      gap: var(--spacing-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size guide",
  "tag": "section",
  "class": "section-size-guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fit & Sizing"
    },
    {
      "type": "text",
      "id": "title_main",
      "label": "Title (first word)",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title (accent word)",
      "default": "Guide"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "All measurements are in centimetres. Our garments are designed to fit true to size — when between sizes, we recommend sizing up for a more relaxed fit, or sizing down for a closer fit."
    },
    {
      "type": "text",
      "id": "tab_clothing_label",
      "label": "Clothing tab label",
      "default": "Clothing"
    },
    {
      "type": "text",
      "id": "tab_measure_label",
      "label": "How to measure tab label",
      "default": "How to Measure"
    },
    {
      "type": "richtext",
      "id": "table_note",
      "label": "Note below table",
      "default": "<p>If you are between sizes, we recommend sizing up for a more relaxed fit, or sizing down for a closer fit. Fit may vary slightly by style — refer to individual product pages for specific fit notes.</p>"
    },
    {
      "type": "text",
      "id": "measure_heading",
      "label": "How to measure heading",
      "default": "Measuring guide"
    },
    {
      "type": "richtext",
      "id": "measure_tip",
      "label": "Measuring tip",
      "default": "<p><em>For the most accurate results, use a soft measuring tape and wear minimal clothing. Ask a friend to help for a more precise measurement. All measurements refer to body measurements, not garment measurements.</em></p>"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer note",
      "default": "All measurements are in centimetres · AUS sizing · Questions?"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    }
  ],
  "presets": [
    {
      "name": "Size guide"
    }
  ]
}
{% endschema %}
