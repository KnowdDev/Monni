{%- liquid
  assign founder_bg = section.settings.background_color | default: '#D9D0C4'
  assign founder_image = section.settings.background_image
  assign overlay_strength = section.settings.background_overlay | default: 72
-%}

<section
  class="founder full-width{% if founder_image != blank %} founder--has-image{% endif %}"
  data-section-id="{{ section.id }}"
  style="--founder-bg: {{ founder_bg }}; --founder-overlay: {{ overlay_strength }}%; --founder-image-focus-y: {{ section.settings.image_focus_y | default: 50 }}%;"
>
  {% if founder_image != blank %}
    <div class="founder__media" aria-hidden="true">
      {% render 'responsive-img',
        image: founder_image,
        alt: '',
        class: 'founder__image',
        sizes: '100vw',
        widths: '480,720,960,1280',
        default_width: 720,
        width: founder_image.width | default: 1280,
        height: founder_image.height | default: 720,
        loading: 'lazy'
      %}
      <div class="founder__overlay"></div>
    </div>
  {% endif %}

  <div class="founder__inner">
    <div class="founder__text">
      <blockquote class="founder__quote">
        {{ section.settings.quote | escape }}
      </blockquote>
      {% if section.settings.cta != blank %}
        <a href="{{ section.settings.link | default: '/pages/about' }}" class="founder__cta">
          {{ section.settings.cta | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .founder {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 18% 12%, color-mix(in srgb, var(--founder-bg, #D9D0C4) 72%, white) 0%, transparent 58%),
      radial-gradient(ellipse at 88% 88%, color-mix(in srgb, var(--color-accent) 28%, var(--founder-bg, #D9D0C4)) 0%, transparent 52%),
      var(--founder-bg, #D9D0C4);
  }

  .founder--has-image {
    background: var(--founder-bg, #D9D0C4);
  }

  .founder__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--founder-image-focus-y, 50%);
    display: block;
  }

  .founder__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--founder-bg, #D9D0C4) var(--founder-overlay, 72%), transparent) 0%,
        color-mix(in srgb, var(--founder-bg, #D9D0C4) calc(var(--founder-overlay, 72%) + 8%), transparent) 100%
      );
  }

  .founder__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(18rem, 42vw, 28rem);
    padding: clamp(3.5rem, 10vw, 6rem) var(--page-margin);
  }

  .founder__text {
    text-align: center;
    max-width: 46ch;
  }

  .founder__quote {
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2.8vw, 1.75rem);
    font-weight: 300;
    font-style: italic;
    color: var(--color-foreground);
    margin: 0 0 clamp(1.5rem, 4vw, 2rem);
    line-height: 1.55;
    text-wrap: balance;
    letter-spacing: 0.01em;
  }

  .founder__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 35%, transparent);
    padding: 0.75rem 1.75rem;
    background-color: color-mix(in srgb, var(--color-background-alt) 55%, transparent);
    transition: background-color var(--transition-normal), color var(--transition-normal), border-color var(--transition-normal);
  }

  .founder__cta:hover {
    background-color: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background-alt);
  }
{% endstyle %}

{% schema %}
{
  "name": "Founder Moment",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Used as fallback and to tint the image overlay for readable text.",
      "default": "#D9D0C4"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_focus_y",
      "label": "Image vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "Move the background image up (0%) or down (100%) when it is cropped to fit the section."
    },
    {
      "type": "range",
      "id": "background_overlay",
      "label": "Image overlay strength",
      "min": 40,
      "max": 90,
      "step": 2,
      "unit": "%",
      "default": 72,
      "info": "Higher values soften the photo so the quote stays readable."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "What is the most true and beautiful life you can dream into being?"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "CTA",
      "default": "About MONNI"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Founder Moment",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
