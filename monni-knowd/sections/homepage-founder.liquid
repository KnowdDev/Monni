<section class="founder full-width" data-section-id="{{ section.id }}">
  <div class="founder__inner">
    <div class="founder__image-wrap">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.image | image_url: width: 600 }} 600w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w,
            {{ section.settings.image | image_url: width: 1600 }} 1600w
          "
          sizes="100vw"
          alt="{{ shop.name | escape }}"
          loading="lazy"
          width="1600"
          height="900"
          class="founder__image"
        >
      {% else %}
        <img
          src="https://images.unsplash.com/photo-1470058869958-2a77ade41c02?w=1600&h=900&fit=crop&q=80"
          srcset="
            https://images.unsplash.com/photo-1470058869958-2a77ade41c02?w=600&h=338&fit=crop&q=80 600w,
            https://images.unsplash.com/photo-1470058869958-2a77ade41c02?w=1200&h=675&fit=crop&q=80 1200w,
            https://images.unsplash.com/photo-1470058869958-2a77ade41c02?w=1600&h=900&fit=crop&q=80 1600w
          "
          sizes="100vw"
          alt="{{ shop.name | escape }}"
          loading="lazy"
          width="1600"
          height="900"
          class="founder__image"
        >
      {% endif %}
      <div class="founder__overlay"></div>
    </div>

    <div class="founder__text">
      <blockquote class="founder__quote">
        {{ section.settings.quote | default: "What is the most true and beautiful life you can dream into being?" }}
      </blockquote>
      {% if section.settings.cta != blank %}
        <a href="{{ section.settings.link | default: '/pages/about' }}" class="founder__cta">
          {{ section.settings.cta | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .founder {
    position: relative;
    overflow: hidden;
  }

  .founder__inner {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .founder__image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .founder__image,
  .founder__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founder__fallback {
    background: linear-gradient(135deg, var(--color-accent-light), var(--color-border-light));
  }

  .founder__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }

  .founder__text {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: clamp(5rem, 14vw, 10rem) 1.5rem;
    max-width: 52ch;
  }

  .founder__quote {
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    font-weight: 300;
    font-style: italic;
    color: #FFFFFF;
    margin: 0 0 2rem;
    line-height: 1.55;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.25);
    text-wrap: balance;
    letter-spacing: 0.02em;
  }

  .founder__cta {
    font-family: var(--font-body--family);
    font-size: clamp(0.6rem, 0.9vw, 0.7rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.5);
    padding: 0.65rem 1.6rem;
    display: inline-block;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .founder__cta:hover {
    background-color: #FFFFFF;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Founder Moment",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "What is the most true and beautiful life you can dream into being?"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "CTA",
      "default": "About MONNI"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Founder Moment",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
