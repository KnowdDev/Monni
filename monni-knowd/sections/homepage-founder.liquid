<section
  class="founder full-width"
  data-section-id="{{ section.id }}"
  style="--founder-bg: {{ section.settings.background_color | default: '#D9D0C4' }};"
>
  <div class="founder__inner">
    <div class="founder__text">
      <blockquote class="founder__quote">
        {{ section.settings.quote | escape }}
      </blockquote>
      {% if section.settings.cta != blank %}
        <a href="{{ section.settings.link | default: '/pages/about' }}" class="founder__cta">
          {{ section.settings.cta | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .founder {
    background:
      radial-gradient(ellipse at 18% 12%, color-mix(in srgb, var(--founder-bg, #D9D0C4) 72%, white) 0%, transparent 58%),
      radial-gradient(ellipse at 88% 88%, color-mix(in srgb, var(--color-accent) 28%, var(--founder-bg, #D9D0C4)) 0%, transparent 52%),
      var(--founder-bg, #D9D0C4);
  }

  .founder__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(18rem, 42vw, 28rem);
    padding: clamp(3.5rem, 10vw, 6rem) var(--page-margin);
  }

  .founder__text {
    text-align: center;
    max-width: 46ch;
  }

  .founder__quote {
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2.8vw, 1.75rem);
    font-weight: 300;
    font-style: italic;
    color: var(--color-foreground);
    margin: 0 0 clamp(1.5rem, 4vw, 2rem);
    line-height: 1.55;
    text-wrap: balance;
    letter-spacing: 0.01em;
  }

  .founder__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 35%, transparent);
    padding: 0.75rem 1.75rem;
    background-color: color-mix(in srgb, var(--color-background-alt) 55%, transparent);
    transition: background-color var(--transition-normal), color var(--transition-normal), border-color var(--transition-normal);
  }

  .founder__cta:hover {
    background-color: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background-alt);
  }
{% endstyle %}

{% schema %}
{
  "name": "Founder Moment",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#D9D0C4"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "What is the most true and beautiful life you can dream into being?"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "CTA",
      "default": "About MONNI"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Founder Moment",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
