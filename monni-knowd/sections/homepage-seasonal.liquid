{%- liquid
  assign featured_collection = collections[section.settings.collection]
  assign hero_image = section.settings.image
  assign card_link = section.settings.link

  if card_link == blank and featured_collection != blank
    assign card_link = featured_collection.url
  endif

  if hero_image == blank and featured_collection != blank
    if featured_collection.image != blank
      assign hero_image = featured_collection.image
    elsif featured_collection.products.size > 0
      assign hero_image = featured_collection.products.first.featured_image
    endif
  endif
-%}

<section class="seasonal full-width" data-section-id="{{ section.id }}">
  <a href="{{ card_link | default: '#' }}" class="seasonal__wrap">
    <div class="seasonal__image-wrap">
      {% if hero_image != blank %}
        {% render 'responsive-img',
          image: hero_image,
          alt: section.settings.title,
          class: 'seasonal__image',
          sizes: '100vw',
          widths: '480,720,960,1280',
          default_width: 720,
          width: 1280,
          height: 720,
          loading: 'lazy'
        %}
      {% else %}
        <div class="seasonal__fallback texture-grain" aria-hidden="true"></div>
      {% endif %}
      <div class="seasonal__overlay"></div>
    </div>

    <div class="seasonal__text">
      <h2 class="seasonal__title">{{ section.settings.title | escape }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="seasonal__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="seasonal__desc">{{ section.settings.description | escape }}</p>
      {% endif %}
      {% if section.settings.cta != blank %}
        <span class="seasonal__cta">{{ section.settings.cta | escape }}</span>
      {% endif %}
    </div>
  </a>
</section>

{% style %}
  .seasonal {
    position: relative;
    overflow: hidden;
  }

  .seasonal__wrap {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
    min-height: 70vh;
  }

  .seasonal__image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .seasonal__image,
  .seasonal__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .seasonal__wrap:hover .seasonal__image {
    transform: scale(1.03);
  }

  .seasonal__fallback {
    background:
      radial-gradient(ellipse at 20% 20%, rgba(196, 184, 168, 0.28) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 80%, rgba(217, 208, 196, 0.32) 0%, transparent 50%),
      linear-gradient(145deg, var(--color-accent-light) 0%, var(--color-background) 100%);
  }

  .seasonal__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.05) 100%);
    pointer-events: none;
  }

  .seasonal__text {
    position: relative;
    z-index: 2;
    max-width: 52ch;
    padding: clamp(4rem, 12vw, 8rem) var(--page-margin);
    color: #FFFFFF;
  }

  .seasonal__title {
    font-family: var(--font-heading--family);
    font-size: clamp(0.875rem, 1.25vw, 1rem);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
    text-wrap: balance;
  }

  .seasonal__subtitle {
    font-family: var(--font-body--family);
    font-size: clamp(0.875rem, 1.15vw, 0.9375rem);
    font-weight: 200;
    letter-spacing: 0.06em;
    margin: 0 0 1.2rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
    opacity: 0.92;
    max-width: 44ch;
    line-height: 1.6;
  }

  .seasonal__desc {
    font-family: var(--font-body--family);
    font-size: clamp(0.875rem, 1.05vw, 0.9375rem);
    font-weight: 200;
    line-height: 1.75;
    margin: 0 0 2rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.25);
    max-width: 38ch;
    opacity: 0.95;
  }

  .seasonal__cta {
    font-family: var(--font-body--family);
    font-size: var(--text-cta);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.5);
    padding: 0.65rem 1.6rem;
    display: inline-block;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .seasonal__wrap:hover .seasonal__cta {
    background-color: #FFFFFF;
    color: var(--color-foreground);
  }
{% endstyle %}

{% schema %}
{
  "name": "Featured Seasonal",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection",
      "info": "Used for the link and hero image when no image is uploaded."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional override)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Monni Botanicals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Spring harvest skincare, seed to bottle with The Herbologist."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Calendula and wildflower day and night creams — slowly infused botanical oils and seasonal distillates, handmade in Aotearoa. A quiet ritual for skin as the season turns."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "CTA",
      "default": "Shop skincare"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional override)"
    }
  ],
  "presets": [
    {
      "name": "Featured Seasonal",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
