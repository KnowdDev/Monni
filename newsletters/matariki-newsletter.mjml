<mjml>
  <mj-head>
    <mj-title>Matariki — Tea &amp; Tonic</mj-title>
    <mj-preview>Ngā mihi o Matariki — warm greetings of the Māori New Year from Monni at Tea &amp; Tonic Matakana.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light only" />
      <meta name="supported-color-schemes" content="light only" />
      <style type="text/css">
        :root { color-scheme: light only; supported-color-schemes: light only; }
      </style>
    </mj-raw>
    <mj-font name="Cormorant Garamond" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&amp;family=Jost:wght@200;300;400;500&amp;display=swap" />
    <mj-font name="Jost" href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="'Jost', 'Helvetica Neue', Arial, sans-serif" font-weight="300" color="#3a3230" />
      <mj-body background-color="#F4F3F0" width="620px" />
      <mj-section background-color="#FAFAFA" padding="0" />
      <mj-text font-size="15px" line-height="1.85" color="#3a3230" padding="0" />
      <mj-button font-family="'Jost', 'Helvetica Neue', Arial, sans-serif" font-size="11px" letter-spacing="0.2em" text-transform="uppercase" border-radius="0" inner-padding="14px 36px" />
      <mj-divider border-color="#E0DCDA" border-width="1px" padding="44px 48px" />
      <mj-class name="label" font-size="10px" letter-spacing="0.22em" text-transform="uppercase" color="#8a8278" font-weight="400" />
      <mj-class name="heading-serif" font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif" font-weight="400" color="#2C2420" line-height="1.3" />
      <mj-class name="heading-serif-light" font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif" font-weight="300" color="#2C2420" />
      <mj-class name="gold-on-dark" color="#D4C4A8" />
      <mj-class name="muted" color="#8a8278" />
      <mj-class name="label-strong" font-size="10px" letter-spacing="0.18em" text-transform="uppercase" color="#5C554D" font-weight="400" />
    </mj-attributes>
    <mj-style inline="inline">
      .wordmark-img img, .matariki-heading-img img, .footer-wordmark-img img {
        display: block !important;
        margin: 0 auto !important;
        border: 0 !important;
        height: auto !important;
        max-height: none !important;
      }
      .wordmark-img table, .matariki-heading-img table, .footer-wordmark-img table,
      .wordmark-img td, .matariki-heading-img td, .footer-wordmark-img td {
        line-height: 100% !important;
        height: auto !important;
        overflow: visible !important;
      }
      .matariki-band-stars { letter-spacing: 0.3em !important; color: #8a8278 !important; }
      .gold-on-dark, .gold-on-dark div { color: #D4C4A8 !important; }
      .footer-links a { color: #5a4a3a !important; text-decoration: none !important; margin: 0 10px !important; }
      .label-strong, .label-strong div { color: #5C554D !important; }
      .inset-box td { padding-left: 28px !important; padding-right: 28px !important; }
      .hero-portrait img { display: block !important; width: 100% !important; height: auto !important; }
      @media only screen and (max-width: 480px) {
        .mobile-pad > table > tbody > tr > td { padding-left: 28px !important; padding-right: 28px !important; }
        .matariki-heading-img img { width: 200px !important; height: auto !important; max-width: 90% !important; }
        .stack-col { display: block !important; width: 100% !important; max-width: 100% !important; }
      }
    </mj-style>
    <mj-style>
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: normal;
        font-weight: 300;
        font-display: swap;
        src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3umX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_qE6GnM.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3umX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_v86GnM.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: italic;
        font-weight: 300;
        font-display: swap;
        src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3smX5slCNuHLi8bLeY9MK7whWMhyjYrGFEsdtdc62E6zd5rDDOjw.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Jost';
        font-style: normal;
        font-weight: 200 400;
        font-display: swap;
        src: url('https://pub-ad1ae2d4dd2545039ecde7acbcdcac8f.r2.dev/assets/5530889b-e2b5-436d-a4bd-c2f9ccdf8ff6/18b8e0e7-c67f-42e5-a08c-f51cb7508e68.woff2') format('woff2');
      }
      body, .dm-lock { background-color: #F4F3F0 !important; }
      .sec-cream, .sec-cream > table, .sec-cream > table > tbody > tr > td,
      .sec-cream > table > tbody > tr > td > div { background-color: #FAFAFA !important; }
      .sec-tea, .sec-tea > table, .sec-tea > table > tbody > tr > td,
      .sec-tea > table > tbody > tr > td > div,
      .sec-ritual, .sec-ritual > table, .sec-ritual > table > tbody > tr > td { background-color: #F4F3F0 !important; }
      .sec-quote, .sec-quote > table, .sec-quote > table > tbody > tr > td,
      .sec-matariki-band, .sec-matariki-band > table, .sec-matariki-band > table > tbody > tr > td,
      .sec-matariki-band > table > tbody > tr > td > div { background-color: #F0E8E5 !important; }
      .sec-dark, .sec-dark > table, .sec-dark > table > tbody > tr > td,
      .sec-dark > table > tbody > tr > td > div { background-color: #2C2420 !important; }
      .sec-footer, .sec-footer > table, .sec-footer > table > tbody > tr > td,
      .sec-footer > table > tbody > tr > td > div { background-color: #3C2A1A !important; }
