<mjml>
  <mj-head>
    <mj-title>MONNI — Spring Events</mj-title>
    <mj-preview>Tarot, tea ceremony and sound meditation — plus Radiance Tea and our Frolic giveaway winner.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light only" />
      <meta name="supported-color-schemes" content="light only" />
      <style type="text/css">
        :root { color-scheme: light only; supported-color-schemes: light only; }
      </style>
    </mj-raw>
    <mj-font name="Cormorant Garamond" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&amp;family=Jost:wght@200;300;400;500&amp;display=swap" />
    <mj-font name="Jost" href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="'Jost', 'Helvetica Neue', Arial, sans-serif" font-weight="300" color="#5B5347" />
      <mj-body background-color="#E9E2D5" width="640px" />
      <mj-section background-color="#F7F2EA" padding="0" />
      <mj-text font-size="16px" line-height="1.75" color="#5B5347" padding="0" />
      <mj-button font-family="'Jost', 'Helvetica Neue', Arial, sans-serif" font-size="12px" letter-spacing="0.18em" text-transform="uppercase" border-radius="0" inner-padding="14px 30px" />
      <mj-class name="eyebrow" font-size="12px" letter-spacing="0.28em" text-transform="uppercase" color="#B4795A" font-weight="400" />
      <mj-class name="heading-serif" font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif" font-weight="400" color="#2E2A24" line-height="1.15" />
      <mj-class name="subheading" font-size="14px" letter-spacing="0.04em" color="#5B5347" font-weight="300" />
    </mj-attributes>
    <mj-style inline="inline">
      .wordmark-img img, .footer-wordmark-img img {
        display: block !important;
        margin: 0 auto !important;
        border: 0 !important;
        height: auto !important;
        max-height: none !important;
      }
      .wordmark-img table, .footer-wordmark-img table,
      .wordmark-img td, .footer-wordmark-img td {
        line-height: 100% !important;
        height: auto !important;
        overflow: visible !important;
      }
      .hero-img img, .section-img img {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        aspect-ratio: 1 / 1 !important;
        object-fit: cover !important;
      }
      .tea-img img, .giveaway-img img {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        aspect-ratio: 4 / 5 !important;
        object-fit: cover !important;
      }
      .event-rule {
        border-bottom: 1px solid #DDD3C3 !important;
      }
      .congrats-table {
        width: 100% !important;
        background-color: #FBF8F3 !important;
        border: 1px solid #DDD3C3 !important;
      }
      @media only screen and (max-width: 480px) {
        .mobile-pad > table > tbody > tr > td {
          padding-left: 28px !important;
          padding-right: 28px !important;
        }
        .heading-serif div { font-size: 28px !important; }
      }
    </mj-style>
    <mj-style>
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: normal;
        font-weight: 300;
        font-display: swap;
        src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3umX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_qE6GnM.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3umX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_v86GnM.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: italic;
        font-weight: 300;
        font-display: swap;
        src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3smX5slCNuHLi8bLeY9MK7whWMhyjYrGFEsdtdc62E6zd5rDDOjw.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3smX5slCNuHLi8bLeY9MK7whWMhyjYrGFEsdtdc62E6zd5rDDOjw.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Jost';
        font-style: normal;
        font-weight: 200 400;
        font-display: swap;
        src: url('https://pub-ad1ae2d4dd2545039ecde7acbcdcac8f.r2.dev/assets/5530889b-e2b5-436d-a4bd-c2f9ccdf8ff6/18b8e0e7-c67f-42e5-a08c-f51cb7508e68.woff2') format('woff2');
      }
      body, .dm-lock { background-color: #E9E2D5 !important; }
      .sec-cream, .sec-cream > table, .sec-cream > table > tbody > tr > td,
      .sec-cream > table > tbody > tr > td > div { background-color: #F7F2EA !important; }
      .sec-panel, .sec-panel > table, .sec-panel > table > tbody > tr > td,
      .sec-panel > table > tbody > tr > td > div { background-color: #FBF8F3 !important; }
      .sec-footer, .sec-footer > table, .sec-footer > table > tbody > tr > td,
      .sec-footer > table > tbody > tr > td > div { background-color: #3C2A1A !important; }
      @media (prefers-color-scheme: dark) {
        body, .dm-lock { background-color: #E9E2D5 !important; color: #5B5347 !important; }
        .sec-cream, .sec-cream > table, .sec-cream > table > tbody > tr > td,
        .sec-cream > table > tbody > tr > td > div { background-color: #F7F2EA !important; }
        .sec-panel, .sec-panel > table, .sec-panel > table > tbody > tr > td,
        .sec-panel > table > tbody > tr > td > div { background-color: #FBF8F3 !important; }
        .sec-footer, .sec-footer > table, .sec-footer > table > tbody > tr > td,
        .sec-footer > table > tbody > tr > td > div { background-color: #3C2A1A !important; }
        .text-body, .text-body div, .text-body span, .text-body p { color: #5B5347 !important; }
        .text-heading, .text-heading div, .heading-serif div { color: #2E2A24 !important; }
        .text-eyebrow, .text-eyebrow div, .eyebrow div { color: #B4795A !important; }
        .text-ink, .text-ink div { color: #2E2A24 !important; }
        .text-clay, .text-clay div { color: #B4795A !important; }
        .text-footer, .text-footer div, .text-footer a { color: #E0DCDA !important; }
        .text-footer-muted, .text-footer-muted div, .text-footer-muted a { color: #8a7060 !important; }
        .dm-img img { opacity: 1 !important; filter: none !important; mix-blend-mode: normal !important; }
        .btn-outline table td { background-color: #F7F2EA !important; border-color: #2E2A24 !important; }
        .btn-outline a { color: #2E2A24 !important; background-color: #F7F2EA !important; }
        .btn-filled table td { background-color: #B4795A !important; border-color: #B4795A !important; }
        .btn-filled a { color: #ffffff !important; background-color: #B4795A !important; }
        .congrats-table { background-color: #FBF8F3 !important; border-color: #DDD3C3 !important; }
      }
      [data-ogsc] .sec-cream, [data-ogsb] .sec-cream { background-color: #F7F2EA !important; }
      [data-ogsc] .sec-panel, [data-ogsb] .sec-panel { background-color: #FBF8F3 !important; }
      [data-ogsc] .sec-footer, [data-ogsb] .sec-footer { background-color: #3C2A1A !important; }
      [data-ogsc] .text-body, [data-ogsb] .text-body { color: #5B5347 !important; }
      [data-ogsc] .text-heading, [data-ogsb] .text-heading { color: #2E2A24 !important; }
      [data-ogsc] .congrats-table, [data-ogsb] .congrats-table { background-color: #FBF8F3 !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#E9E2D5" css-class="dm-lock">

    <!-- Header -->
    <mj-section background-color="#F7F2EA" padding="56px 40px 40px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text align="center" css-class="text-body" font-size="15px" letter-spacing="0.04em" color="#5B5347" padding="0 0 18px">Tea &amp; Tonic Matakana</mj-text>
        <mj-image
          src="https://pub-ad1ae2d4dd2545039ecde7acbcdcac8f.r2.dev/assets/5530889b-e2b5-436d-a4bd-c2f9ccdf8ff6/3a8b249b-16ef-41e4-80c5-4c20d8cc2bf2.png"
          alt="MONNI"
          width="153px"
          height="53px"
          align="center"
          padding="0"
          css-class="dm-img wordmark-img"
        />
      </mj-column>
    </mj-section>

    <!-- Hero — spring blossom, crystal & Frolic ceramic -->
    <mj-section padding="0" background-color="#F7F2EA" css-class="sec-cream">
      <mj-column padding="0">
        <mj-image
          src="https://cdn.shopify.com/s/files/1/2511/3170/t/61/assets/email-spring-hero-crystal-frolic.jpg"
          alt="Spring blossom, crystal and Frolic ceramic still life"
          padding="0"
          fluid-on-mobile="true"
          css-class="dm-img hero-img"
        />
      </mj-column>
    </mj-section>

    <mj-section background-color="#F7F2EA" padding="8px 20px 0" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text align="center" css-class="text-body" font-size="11px" letter-spacing="0.04em" font-weight="300" color="#5B5347" padding="0">Photo for Amber &amp; Gold by Kiri Schumacher</mj-text>
      </mj-column>
    </mj-section>

    <!-- Intro -->
    <mj-section background-color="#F7F2EA" padding="44px 40px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text
          align="center"
          font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif"
          font-style="italic"
          font-weight="300"
          font-size="20px"
          color="#2E2A24"
          line-height="1.65"
          padding="0"
          css-class="text-ink"
        >Dear friends, the awakening of spring is upon us, and it's so beautiful to feel a shift in energy. We're curating a series of events to nourish and inspire you, and we'd love to see you soon.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F7F2EA" padding="0 40px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-divider border-color="#DDD3C3" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Events -->
    <mj-section background-color="#F7F2EA" padding="44px 40px 12px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text mj-class="eyebrow" css-class="text-eyebrow" padding="0 0 14px">Upcoming Events</mj-text>
        <mj-text mj-class="heading-serif" css-class="text-heading" font-size="32px" padding="0 0 24px">Nourish &amp; Inspire</mj-text>
      </mj-column>
    </mj-section>

    <!-- Event 1 -->
    <mj-section background-color="#F7F2EA" padding="0 40px 26px" css-class="sec-cream mobile-pad">
      <mj-column css-class="event-rule" padding="0 0 26px">
        <mj-text
          font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif"
          font-weight="500"
          font-size="24px"
          color="#2E2A24"
          line-height="1.25"
          padding="0 0 8px"
          css-class="text-ink"
        >An Introduction to Tarot Reading</mj-text>
        <mj-text css-class="text-clay" font-size="12px" letter-spacing="0.08em" text-transform="uppercase" font-weight="400" color="#B4795A" padding="0 0 12px">Thursday 10 September &nbsp; 7 – 9pm &nbsp; With Amber &amp; Gold</mj-text>
        <mj-text css-class="text-body" font-size="15px" line-height="1.7" padding="0 0 10px">Learn to work with the cards and receive the gifts they offer.</mj-text>
        <mj-text css-class="text-ink" font-size="14px" font-weight="400" color="#2E2A24" padding="0">$49</mj-text>
      </mj-column>
    </mj-section>

    <!-- Event 2 -->
    <mj-section background-color="#F7F2EA" padding="0 40px 26px" css-class="sec-cream mobile-pad">
      <mj-column css-class="event-rule" padding="0 0 26px">
        <mj-text
          font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif"
          font-weight="500"
          font-size="24px"
          color="#2E2A24"
          line-height="1.25"
          padding="0 0 8px"
          css-class="text-ink"
        >Tea Ceremony with Fleur, from Wild Alchemy</mj-text>
        <mj-text css-class="text-clay" font-size="12px" letter-spacing="0.08em" text-transform="uppercase" font-weight="400" color="#B4795A" padding="0 0 12px">Sunday 13 September &nbsp; 9 – 10am &nbsp; With Fleur from Wild Alchemy</mj-text>
        <mj-text css-class="text-body" font-size="15px" line-height="1.7" padding="0 0 10px">Sit together to enjoy this ancient practice of tea ceremony. Bring a cushion.</mj-text>
        <mj-text css-class="text-ink" font-size="14px" font-weight="400" color="#2E2A24" padding="0">$35 / $30 when you bring a friend</mj-text>
      </mj-column>
    </mj-section>

    <!-- Event 3 -->
    <mj-section background-color="#F7F2EA" padding="0 40px 28px" css-class="sec-cream mobile-pad">
      <mj-column padding="0">
        <mj-text
          font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif"
          font-weight="500"
          font-size="24px"
          color="#2E2A24"
          line-height="1.25"
          padding="0 0 8px"
          css-class="text-ink"
        >The Resonant Body — A Somatic Sound Meditation</mj-text>
        <mj-text css-class="text-clay" font-size="12px" letter-spacing="0.08em" text-transform="uppercase" font-weight="400" color="#B4795A" padding="0 0 12px">Thursday 24 September &nbsp; 7 – 8pm &nbsp; With Amber &amp; Gold</mj-text>
        <mj-text css-class="text-body" font-size="15px" line-height="1.7" padding="0 0 10px">Join us for a bespoke evening attuned to awakening your receptivity and invoking a deep sense of calm. Be guided through a meditation that connects you with presence, and relax into a sound healing. No experience is necessary, and you'll receive a goodie bag to take home.</mj-text>
        <mj-text css-class="text-ink" font-size="14px" font-weight="400" color="#2E2A24" padding="0">$50 / $40 with a friend</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F7F2EA" padding="0 40px 44px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text
          align="center"
          font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif"
          font-style="italic"
          font-weight="300"
          font-size="17px"
          color="#2E2A24"
          padding="6px 0 20px"
          css-class="text-ink"
        >Bookings are essential for these events.</mj-text>
        <mj-button
          href="mailto:Amber@teaandtonic.co.nz"
          background-color="#B4795A"
          color="#ffffff"
          border="1px solid #B4795A"
          align="center"
          font-size="11px"
          letter-spacing="0.12em"
          css-class="btn-filled"
        >To Book Email Amber@teaandtonic.co.nz</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F7F2EA" padding="0 40px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-divider border-color="#DDD3C3" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Tea of the Week -->
    <mj-section background-color="#F7F2EA" padding="44px 40px 20px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text mj-class="eyebrow" css-class="text-eyebrow" padding="0 0 14px">Tea of the Week</mj-text>
        <mj-text mj-class="heading-serif" css-class="text-heading" font-size="32px" padding="0 0 4px">Radiance Tea</mj-text>
        <mj-text mj-class="subheading" css-class="text-body" padding="0 0 20px">By Amber &amp; Gold</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 40px 24px" background-color="#F7F2EA" css-class="sec-cream mobile-pad">
      <mj-column padding="0">
        <mj-image
          src="https://cdn.shopify.com/s/files/1/2511/3170/t/61/assets/email-spring-radiance-tea.jpg"
          alt="Amber &amp; Gold Radiance Tea — chamomile, calendula and hibiscus"
          href="https://teaandtonic.co.nz/products/radiance-tea-by-amber-gold"
          padding="0"
          fluid-on-mobile="true"
          css-class="dm-img tea-img"
        />
      </mj-column>
    </mj-section>

    <mj-section background-color="#F7F2EA" padding="0 40px 44px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text css-class="text-body" padding="0 0 20px">
          A gentle floral blend of chamomile and calendula with hibiscus, rose and goji — soft, nourishing and crafted to hydrate the skin and support an inner glow. A sweet infusion of vitamin C makes it a beautiful ritual to soothe, repair and restore natural radiance.
        </mj-text>
        <mj-text css-class="text-body" padding="0 0 8px">
          <em style="font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-style:italic;color:#2E2A24;">Key ingredients:</em>
          Calendula, hibiscus, goji — all certified organic.
        </mj-text>
        <mj-text css-class="text-body" padding="0 0 24px">
          Available in 25g, 50g and 100g. Made in Aotearoa, New Zealand.
        </mj-text>
        <mj-button
          href="https://teaandtonic.co.nz/products/radiance-tea-by-amber-gold"
          background-color="#F7F2EA"
          color="#2E2A24"
          border="1px solid #2E2A24"
          align="left"
          css-class="btn-outline"
        >Shop Radiance Tea</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F7F2EA" padding="0 40px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-divider border-color="#DDD3C3" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Frolic giveaway winner -->
    <mj-section background-color="#F7F2EA" padding="44px 40px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text align="center" css-class="text-ink" padding="0">
          <table class="congrats-table" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;background-color:#FBF8F3;border:1px solid #DDD3C3;">
            <tr>
              <td style="padding:32px 30px;background-color:#FBF8F3;text-align:center;">
                <p style="margin:0 0 14px;font-family:'Jost','Helvetica Neue',Arial,sans-serif;font-weight:400;font-size:12px;letter-spacing:0.28em;text-transform:uppercase;color:#B4795A;">Congratulations</p>
                <p style="margin:0 0 20px;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:24px;line-height:1.3;color:#2E2A24;">@sam__anne, our Frolic Ceramics giveaway winner!</p>
                <img src="https://cdn.shopify.com/s/files/1/2511/3170/files/C6FD5D6E-1FEC-4217-84E8-9E3B324311F5.jpg?v=1783136939" alt="Large Frolic Jug" width="280" style="display:block;margin:0 auto 16px;max-width:280px;width:100%;height:auto;border:0;" />
                <p style="margin:0;font-family:'Jost','Helvetica Neue',Arial,sans-serif;font-weight:300;font-size:16px;line-height:1.75;color:#5B5347;">
                  Thank you to everyone who entered and shared the love for Frolic Ceramics with us. We loved seeing so much support for Vicki's work, and we can't wait to run our next giveaway soon.
                </p>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Signature -->
    <mj-section background-color="#F7F2EA" padding="24px 40px 40px" css-class="sec-cream mobile-pad">
      <mj-column>
        <mj-text
          align="center"
          font-family="'Cormorant Garamond', Georgia, 'Times New Roman', serif"
          font-style="italic"
          font-weight="300"
          font-size="20px"
          color="#2E2A24"
          padding="0 0 8px"
          css-class="text-ink"
        >With warmth,<br />Monni</mj-text>
        <mj-text align="center" css-class="text-body" font-size="12px" letter-spacing="0.03em" padding="0 0 4px">Tea &amp; Tonic Matakana</mj-text>
        <mj-text align="center" css-class="text-body" font-size="12px" letter-spacing="0.03em" padding="0">Matakana Village, Aotearoa</mj-text>
      </mj-column>
    </mj-section>

    <!-- Brand footer (compliance footer added automatically by Hatched Send) -->
    <mj-section background-color="#3C2A1A" padding="36px 36px" css-class="sec-footer mobile-pad">
      <mj-column>
        <mj-image
          src="https://pub-ad1ae2d4dd2545039ecde7acbcdcac8f.r2.dev/assets/5530889b-e2b5-436d-a4bd-c2f9ccdf8ff6/6224078f-358d-4dde-9744-0a7f34b24931.png"
          alt="Tea &amp; Tonic"
          width="189px"
          height="43px"
          align="center"
          padding="0 0 14px"
          css-class="dm-img footer-wordmark-img"
        />
        <mj-text align="center" css-class="text-footer-muted" font-size="11px" color="#8a7060" line-height="1.8" letter-spacing="0.04em" padding="0">
          <a href="mailto:hello@teaandtonic.co.nz" style="color:#8a7060;text-decoration:none;">hello@teaandtonic.co.nz</a> &nbsp;·&nbsp;
          <a href="https://www.instagram.com/teaandtonicmatakana/" style="color:#8a7060;text-decoration:none;">Instagram</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
