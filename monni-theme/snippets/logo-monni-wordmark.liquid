{% comment %}
  MONNI wordmark — reserved for the official brand migration.
  Not used in header/footer while Tea & Tonic logo remains active.
  Usage after migration: {% render 'logo-monni-wordmark', class: 'header__logo-svg' %}
{% endcomment %}
<svg
  class="{{ class | default: 'logo-monni-wordmark' }}"
  viewBox="0 0 200 32"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <text
    x="50%"
    y="50%"
    dominant-baseline="central"
    text-anchor="middle"
    font-family="'Cormorant Garamond', serif"
    font-size="24"
    font-weight="300"
    letter-spacing="0.35em"
    fill="currentColor"
  >MONNI</text>
</svg>
