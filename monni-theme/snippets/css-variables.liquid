{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color | default: '#F8F6F4' }};
    --color-background-alt: {{ settings.background_alt_color | default: '#FFFFFF' }};
    --color-foreground: {{ settings.foreground_color | default: '#3D3D3D' }};
    --color-foreground-light: {{ settings.foreground_light_color | default: '#6B6B6B' }};
    --color-foreground-muted: {{ settings.foreground_muted_color | default: '#6F6B6B' }};
    --color-accent: {{ settings.accent_color | default: '#C4B8A8' }};
    --color-accent-light: {{ settings.accent_light_color | default: '#D9D0C4' }};
    --color-accent-dark: {{ settings.accent_dark_color | default: '#A89A8A' }};
    --color-border: {{ settings.border_color | default: '#E5E0DC' }};
    --color-border-light: {{ settings.border_light_color | default: '#F0EBE7' }};
    --color-error: {{ settings.error_color | default: '#C44B4B' }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 1.5rem;
    --spacing-lg: 2rem;
    --spacing-xl: 3rem;
    --spacing-xxl: 5rem;
    --transition-fast: 150ms ease;
    --transition-normal: 300ms ease;
    --transition-slow: 500ms ease;
  }
{% endstyle %}
