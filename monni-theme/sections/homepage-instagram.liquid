<section class="instagram" data-section-id="{{ section.id }}" data-animate>
  {% if section.settings.title != blank %}
    <div class="instagram__header">
      <h2 class="instagram__title">{{ section.settings.title | escape }}</h2>
      {% if section.settings.handle != blank %}
        <a
          href="https://instagram.com/{{ section.settings.handle | escape }}"
          class="instagram__handle"
          target="_blank"
          rel="noopener noreferrer"
        >
          @{{ section.settings.handle | escape }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="instagram__grid">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="instagram__item"
            {% if block.settings.link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
            {{ block.shopify_attributes }}
          >
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              srcset="
                {{ block.settings.image | image_url: width: 600 }} 600w,
                {{ block.settings.image | image_url: width: 400 }} 400w
              "
              sizes="(min-width: 768px) 25vw, 50vw"
              alt="{{ block.settings.image.alt | default: section.settings.title | escape }}"
              loading="lazy"
              decoding="async"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .instagram {
    padding: var(--spacing-xxl) 0;
  }

  .instagram__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .instagram__title {
    margin-bottom: var(--spacing-xs);
    font-weight: 300;
  }

  .instagram__handle {
    font-size: 0.9375rem;
    color: var(--color-foreground-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .instagram__handle:hover {
    color: var(--color-foreground);
  }

  .instagram__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-sm);
  }

  @media (min-width: 768px) {
    .instagram__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-md);
    }
  }

  .instagram__item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.2rem;
    background-color: var(--color-border-light);
  }

  .instagram__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .instagram__item:hover img {
    transform: scale(1.04);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram Gallery",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Follow along"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle",
      "default": "teaandtonicmatakana",
      "info": "Without the @ symbol"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Link to the Instagram post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Gallery",
      "category": "Homepage",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
