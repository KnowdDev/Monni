{% comment %}
  Monni Wishlist Page — Client-side rendered from localStorage
{% endcomment %}

<div class="wishlist section--padding" data-section-id="{{ section.id }}">
  <div class="wishlist__inner container">
    <header class="wishlist__header">
      <h1 class="wishlist__title">{{ page.title }}</h1>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="{{ routes.root_url }}" class="breadcrumb__link">{{ 'general.breadcrumbs.home' | t }}</a>
          </li>
          <li class="breadcrumb__item" aria-current="page">
            <span class="breadcrumb__link breadcrumb__link--current">{{ page.title }}</span>
          </li>
        </ol>
      </nav>
    </header>

    <div class="wishlist__content">
      <!-- Empty state -->
      <div class="wishlist__empty" data-wishlist-empty>
        <p class="wishlist__empty-text">Your wishlist is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue shopping</a>
      </div>

      <!-- Grid populated by JS -->
      <div class="wishlist__grid" data-wishlist-grid hidden></div>
    </div>
  </div>
</div>

<script>
(function() {
  const WISHLIST_KEY = 'monni:wishlist';
  const emptyEl = document.querySelector('[data-wishlist-empty]');
  const gridEl = document.querySelector('[data-wishlist-grid]');

  function getWishlist() {
    try {
      const raw = JSON.parse(localStorage.getItem(WISHLIST_KEY) || '[]');
      return raw.map(item => (typeof item === 'string' ? { id: item } : item));
    } catch {
      return [];
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderWishlist() {
    const list = getWishlist().filter(item => item.handle);

    if (list.length === 0) {
      emptyEl.hidden = false;
      gridEl.hidden = true;
      gridEl.innerHTML = '';
      return;
    }

    emptyEl.hidden = true;
    gridEl.hidden = false;

    gridEl.innerHTML = list.map(item => {
      const priceHtml = item.comparePrice
        ? `<span class="card-product__price--sale">${escapeHtml(item.price)}</span><span class="card-product__price--compare">${escapeHtml(item.comparePrice)}</span>`
        : `<span class="card-product__price--regular">${escapeHtml(item.price)}</span>`;

      const imgHtml = item.image
        ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" width="600" height="800" class="card-product__image card-product__image--primary">`
        : `<div class="card-product__placeholder texture-grain"><span>${escapeHtml(item.title)}</span></div>`;

      return `
        <article class="card-product" data-product-id="${escapeHtml(item.id)}">
          <div class="card-product__media" style="--card-aspect-ratio: 3/4;">
            <a href="${escapeHtml(item.url)}" class="card-product__image-link" aria-label="${escapeHtml(item.title)}">
              ${imgHtml}
            </a>
            <button
              type="button"
              class="card-product__wishlist is-active"
              data-wishlist-toggle="${escapeHtml(item.id)}"
              data-wishlist-handle="${escapeHtml(item.handle)}"
              data-wishlist-title="${escapeHtml(item.title)}"
              data-wishlist-image="${escapeHtml(item.image)}"
              data-wishlist-price="${escapeHtml(item.price)}"
              data-wishlist-compare-price="${escapeHtml(item.comparePrice || '')}"
              data-wishlist-url="${escapeHtml(item.url)}"
              aria-label="Remove from wishlist"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>
          </div>
          <a href="${escapeHtml(item.url)}" class="card-product__info-link">
            <div class="card-product__info">
              <h3 class="card-product__title">${escapeHtml(item.title)}</h3>
              <div class="card-product__price">${priceHtml}</div>
            </div>
          </a>
        </article>
      `;
    }).join('');
  }

  // Remove card from wishlist page when toggled off
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-wishlist-toggle]');
    if (!btn) return;
    const card = btn.closest('.card-product');
    if (!card || !gridEl.contains(card)) return;

    // Wait for the toggle handler in cart-drawer.js to run first
    requestAnimationFrame(function() {
      if (!btn.classList.contains('is-active')) {
        card.remove();
        if (gridEl.children.length === 0) {
          emptyEl.hidden = false;
          gridEl.hidden = true;
        }
      }
    });
  });

  renderWishlist();
})();
</script>

{% stylesheet %}
  .wishlist {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .wishlist__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .wishlist__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .wishlist__title {
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    margin: 0 0 var(--spacing-lg);
  }

  @media (min-width: 768px) {
    .wishlist__title {
      font-size: 3rem;
    }
  }

  .wishlist__empty {
    text-align: center;
    padding: var(--spacing-xl) 0;
  }

  .wishlist__empty-text {
    font-size: 1rem;
    color: var(--color-foreground-muted);
    margin-bottom: var(--spacing-lg);
  }

  .wishlist__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }

  @media (min-width: 768px) {
    .wishlist__grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--spacing-xl);
    }
  }

  @media (min-width: 1024px) {
    .wishlist__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .breadcrumb {
    margin-top: var(--spacing-md);
  }

  .breadcrumb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.8125rem;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    color: var(--color-foreground-muted);
  }

  .breadcrumb__link {
    color: var(--color-foreground-light);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb__link:hover,
  .breadcrumb__link:focus {
    color: var(--color-foreground);
    outline: none;
  }

  .breadcrumb__link--current {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section-wishlist",
  "settings": [],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
