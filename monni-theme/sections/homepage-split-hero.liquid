<section
  class="split-hero full-width"
  data-section-id="{{ section.id }}"
>
  <a
    href="{{ section.settings.link_left | default: '/collections/gifting' }}"
    class="split-hero__panel split-hero__panel--left"
  >
    <div class="split-hero__fallback split-hero__fallback--left texture-grain"></div>
    {% if section.settings.image_left %}
      <img
        src="{{ section.settings.image_left | image_url: width: 1200, format: 'webp' }}"
        srcset="
          {{ section.settings.image_left | image_url: width: 1800, format: 'webp' }} 1800w,
          {{ section.settings.image_left | image_url: width: 1200, format: 'webp' }} 1200w,
          {{ section.settings.image_left | image_url: width: 800, format: 'webp' }} 800w,
          {{ section.settings.image_left | image_url: width: 600, format: 'webp' }} 600w
        "
        sizes="(min-width: 768px) 50vw, 100vw"
        alt="{{ section.settings.image_left.alt | default: section.settings.label_left | escape }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="{{ section.settings.image_left.width }}"
        height="{{ section.settings.image_left.height }}"
        class="split-hero__image"
      >
    {% else %}
      <img
        src="{{ 'hero-gifting.jpg' | asset_url }}"
        alt="{{ section.settings.label_left | escape }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="800"
        height="1000"
        class="split-hero__image"
      >
    {% endif %}
    <div class="split-hero__overlay"></div>
    <span class="split-hero__label">{{ section.settings.label_left | escape }}</span>
    <div class="split-hero__info">
      {% if section.settings.blurb_left != blank %}
        <p class="split-hero__blurb">{{ section.settings.blurb_left | escape }}</p>
      {% endif %}
      {% if section.settings.cta_left != blank %}
        <span class="split-hero__cta">{{ section.settings.cta_left | escape }}</span>
      {% endif %}
    </div>
  </a>

  <a
    href="{{ section.settings.link_right | default: '/collections/clothing' }}"
    class="split-hero__panel split-hero__panel--right"
  >
    <div class="split-hero__fallback split-hero__fallback--right texture-grain"></div>
    {% if section.settings.image_right %}
      <img
        src="{{ section.settings.image_right | image_url: width: 1200, format: 'webp' }}"
        srcset="
          {{ section.settings.image_right | image_url: width: 1800, format: 'webp' }} 1800w,
          {{ section.settings.image_right | image_url: width: 1200, format: 'webp' }} 1200w,
          {{ section.settings.image_right | image_url: width: 800, format: 'webp' }} 800w,
          {{ section.settings.image_right | image_url: width: 600, format: 'webp' }} 600w
        "
        sizes="(min-width: 768px) 50vw, 100vw"
        alt="{{ section.settings.image_right.alt | default: section.settings.label_right | escape }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="{{ section.settings.image_right.width }}"
        height="{{ section.settings.image_right.height }}"
        class="split-hero__image"
      >
    {% else %}
      <img
        src="{{ 'hero-homewares.jpg' | asset_url }}"
        alt="{{ section.settings.label_right | escape }}"
        loading="eager"
        decoding="async"
        width="800"
        height="1000"
        class="split-hero__image"
      >
    {% endif %}
    <div class="split-hero__overlay"></div>
    <span class="split-hero__label">{{ section.settings.label_right | escape }}</span>
    <div class="split-hero__info">
      {% if section.settings.blurb_right != blank %}
        <p class="split-hero__blurb">{{ section.settings.blurb_right | escape }}</p>
      {% endif %}
      {% if section.settings.cta_right != blank %}
        <span class="split-hero__cta">{{ section.settings.cta_right | escape }}</span>
      {% endif %}
    </div>
  </a>
</section>

{% stylesheet %}
  .split-hero {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 70vh;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .split-hero {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
  }

  .split-hero__panel {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 60vh;
  }

  @media (min-width: 768px) {
    .split-hero__panel {
      min-height: auto;
    }
  }

  .split-hero__image,
  .split-hero__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), filter 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .split-hero__panel:hover .split-hero__image,
  .split-hero__panel:hover .split-hero__fallback {
    transform: scale(1.03);
  }

  .split-hero__fallback {
    background:
      radial-gradient(ellipse at 30% 20%, rgba(196, 184, 168, 0.35) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 80%, rgba(217, 208, 196, 0.3) 0%, transparent 55%),
      linear-gradient(160deg, var(--color-background) 0%, var(--color-accent-light) 40%, var(--color-border-light) 100%);
  }

  .split-hero__fallback--right {
    background:
      radial-gradient(ellipse at 70% 20%, rgba(196, 184, 168, 0.3) 0%, transparent 60%),
      radial-gradient(ellipse at 30% 80%, rgba(217, 208, 196, 0.25) 0%, transparent 55%),
      linear-gradient(200deg, var(--color-border-light) 0%, var(--color-accent-light) 40%, var(--color-background) 100%);
  }

  .split-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.02) 40%, transparent 70%);
    transition: background 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .split-hero__panel:hover .split-hero__overlay {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.05) 45%, rgba(0, 0, 0, 0.35) 100%);
  }

  .split-hero__info {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    padding: 2rem;
    max-width: 34ch;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }

  .split-hero__label {
    position: relative;
    z-index: 2;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
    padding: 2rem;
    display: block;
    transition: opacity var(--transition-fast);
  }

  .split-hero__panel:hover .split-hero__label {
    opacity: 0.75;
  }

  .split-hero__blurb {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 var(--spacing-sm) 0;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .split-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.08s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
  }

  .split-hero__cta::after {
    content: '\2192';
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .split-hero__panel:hover .split-hero__blurb,
  .split-hero__panel:hover .split-hero__cta {
    opacity: 1;
    transform: translateY(0);
  }

  .split-hero__panel:hover .split-hero__cta::after {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .split-hero__image,
    .split-hero__fallback,
    .split-hero__overlay,
    .split-hero__blurb,
    .split-hero__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split Hero (Diptych)",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "label_left",
      "label": "Left label",
      "default": "Gifting"
    },
    {
      "type": "url",
      "id": "link_left",
      "label": "Left link"
    },
    {
      "type": "textarea",
      "id": "blurb_left",
      "label": "Left blurb",
      "default": "Thoughtfully chosen pieces to make every moment feel special."
    },
    {
      "type": "text",
      "id": "cta_left",
      "label": "Left CTA",
      "default": "Explore"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right image"
    },
    {
      "type": "text",
      "id": "label_right",
      "label": "Right label",
      "default": "Homewares"
    },
    {
      "type": "url",
      "id": "link_right",
      "label": "Right link"
    },
    {
      "type": "textarea",
      "id": "blurb_right",
      "label": "Right blurb",
      "default": "Objects that bring warmth, texture, and quiet beauty into your space."
    },
    {
      "type": "text",
      "id": "cta_right",
      "label": "Right CTA",
      "default": "Explore"
    }
  ],
  "presets": [
    {
      "name": "Split Hero (Diptych)",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
