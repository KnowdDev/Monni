{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password-page">
  <div class="password-page__inner">
    <div class="password-page__content">
      {% if section.settings.logo %}
        <div class="password-page__logo">
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" loading="lazy">
        </div>
      {% else %}
        <h1 class="password-page__logo-text">{{ shop.name }}</h1>
      {% endif %}

      <h2 class="password-page__heading">{{ section.settings.heading | default: 'password.title' | t }}</h2>

      {% if shop.password_message %}
        <p class="password-page__message">{{ shop.password_message }}</p>
      {% endif %}

      {% form 'storefront_password', class: 'password-page__form' %}
        {% if form.errors %}
          <div class="password-page__errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="password-page__form-inner">
          <label for="password-input" class="visually-hidden">
            {{ 'password.password' | t }}
          </label>

          <input
            type="password"
            name="password"
            id="password-input"
            class="password-page__input"
            placeholder="{{ 'password.password' | t }}"
            required
          >

          <button type="submit" class="password-page__button button button--primary">
            {{ 'password.enter' | t }}
          </button>
        </div>
      {% endform %}

      {% if section.settings.show_newsletter %}
        <div class="password-page__newsletter">
          <p class="password-page__newsletter-text">{{ section.settings.newsletter_heading }}</p>
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="prospect,password-page">
            <div class="password-page__newsletter-form">
              <input
                type="email"
                name="contact[email]"
                class="password-page__newsletter-input"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                required
              >
              <button type="submit" class="password-page__newsletter-button button button--secondary">
                {{ section.settings.newsletter_button }}
              </button>
            </div>
          {% endform %}
        </div>
      {% endif %}
    </div>

    <footer class="password-page__footer">
      {% if section.settings.show_social %}
        <div class="password-page__social">
          {% if section.settings.instagram_url %}
            <a href="{{ section.settings.instagram_url }}" class="password-page__social-link" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'icon-instagram' %}
            </a>
          {% endif %}
          {% if section.settings.facebook_url %}
            <a href="{{ section.settings.facebook_url }}" class="password-page__social-link" target="_blank" rel="noopener" aria-label="Facebook">
              {% render 'icon-facebook' %}
            </a>
          {% endif %}
        </div>
      {% endif %}
      <p class="password-page__powered-by">{{ 'general.shopify.title' | t }}</p>
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "t:general.password",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coming Soon"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Be the first to know when we launch"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button text",
      "default": "Notify me"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    }
  ]
}
{% endschema %}
