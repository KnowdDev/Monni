{% if section.blocks.size > 0 %}
  <section class="collections" data-section-id="{{ section.id }}" data-animate>
    <div class="collections__intro">
      {% if section.settings.title != blank %}
        <h2 class="collections__title">{{ section.settings.title | escape }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="collections__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </div>

    <div class="collections__grid">
      {% for block in section.blocks %}
      {% liquid
        assign col_handle = block.settings.collection_handle
        assign collection_obj = collections[col_handle]
        assign card_title = block.settings.title
        assign card_link = block.settings.link

        # Use collection data if available, otherwise fall back to manual overrides
        if collection_obj != blank
          assign card_image = collection_obj.image | default: collection_obj.featured_image
          assign card_title = collection_obj.title
          assign card_link = collection_obj.url
        endif

        # Allow manual overrides
        if block.settings.image != blank
          assign card_image = block.settings.image
        endif
        if block.settings.title != blank
          assign card_title = block.settings.title
        endif
        if block.settings.link != blank
          assign card_link = block.settings.link
        endif

        if card_title == blank and col_handle != blank
          assign card_title = col_handle | replace: '-', ' ' | capitalize
        endif
        if card_title == blank
          assign card_title = 'Collection'
        endif
      %}

        <a
          href="{{ card_link | default: routes.collections_url }}"
          class="collection-card"
          {{ block.shopify_attributes }}
        >
        {% if card_image %}
          <div class="collection-card__media">
            <img
              src="{{ card_image | image_url: width: 280, format: 'webp' }}"
              srcset="
                {{ card_image | image_url: width: 480, format: 'webp' }} 480w,
                {{ card_image | image_url: width: 360, format: 'webp' }} 360w,
                {{ card_image | image_url: width: 280, format: 'webp' }} 280w,
                {{ card_image | image_url: width: 220, format: 'webp' }} 220w
              "
              sizes="(max-width: 767px) 45vw, (max-width: 1199px) 33vw, 280px"
              alt="{{ card_image.alt | default: card_title | escape }}"
              loading="lazy"
              decoding="async"
              width="{{ card_image.width }}"
              height="{{ card_image.height }}"
            >
            <div class="collection-card__overlay"></div>
          </div>
        {% else %}
          <div class="collection-card__media collection-card__media--placeholder">
            <div class="collection-card__placeholder-text">{{ card_title | escape }}</div>
            <div class="collection-card__overlay"></div>
          </div>
        {% endif %}

        <div class="collection-card__content">
          <span class="collection-card__label">{{ card_title | escape }}</span>
        </div>
        </a>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .collections {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }

  .collections__intro {
    max-width: 42rem;
    margin: 0 auto var(--spacing-xl);
    text-align: center;
  }

  .collections__title {
    margin-bottom: var(--spacing-xs);
    font-weight: 300;
    letter-spacing: -0.03em;
  }

  .collections__subtitle {
    font-size: 1rem;
    color: var(--color-foreground-muted);
    line-height: 1.65;
  }

  .collections__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-sm);
  }

  @media (min-width: 768px) {
    .collections__grid {
      gap: var(--spacing-md);
    }
  }

  .collection-card {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    text-decoration: none;
    border-radius: 0.2rem;
    background-color: var(--color-border-light);
  }

  .collection-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--color-border-light);
  }

  .collection-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow), filter var(--transition-slow);
  }

  .collection-card__media--placeholder {
    background: linear-gradient(135deg, var(--color-border-light) 0%, var(--color-accent-light) 50%, var(--color-border) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-card__placeholder-text {
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-foreground-muted);
    letter-spacing: -0.01em;
    text-align: center;
    padding: var(--spacing-md);
  }

  .collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(61,61,61,0.35) 0%, rgba(61,61,61,0) 50%);
    z-index: 1;
    transition: background var(--transition-normal);
  }

  .collection-card__content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding: var(--spacing-md);
    display: grid;
    gap: 0.35rem;
  }

  .collection-card__label {
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #FFFFFF;
  }

  .collection-card:hover .collection-card__media img {
    transform: scale(1.04);
  }

  .collection-card:hover .collection-card__overlay {
    background: linear-gradient(to top, rgba(61,61,61,0.45) 0%, rgba(61,61,61,0.05) 60%);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated selections for every moment"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection_handle",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override title (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Override link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "category": "Homepage",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
